{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "conductor hook checkpoint --harness codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "conductor hook pre-tool --auto-reserve --harness codex",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Edit|Write)$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "conductor hook session-end --harness codex",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "conductor hook session-start",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "conductor hook checkpoint --harness codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
