    "sage factor_base_dor.sage --field 9 --dim 4 --targets 200 --seed S --structures nb_window,nb_break   # S=1..5",
    "sage factor_base_dor.sage --summands 3 --field 9 --dim 2 --selftest 3",
    "sage factor_base_dor.sage --summands 3 --field 11 --dim 3 --targets 400 --dstar-sample 0 --structures nb_window,nb_break --seed S",
