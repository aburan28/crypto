#!/usr/bin/env bash
#
# A stand-in for the `aws` CLI covering exactly the calls `ephemeral` and
# runner.sh make, backed by the directory $FAKE_AWS:
#
#   $FAKE_AWS/ssm/<name>           parameter values
#   $FAKE_AWS/s3/<bucket>/<key>    objects
#   $FAKE_AWS/ec2/<instance-id>    "<job> <state>"
#   $FAKE_AWS/calls.log            every invocation, one per line
#
# `ec2 run-instances` starts an amazonlinux:2023 container that executes the
# user data with this same script as its `aws`, so the real runner.sh runs
# end to end. `shutdown` inside the container marks the instance terminated.

set -euo pipefail
: "${FAKE_AWS:?}"
echo "$*" >>"$FAKE_AWS/calls.log"

svc=$1 op=$2
shift 2
args=("$@")

opt() { # value of --name in args
    local i
    for ((i = 0; i < ${#args[@]}; i++)); do
        [ "${args[i]}" = "$1" ] && { echo "${args[i + 1]}"; return 0; }
    done
    return 1
}
positional() { # non-option arguments, skipping flags that take no value
    local i a
    for ((i = 0; i < ${#args[@]}; i++)); do
        a=${args[i]}
        case $a in
        --only-show-errors) ;;
        --*) i=$((i + 1)) ;;
        *) echo "$a" ;;
        esac
    done
}
path_of() { # s3://bucket/key -> local path
    echo "$FAKE_AWS/s3/${1#s3://}"
}

case "$svc $op" in
"ssm get-parameter")
    f="$FAKE_AWS/ssm$(opt --name)"
    [ -f "$f" ] || { echo "ParameterNotFound" >&2; exit 254; }
    cat "$f"
    ;;
"s3 cp")
    mapfile -t pos < <(positional)
    src=${pos[0]} dst=${pos[1]}
    if [[ $src == s3://* ]]; then
        p=$(path_of "$src")
        [ -f "$p" ] || { echo "fatal error: (404) Not Found" >&2; exit 1; }
        if [ "$dst" = - ]; then cat "$p"; else mkdir -p "$(dirname "$dst")"; cp "$p" "$dst"; fi
    else
        p=$(path_of "$dst")
        mkdir -p "$(dirname "$p")"
        if [ "$src" = - ]; then cat >"$p.tmp"; else cp "$src" "$p.tmp"; fi
        mv "$p.tmp" "$p"
    fi
    ;;
"s3 sync")
    mapfile -t pos < <(positional)
    src=${pos[0]} dst=${pos[1]}
    [[ $src == s3://* ]] && src=$(path_of "$src")
    [[ $dst == s3://* ]] && dst=$(path_of "$dst")
    mkdir -p "$dst"
    [ -d "$src" ] && cp -a "$src/." "$dst/"
    ;;
"s3 ls")
    mapfile -t pos < <(positional)
    d=$(path_of "${pos[0]}")
    [ -d "$d" ] || exit 1
    for e in "$d"/*/; do [ -d "$e" ] && echo "                           PRE $(basename "$e")/"; done
    ;;
"s3api get-object")
    p="$FAKE_AWS/s3/$(opt --bucket)/$(opt --key)"
    mapfile -t pos < <(positional)
    out=${pos[0]}
    [ -f "$p" ] || { echo "NoSuchKey" >&2; exit 254; }
    from=$(opt --range | sed -E 's/bytes=([0-9]+)-/\1/')
    size=$(wc -c <"$p")
    [ "$from" -lt "$size" ] || { echo "InvalidRange" >&2; exit 254; }
    tail -c +"$((from + 1))" "$p" >"$out"
    echo '{}'
    ;;
"ec2 describe-instance-types")
    case $(opt --instance-types) in
    g* | p*) echo "x86_64	NVIDIA" ;;
    *g.* | *gd.*) echo "arm64	None" ;;
    *) echo "x86_64	None" ;;
    esac
    ;;
"ec2 run-instances")
    [ -z "${FAKE_CAPACITY_FAIL:-}" ] || {
        n=$(cat "$FAKE_AWS/capacity-fails" 2>/dev/null || echo 0)
        if [ "$n" -lt "$FAKE_CAPACITY_FAIL" ]; then
            echo $((n + 1)) >"$FAKE_AWS/capacity-fails"
            echo "An error occurred (InsufficientInstanceCapacity) when calling the RunInstances operation" >&2
            exit 254
        fi
    }
    ud=$(opt --user-data)
    ud=${ud#file://}
    job=$(grep -o 'ephemeral:job,Value=[^}]*' <<<"${args[*]}" | head -1 | cut -d= -f2)
    iid="i-fake$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    mkdir -p "$FAKE_AWS/ec2"
    cp "$ud" "$FAKE_AWS/ec2/$iid.user-data"
    echo "$job running" >"$FAKE_AWS/ec2/$iid"
    docker run -d --name "ephemeral-test-$iid" \
        -v "$FAKE_AWS:$FAKE_AWS" -v "$(dirname "$(readlink -f "$0")"):/fakebin:ro" \
        -e FAKE_AWS="$FAKE_AWS" -e FAKE_IID="$iid" -e EPHEMERAL_IMDS=http://127.0.0.1:9 \
        -e PATH=/fakebin/container-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        amazonlinux:2023 bash "$FAKE_AWS/ec2/$iid.user-data" >/dev/null
    echo "$iid"
    ;;
"ec2 describe-instances")
    job=$(grep -o 'tag:ephemeral:job,Values=[^ ]*' <<<"${args[*]}" | cut -d= -f2 || true)
    shopt -s nullglob
    for f in "$FAKE_AWS"/ec2/i-*; do
        case ${f##*/} in *.*) continue ;; esac
        read -r j state <"$f"
        if [ -z "$job" ] || [ "$j" = "$job" ]; then printf '%s\t%s\n' "$(basename "$f")" "$state"; fi
    done
    ;;
"ec2 terminate-instances")
    iid=$(opt --instance-ids)
    read -r j _ <"$FAKE_AWS/ec2/$iid"
    echo "$j terminated" >"$FAKE_AWS/ec2/$iid"
    # Like an OS shutdown: TERM to every process, a grace period, then gone.
    (
        docker exec "ephemeral-test-$iid" bash -c 'kill -TERM -1' >/dev/null 2>&1
        sleep 20
        docker kill "ephemeral-test-$iid" >/dev/null 2>&1
    ) </dev/null >/dev/null 2>&1 &
    echo shutting-down
    ;;
*)
    echo "fake-aws: unsupported call: $svc $op" >&2
    exit 255
    ;;
esac
