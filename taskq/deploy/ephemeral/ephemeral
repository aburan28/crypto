#!/usr/bin/env bash
#
# ephemeral: run one command on a fresh EC2 instance that terminates itself.
#
#   ephemeral run [options] -- CMD [ARGS...]   launch, follow the log, fetch outputs
#   ephemeral ls                               live runners and recent jobs
#   ephemeral status ID                        phase, instance, exit code
#   ephemeral logs ID [-f]                     print (or follow) the job log
#   ephemeral fetch ID [DIR]                   download everything the job left in S3
#   ephemeral kill ID                          terminate the runner now
#   ephemeral shell ID                         Session Manager shell on the runner
#   ephemeral config                           the settings Terraform published
#
# ID may be `last` for the most recent job launched from this machine.
#
# run options:
#   --type T          instance type (default c7i.4xlarge). GPU types (g*, p*)
#                     get the NVIDIA Deep Learning AMI, Graviton types arm64.
#   --spot            spot capacity; an interruption ends the job as `interrupted`
#   --ttl SPAN        hard lifetime, e.g. 90m, 6h, 2d (default from config).
#                     The command is stopped 10 min before it to upload results.
#   --disk GB         root volume size (default 100)
#   --toolchain P     none | build (gcc, cmake, gmp...) | rust (build + rustup; default)
#   --setup CMD       shell command run in the checkout before the job
#   --env K=V         environment variable for the job (repeatable)
#   --artifact PATH   file or glob, relative to the checkout, copied to outputs
#                     (repeatable). Anything written to $EPHEMERAL_OUT is kept too.
#   --paths P,...     sparse checkout: fetch only these directories
#   --no-untracked    ship tracked changes only, not new files
#   --ref REF         run a pushed commit instead of the working tree
#   --no-source       do not check anything out
#   --name SLUG       label for the job id (default: the command's first word)
#   --detach          print the job id and return; follow later with `logs -f`
#   --keep            leave the instance up after the job, until the TTL
#   --out DIR         where outputs land (default ~/.cache/ephemeral/runs/ID)
#   --ami ID          explicit AMI (default: resolved for the instance type)
#
# By default the job runs exactly what is in your working tree: the newest
# commit already on a remote, plus a binary patch of everything after it
# (unpushed commits, staged and unstaged changes, and untracked files that are
# not ignored, minus virtualenvs, node_modules, __pycache__ and files > 5 MiB).
#
# Exit status of `run` (and `logs -f`): the command's own exit status when it
# ran, 124 on timeout, 75 when spot reclaimed the instance, 70 when the runner
# failed before or around the command, 130 when you detach with Ctrl-C.
#
# Environment: EPHEMERAL_CONFIG (SSM parameter, default /ephemeral/config),
# EPHEMERAL_REGION (default AWS_REGION, then us-east-1), AWS_PROFILE.

set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/ephemeral
REGION=${EPHEMERAL_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}}
export AWS_REGION=$REGION AWS_DEFAULT_REGION=$REGION
PARAM=${EPHEMERAL_CONFIG:-/ephemeral/config}
POLL=${EPHEMERAL_POLL:-10}

die() { echo "ephemeral: $*" >&2; exit 1; }
info() { echo "ephemeral: $*" >&2; }
usage() { sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
need() { command -v "$1" >/dev/null || die "$1 is required"; }

need aws
need jq

CONFIG=
load_config() {
    [ -n "$CONFIG" ] && return
    CONFIG=$(aws ssm get-parameter --name "$PARAM" --query Parameter.Value --output text 2>&1) \
        || die "cannot read SSM parameter $PARAM in $REGION (deployed? right region/profile?): $CONFIG"
    BUCKET=$(cfg .bucket)
}
cfg() { jq -r "$1" <<<"$CONFIG"; }

s3_job() { echo "s3://$BUCKET/jobs/$1"; }

resolve_id() {
    local id=$1
    if [ "$id" = last ]; then
        [ -f "$CACHE/last" ] || die "no job launched from this machine yet"
        id=$(cat "$CACHE/last")
    fi
    [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || die "bad job id: $id"
    echo "$id"
}

get_status() { aws s3 cp --only-show-errors "$(s3_job "$1")/status.json" - 2>/dev/null || true; }

instance_of() {
    aws ec2 describe-instances --filters "Name=tag:ephemeral:job,Values=$1" \
        --query 'Reservations[].Instances[] | sort_by(@,&LaunchTime)[-1].[InstanceId,State.Name]' \
        --output text 2>/dev/null || true
}

# Seconds in a span like 45m, 6h, 2d, 3600 or 3600s.
span_seconds() {
    [[ $1 =~ ^([0-9]+)([smhd]?)$ ]] || die "bad duration: $1 (use e.g. 90m, 6h, 2d)"
    local n=${BASH_REMATCH[1]}
    case ${BASH_REMATCH[2]} in
    s | "") echo "$n" ;;
    m) echo $((n * 60)) ;;
    h) echo $((n * 3600)) ;;
    d) echo $((n * 86400)) ;;
    esac
}

# ---- source snapshot ------------------------------------------------------

# https form of the current repository's origin, if it has one.
origin_https() {
    local url
    url=$(git remote get-url origin 2>/dev/null) || return 1
    case $url in
    git@github.com:*) url="https://github.com/${url#git@github.com:}" ;;
    ssh://git@github.com/*) url="https://github.com/${url#ssh://git@github.com/}" ;;
    esac
    echo "$url"
}

# The newest commit of HEAD's history that a remote already has.
pushed_base() {
    local oldest
    oldest=$(git rev-list --topo-order HEAD --not --remotes | tail -1)
    if [ -z "$oldest" ]; then
        git rev-parse HEAD
    else
        local base
        base=$(git rev-parse --verify -q "$oldest^") || die "no commit of HEAD's history is on a remote: push something first"
        if [ -z "$(git for-each-ref --contains "$base" refs/remotes)" ]; then
            base=$(git merge-base HEAD "$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || echo origin/main)") \
                || die "cannot find a pushed ancestor of HEAD"
        fi
        echo "$base"
    fi
}

# Binary diff from $1 to the working tree, without touching the real index.
# Tracked changes always ship. Untracked files ship unless $2 is false, minus
# virtualenvs, node_modules, __pycache__ and anything over 5 MiB: those are
# listed on stderr instead, so nothing is dropped silently.
worktree_patch() {
    local base=$1 untracked=${2:-true} idx f
    idx=$(mktemp)
    # A copy of the real index keeps its stat cache, so `add` hashes only
    # what changed instead of every file in the tree.
    cp "$(git rev-parse --git-path index)" "$idx"
    (
        export GIT_INDEX_FILE=$idx
        git add -u
        if $untracked; then
            git ls-files -z --others --exclude-standard | while IFS= read -r -d '' f; do
                case /$f in
                */.venv/* | */venv/* | */node_modules/* | */__pycache__/*) continue ;;
                esac
                if [ "$(stat -c %s -- "$f")" -gt $((5 << 20)) ]; then
                    echo "ephemeral: not shipping untracked $f ($(($(stat -c %s -- "$f") >> 20)) MiB); commit it or use --artifact on the box" >&2
                    continue
                fi
                printf '%s\0' "$f"
            done | git add --pathspec-from-file=- --pathspec-file-nul
        fi
        git diff --cached --binary "$base"
    )
    rm -f "$idx"
}

# ---- run ------------------------------------------------------------------

cmd_run() {
    local type=c7i.4xlarge spot=false ttl='' disk=100 toolchain=rust setup='' name='' detach=false
    local keep=false out='' ami='' ref='' source=true untracked=true paths=() artifacts=() envs=()
    while [ $# -gt 0 ]; do
        case $1 in
        --type) type=$2; shift 2 ;;
        --spot) spot=true; shift ;;
        --ttl) ttl=$2; shift 2 ;;
        --disk) disk=$2; shift 2 ;;
        --toolchain) toolchain=$2; shift 2 ;;
        --setup) setup=$2; shift 2 ;;
        --env) [[ $2 == *=* ]] || die "--env wants KEY=VALUE"; envs+=("$2"); shift 2 ;;
        --artifact) artifacts+=("$2"); shift 2 ;;
        --paths) IFS=, read -ra paths <<<"$2"; shift 2 ;;
        --ref) ref=$2; shift 2 ;;
        --no-source) source=false; shift ;;
        --no-untracked) untracked=false; shift ;;
        --name) name=$2; shift 2 ;;
        --detach) detach=true; shift ;;
        --keep) keep=true; shift ;;
        --out) out=$2; shift 2 ;;
        --ami) ami=$2; shift 2 ;;
        --) shift; break ;;
        -h | --help) usage 0 ;;
        *) die "unknown option $1 (the command goes after --)" ;;
        esac
    done
    [ $# -gt 0 ] || die "no command: ephemeral run [options] -- CMD"
    case $toolchain in none | build | rust) ;; *) die "--toolchain is none, build or rust" ;; esac
    if ! $source && [ -n "$ref" ]; then die "--ref and --no-source contradict each other"; fi
    [[ $disk =~ ^[0-9]+$ ]] || die "--disk wants a number of GB"
    load_config

    ttl=${ttl:-$(cfg .default_ttl)}
    local ttl_s max_s
    ttl_s=$(span_seconds "$ttl")
    max_s=$(($(cfg .max_ttl_hours) * 3600))
    [ "$ttl_s" -le "$max_s" ] || die "--ttl $ttl is over the $(cfg .max_ttl_hours)h ceiling"
    [ "$ttl_s" -ge 900 ] || die "--ttl must be at least 15m (boot, setup and upload need time)"

    # Job id: sortable, readable, unique.
    if [ -z "$name" ]; then name=$(basename -- "${1%% *}"); fi
    name=$(tr -cs 'A-Za-z0-9' '-' <<<"$name" | tr '[:upper:]' '[:lower:]' | sed 's/^-*//; s/-*$//' | cut -c1-24)
    local id
    id="$(date -u +%Y%m%d-%H%M%S)-${name:-job}-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"

    stage=""  # global: the EXIT trap outlives this function
    stage=$(mktemp -d)
    trap 'rm -rf "${stage:-}"' EXIT
    if [ -n "$out" ]; then mkdir -p "$out" && out=$(cd "$out" && pwd); fi

    # Source: the commit a runner can fetch, and the patch on top of it.
    local repo_url='' commit='' head='' patch=false
    if $source; then
        git rev-parse --show-toplevel >/dev/null 2>&1 || die "not in a git repository (use --no-source)"
        cd "$(git rev-parse --show-toplevel)"
        repo_url=$(origin_https || cfg .repo_url)
        head=$(git rev-parse HEAD)
        if [ -n "$ref" ]; then
            commit=$(git rev-parse --verify "$ref^{commit}") || die "unknown ref $ref"
            [ -n "$(git for-each-ref --contains "$commit" refs/remotes)" ] \
                || die "$ref ($commit) is not on any remote: push it, or drop --ref to ship the working tree"
        else
            commit=$(pushed_base)
            worktree_patch "$commit" "$untracked" >"$stage/patch.diff"
            if [ -s "$stage/patch.diff" ]; then
                patch=true
                local size
                size=$(wc -c <"$stage/patch.diff")
                info "shipping $(git rev-list --count "$commit..HEAD") unpushed commit(s) + local changes as a $((size / 1024)) KiB patch on ${commit:0:12}"
                [ "$size" -lt $((200 * 1024 * 1024)) ] || die "patch is $((size >> 20)) MiB: commit and push large files, or use --ref"
            fi
        fi
    fi

    # The command: one argument is a shell snippet, several are an argv.
    if [ $# -eq 1 ]; then
        printf '%s\n' "$1" >"$stage/cmd.sh"
    else
        printf 'exec' >"$stage/cmd.sh"
        printf ' %q' "$@" >>"$stage/cmd.sh"
        echo >>"$stage/cmd.sh"
    fi
    local display="$*"

    : >"$stage/env"
    local kv
    for kv in ${envs[@]+"${envs[@]}"}; do
        printf '%s=%q\n' "${kv%%=*}" "${kv#*=}" >>"$stage/env"
    done

    # AMI by architecture and GPU.
    local arch gpu ami_ref
    read -r arch gpu < <(aws ec2 describe-instance-types --instance-types "$type" \
        --query 'InstanceTypes[0].[ProcessorInfo.SupportedArchitectures[0], GpuInfo.Gpus[0].Manufacturer]' \
        --output text 2>/dev/null) || die "unknown instance type $type in $REGION"
    if [ -n "$ami" ]; then
        ami_ref=$ami
    elif [ "$gpu" = NVIDIA ]; then
        [ "$arch" = x86_64 ] || die "$type: arm64 GPU instances are not supported"
        ami_ref="resolve:ssm:$(cfg .gpu_ami_param)"
    elif [ "$arch" = arm64 ]; then
        ami_ref="resolve:ssm:$(cfg .arm_ami_param)"
    else
        ami_ref="resolve:ssm:$(cfg .cpu_ami_param)"
    fi

    local now deadline owner
    now=$(date +%s)
    deadline=$((now + ttl_s))
    owner="$(id -un)@$(hostname -s)"

    local paths_json artifacts_json
    paths_json=$(printf '%s\n' ${paths[@]+"${paths[@]}"} | jq -R . | jq -sc 'map(select(. != ""))')
    artifacts_json=$(printf '%s\n' ${artifacts[@]+"${artifacts[@]}"} | jq -R . | jq -sc 'map(select(. != ""))')
    jq -n --arg id "$id" --arg owner "$owner" --arg type "$type" --argjson spot "$spot" \
        --arg ttl "$ttl" --argjson deadline "$deadline" --arg toolchain "$toolchain" \
        --arg setup "$setup" --arg repo "$repo_url" --arg commit "$commit" --arg head "$head" \
        --argjson patch "$patch" --argjson keep "$keep" --arg display "$display" --arg ami "$ami_ref" \
        --argjson disk "$disk" --argjson paths "$paths_json" --argjson artifacts "$artifacts_json" \
        '{
            id: $id, created: (now | todate), owner: $owner, instance_type: $type, spot: $spot,
            ttl: $ttl, deadline: $deadline, disk_gb: $disk, ami: $ami, toolchain: $toolchain,
            setup: $setup, repo_url: $repo, commit: $commit, local_head: $head, patch: $patch,
            keep: $keep, command_display: $display, paths: $paths, artifacts: $artifacts
        }' >"$stage/job.json"

    cp "$HERE/runner.sh" "$stage/runner.sh"
    printf '{"job":"%s","phase":"launching","updated":"%s","deadline":%s,"exit_code":null}\n' \
        "$id" "$(date -u +%FT%TZ)" "$deadline" >"$stage/status.json"
    local f
    for f in job.json cmd.sh env runner.sh status.json; do
        aws s3 cp --only-show-errors "$stage/$f" "$(s3_job "$id")/$f"
    done
    if $patch; then aws s3 cp --only-show-errors "$stage/patch.diff" "$(s3_job "$id")/patch.diff"; fi

    # User data: arm the deadline before anything else can go wrong.
    cat >"$stage/user-data" <<EOF
#!/bin/bash
left=\$(( $deadline - \$(date +%s) ))
[ "\$left" -gt 0 ] || shutdown -h now
systemd-run --unit=ephemeral-deadline --on-active="\${left}s" /sbin/shutdown -h now
export EPHEMERAL_JOB=$id EPHEMERAL_BUCKET=$BUCKET EPHEMERAL_DEADLINE=$deadline AWS_DEFAULT_REGION=$REGION
for i in \$(seq 1 20); do
    aws s3 cp --only-show-errors s3://$BUCKET/jobs/$id/runner.sh /root/ephemeral-runner.sh && break
    sleep 6
done
bash /root/ephemeral-runner.sh
$keep || shutdown -h now
EOF

    local tags
    tags="{Key=Name,Value=ephemeral-$id},{Key=ephemeral:job,Value=$id},{Key=ephemeral:deadline,Value=$deadline},{Key=$(cfg .managed_tag),Value=true},{Key=ephemeral:owner,Value=$owner}"
    local market=()
    if $spot; then
        market=(--instance-market-options 'MarketType=spot,SpotOptions={SpotInstanceType=one-time,InstanceInterruptionBehavior=terminate}')
    fi

    mkdir -p "$CACHE"
    echo "$id" >"$CACHE/last"

    # A job that never got an instance must not sit at "launching" forever.
    launch_failed() {
        printf '{"job":"%s","phase":"error","reason":"launch failed: %s","updated":"%s","deadline":%s,"exit_code":null}\n' \
            "$id" "$(tr -d '"\\\n' <<<"$1" | cut -c1-300)" "$(date -u +%FT%TZ)" "$deadline" |
            aws s3 cp --only-show-errors - "$(s3_job "$id")/status.json" || true
        die "$1"
    }

    # Try each configured subnet (one per AZ) until one has capacity.
    local subnets iid='' err subnet
    mapfile -t subnets < <(cfg '.subnet_ids[]' | shuf)
    for subnet in "${subnets[@]}"; do
        if iid=$(aws ec2 run-instances \
            --launch-template "LaunchTemplateId=$(cfg .launch_template),Version=\$Default" \
            --image-id "$ami_ref" --instance-type "$type" \
            --subnet-id "$subnet" --security-group-ids "$(cfg .security_group)" \
            --block-device-mappings "DeviceName=/dev/xvda,Ebs={VolumeSize=$disk,VolumeType=gp3,Encrypted=true,DeleteOnTermination=true}" \
            --user-data "file://$stage/user-data" \
            ${market[@]+"${market[@]}"} \
            --tag-specifications "ResourceType=instance,Tags=[$tags]" \
            "ResourceType=volume,Tags=[{Key=$(cfg .managed_tag),Value=true},{Key=ephemeral:job,Value=$id}]" \
            --query 'Instances[0].InstanceId' --output text 2>"$stage/err"); then
            break
        fi
        err=$(cat "$stage/err")
        iid=
        case $err in
        *InsufficientInstanceCapacity* | *Unsupported* | *capacity-not-available*)
            info "$subnet: $(grep -o '(.*' <<<"$err" | head -1 | cut -c1-200); trying the next zone" ;;
        *) launch_failed "run-instances failed: $err" ;;
        esac
    done
    [ -n "$iid" ] || launch_failed "no zone could launch $type (reasons above); try another type, --spot or not, or later"

    info "job $id"
    info "  $type$($spot && echo ' spot') $iid, ttl $ttl (terminates by $(date -u -d "@$deadline" +%FT%TZ))"
    info "  ${commit:+source ${commit:0:12}$($patch && echo ' + local patch'), }command: $display"
    info "  s3://$BUCKET/jobs/$id/"
    if $detach; then
        echo "$id"
        return 0
    fi
    follow "$id" "${out:-$CACHE/runs/$id}"
}

# ---- follow ---------------------------------------------------------------

# Print the log as it grows, return when the job reaches a final phase, then
# download its outputs. The job keeps running if you press Ctrl-C.
follow() {
    local id=$1 out=${2:-} offset=0 phase='' last_phase='' tick=0 st chunk
    chunk=$(mktemp)
    trap 'rm -f "$chunk"; echo; info "detached; $id keeps running. ephemeral logs -f $id | ephemeral kill $id"; exit 130' INT
    while :; do
        if aws s3api get-object --bucket "$BUCKET" --key "jobs/$id/job.log" \
            --range "bytes=$offset-" "$chunk" >/dev/null 2>&1; then
            cat "$chunk"
            offset=$((offset + $(wc -c <"$chunk")))
        fi
        st=$(get_status "$id")
        phase=$(jq -r '.phase // empty' <<<"$st" 2>/dev/null || true)
        if [ -n "$phase" ] && [ "$phase" != "$last_phase" ]; then
            last_phase=$phase
        fi
        case $phase in
        done | failed | timeout | interrupted | error | killed | lost) break ;;
        esac
        # A runner that died without reporting: check EC2 about once a minute.
        tick=$((tick + 1))
        if [ $((tick % 6)) -eq 0 ]; then
            local state
            state=$(instance_of "$id" | awk '{print $2}')
            if [ "$state" = terminated ] || [ "$state" = shutting-down ]; then
                sleep "$POLL"
                st=$(get_status "$id")
                phase=$(jq -r '.phase // empty' <<<"$st" 2>/dev/null || true)
                case $phase in
                done | failed | timeout | interrupted | error | killed) ;;
                *) phase=lost ;;
                esac
                break
            fi
        fi
        sleep "$POLL"
    done
    # Drain the tail of the log.
    if aws s3api get-object --bucket "$BUCKET" --key "jobs/$id/job.log" \
        --range "bytes=$offset-" "$chunk" >/dev/null 2>&1; then cat "$chunk"; fi
    rm -f "$chunk"
    trap - INT

    local code
    code=$(jq -r '.exit_code // empty' <<<"$st" 2>/dev/null || true)
    if [ -n "$out" ]; then
        mkdir -p "$out"
        aws s3 sync --only-show-errors "$(s3_job "$id")/" "$out/" --exclude runner.sh || true
        info "outputs: $out"
    fi
    info "job $id: $phase$( [ -n "$code" ] && echo " (exit $code)")"
    case $phase in
    done) return 0 ;;
    failed) return "${code:-1}" ;;
    timeout) return 124 ;;
    interrupted) return 75 ;;
    *) return 70 ;;
    esac
}

# ---- other commands -------------------------------------------------------

cmd_ls() {
    load_config
    echo "live runners:"
    aws ec2 describe-instances \
        --filters "Name=tag:$(cfg .managed_tag),Values=true" "Name=instance-state-name,Values=pending,running,stopping,shutting-down" \
        --query 'Reservations[].Instances[].[Tags[?Key==`ephemeral:job`]|[0].Value, InstanceId, InstanceType, State.Name, InstanceLifecycle || `on-demand`, LaunchTime]' \
        --output text | sed 's/^/  /'
    echo "recent jobs:"
    local id
    { aws s3 ls "s3://$BUCKET/jobs/" 2>/dev/null || true; } | awk '{print $2}' | tr -d / | sort | tail -"${1:-10}" | while read -r id; do
        printf '  %-48s %s\n' "$id" "$(get_status "$id" | jq -r '"\(.phase) \(.exit_code // "")"' 2>/dev/null)"
    done
}

cmd_status() {
    local id
    id=$(resolve_id "${1:?usage: ephemeral status ID}")
    load_config
    get_status "$id" | jq . || die "no status for $id"
    echo "instance: $(instance_of "$id")"
}

cmd_logs() {
    local follow_=false args=()
    for a in "$@"; do
        if [ "$a" = -f ]; then follow_=true; else args+=("$a"); fi
    done
    local id
    id=$(resolve_id "${args[0]:?usage: ephemeral logs ID [-f]}")
    load_config
    if $follow_; then
        follow "$id" "$CACHE/runs/$id"
    else
        aws s3 cp --only-show-errors "$(s3_job "$id")/job.log" - || die "no log yet for $id"
    fi
}

cmd_fetch() {
    local id
    id=$(resolve_id "${1:?usage: ephemeral fetch ID [DIR]}")
    load_config
    local dir=${2:-$CACHE/runs/$id}
    mkdir -p "$dir"
    aws s3 sync --only-show-errors "$(s3_job "$id")/" "$dir/" --exclude runner.sh
    echo "$dir"
}

cmd_kill() {
    local id
    id=$(resolve_id "${1:?usage: ephemeral kill ID}")
    load_config
    local iid state
    read -r iid state < <(instance_of "$id") || true
    [ -n "${iid:-}" ] && [ "$iid" != None ] || die "no instance for $id"
    aws ec2 terminate-instances --instance-ids "$iid" --query 'TerminatingInstances[0].CurrentState.Name' --output text
    printf '{"job":"%s","phase":"killed","reason":"ephemeral kill from %s","instance_id":"%s","updated":"%s","exit_code":null}\n' \
        "$id" "$(id -un)@$(hostname -s)" "$iid" "$(date -u +%FT%TZ)" |
        aws s3 cp --only-show-errors - "$(s3_job "$id")/status.json"
    info "terminated $iid ($id)"
}

cmd_shell() {
    local id
    id=$(resolve_id "${1:?usage: ephemeral shell ID}")
    load_config
    local iid
    iid=$(instance_of "$id" | awk '{print $1}')
    [ -n "$iid" ] && [ "$iid" != None ] || die "no instance for $id"
    need session-manager-plugin
    exec aws ssm start-session --target "$iid"
}

case ${1:-} in
run) shift; cmd_run "$@" ;;
ls) shift; cmd_ls "$@" ;;
status) shift; cmd_status "$@" ;;
logs) shift; cmd_logs "$@" ;;
fetch) shift; cmd_fetch "$@" ;;
kill) shift; cmd_kill "$@" ;;
shell) shift; cmd_shell "$@" ;;
config) load_config; jq . <<<"$CONFIG" ;;
-h | --help | help) usage 0 ;;
*) usage ;;
esac
