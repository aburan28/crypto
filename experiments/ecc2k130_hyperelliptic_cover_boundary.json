  "boundary_D_genus_floor": {
    "statement": "<G> is A(F_2) for a simple abelian variety A/F_2 of dimension 130, so any correspondence over F_2 carrying the discrete logarithm to a curve C/F_2 forces genus(C) >= 130",
    "weil_restriction": "Res_{F_2^131/F_2}(E) ~ E x A, from t^131 - 1 = (t-1) Phi_131(t)",
