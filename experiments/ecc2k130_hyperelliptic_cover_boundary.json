    "points_on_A_equal_r": true,
    "functional_equation_verified": true,
    "A_is_simple": true,
    "simplicity_proof": "the Weil numbers of A are zeta*alpha with zeta^131 = 1, zeta != 1 and alpha = (-1+sqrt(-7))/2.  Q(sqrt(-7)) has conductor 7, which does not divide 131, so Q(zeta_131) and Q(sqrt(-7)) are linearly disjoint; the only roots of unity in Q(sqrt(-7)) are +-1 and 131 is odd, so no element of Gal(Q(zeta_131, sqrt(-7))/Q) fixes zeta*alpha.  Its degree is therefore 260 = 2 dim A, and Honda-Tate makes A simple",
    "weil_bound_genus_floor": 51,
    "simplicity_genus_floor": 130
  },
