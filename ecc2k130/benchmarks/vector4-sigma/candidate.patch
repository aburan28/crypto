+def emitVectorSharedWalkPair(nets):
+    # Consecutive unique row IDs form one four-component vector. The original
+    # scalar/global/inverse table and helpers are not changed.
+    exponents = list(range(3,11))
+    chosen = [nets[k] for k in exponents]
+    ops = []
+    for stage in range(len(chosen[0])):
+        d = chosen[0][stage][0]
+        for word in range(8):
+            masks = tuple((net[stage][1] >> (32*word)) & 0xffffffff for net in chosen)
+            if any(masks):
+                ops.append((d,word,masks))
+    unique = list(dict.fromkeys(row for _,_,row in ops))
+    if len(unique) != 56:
+        raise ValueError('vector mask grouping requires the reviewed56 rows')
+    lines = ['#if ECC_PACKED_SHARED_SIGMA',
+             '#ifdef __CUDACC__',
+             'using SigmaWalkVector131 = uint4;',
+             'static __shared__ __align__(16) uint4 sigmaWalkSharedVector131Masks[14][8];',
+             '#else',
+             'struct alignas(16) SigmaWalkVector131 { uint32_t x,y,z,w; };',
+             '#endif',
+             'static_assert(sizeof(SigmaWalkVector131)==16, "four mask words without padding");',
+             'static ECC_HD void initSigmaWalkShared131() {',
+             '#ifdef __CUDA_ARCH__',
+             '    for (unsigned i=threadIdx.x; i<448u; i+=blockDim.x) {',
+             '        const uint32_t value=__ldg(&sigmaWalkNetwork131Masks[i/8][i%8]);',
+             '        uint4 &destination=sigmaWalkSharedVector131Masks[i/32][i%8];',
+             '        // Separate scalar members have distinct writers. Do not',
+             '        // use a read-modify-write vector store for one component.',
+             '        switch ((i/8)%4) {',
+             '        case 0: destination.x=value; break;',
+             '        case 1: destination.y=value; break;',
+             '        case 2: destination.z=value; break;',
+             '        default: destination.w=value; break;',
+             '        }',
+             '    }',
+             '    __syncthreads();',
+             '#endif',
+             '}',
+             'static ECC_BIG SigmaWalkPair131 sigmaWalkNetworkPairShared131(P131 a,P131 b,int index) {',
+             '#if defined(__CUDACC__) && !defined(__CUDA_ARCH__)',
+             '    const int exponents[] = {3,4,5,6,7,8,9,10};',
+             '    for (int i=0;i<exponents[index];i++) { a=sqr131(a); b=sqr131(b); }',
+             '    return SigmaWalkPair131{a,b};',
+             '#else',
+             '    uint32_t a0=a.v[0], a1=a.v[1], a2=a.v[2], a3=a.v[3], a4=a.v[4];',
+             '    uint32_t b0=b.v[0], b1=b.v[1], b2=b.v[2], b3=b.v[3], b4=b.v[4];',
+             '    uint32_t a5=0, a6=0, a7=0, b5=0, b6=0, b7=0, t, mask;']
+    loaded = set()
+    fields = ('x','y','z','w')
+    for d,word,row in ops:
+        idx = unique.index(row)
+        group,component = divmod(idx,4)
+        if group not in loaded:
+            loaded.add(group)
+            lines += ['#ifdef __CUDA_ARCH__',
