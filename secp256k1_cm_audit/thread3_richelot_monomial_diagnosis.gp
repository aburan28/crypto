\\ thread3_richelot_monomial_diagnosis.gp
\\
\\ Thread 3 (CHLRS Igusa forward map), autolab 2026-08-10.
\\
\\ Finding: for j=0 curves E1: y^2=x^3+b1, E2: y^2=x^3+b2 over F_p (p=1 mod 3),
\\ any Galois-equivariant bijection phi: E1[2]\{O} -> E2[2]\{O} forces the
\\ "beta" 2-torsion x-coordinate (root of x^3+b2) to be a MONOMIAL relative to
\\ alpha (root of x^3+b1) in the shared cyclic cubic extension F_p[a]/(a^3+b1):
\\ beta = d*a  or  beta = d*a^2  for some scalar d in F_p (never a mixed
\\ combination). This is forced by Kummer theory (F_p(a)*/(F_p(a)*)^3 is
\\ generated by monomials in the eigenbasis of the a).
\\
\\ Every monomial choice tested here (see log 2026-08-10) either:
\\   (a) corresponds to an actual F_p-isomorphism E1->E2 (the sextic-twist
\\       substitution x=u^2 X), which Howe's theorem explicitly EXCLUDES
\\       (H1: phi must not extend to a full isomorphism) -- these give a
\\       smooth Richelot dual but with the WRONG Jacobian order, or
\\   (b) makes the Richelot D0 quantity singular (degenerate, matches the
\\       known (0,3) sextic-twist-pair degeneracy).
\\
\\ Since (a)/(b) exhaust all monomial betas, and monomial is the ONLY
\\ possibility, the classical "Richelot-dual-of-the-naive-product-curve"
\\ construction used in howe_5pairs_v2.gp / chlrs_*.gp CANNOT produce a
\\ non-degenerate Howe-glued cover for ANY j=0 sextic-twist pair via this
\\ route. See RESEARCH_AUTOLAB_LOG.md 2026-08-10 for the full derivation
\\ and the corrected toy prime (1039 = 7 mod 12, matching secp256k1's
\\ residue class -- 1009 = 1 mod 12 was the wrong toy prime used in prior
\\ sessions and additionally has the spurious degeneracy that its
\\ primitive 6th root of unity h is itself an F_p 6th power).
\\
\\ Run: gp -q secp256k1_cm_audit/thread3_richelot_monomial_diagnosis.gp

default(parisize, 256000000);

f3add(u, v, pp) = [(u[1]+v[1])%pp, (u[2]+v[2])%pp, (u[3]+v[3])%pp];
f3mul(u, v, rr, pp) = {
  my(c0, c1, c2, c3, c4);
  c0 = (u[1]*v[1]) % pp;
  c1 = (u[1]*v[2] + u[2]*v[1]) % pp;
  c2 = (u[1]*v[3] + u[2]*v[2] + u[3]*v[1]) % pp;
  c3 = (u[2]*v[3] + u[3]*v[2]) % pp;
  c4 = (u[3]*v[3]) % pp;
  [(c0 + rr*c3) % pp,  (c1 + rr*c4) % pp,  c2 % pp]
};
f3neg(u, pp)    = [(-u[1])%pp, (-u[2])%pp, (-u[3])%pp];
f3scl(c, u, pp) = [(c*u[1])%pp, (c*u[2])%pp, (c*u[3])%pp];
f3inv(u, rr, pp) = {
  my(a, b, c, nrm, ni);
  a = u[1]; b = u[2]; c = u[3];
  nrm = lift(Mod(a^3 + rr*b^3 + rr^2*c^3 - 3*rr*a*b*c, pp));
  if(nrm == 0, error("f3inv: norm=0, element not invertible"));
  ni = lift(Mod(nrm, pp)^(-1));
  [((a^2 - rr*b*c)*ni) % pp, ((rr*c^2 - a*b)*ni) % pp, ((b^2 - a*c)*ni) % pp]
};
richelot(sv, qv, z3, rr, pp) = {
  my(z3sq, G1c, G1x, G2c, G2x, G3c, G3x, D0, D0inv);
  my(H1n2,H1n1,H1n0,H2n2,H2n1,H2n0,H3n2,H3n1,H3n0);
  my(H1x2,H1x1,H1x0,H2x2,H2x1,H2x0,H3x2,H3x1,H3x0);
  my(P0,P1,P2,P3,P4,Q0r,Q1r,Q2r,Q3r,Q4r,Q5r,Q6r,lc,lcinv,aa,bb);
  z3sq = lift(Mod(z3, pp)^2);
  G1c = qv;          G1x = f3neg(sv, pp);
  G2c = f3scl(z3sq, qv, pp);  G2x = f3neg(f3scl(z3, sv, pp), pp);
  G3c = f3scl(z3, qv, pp);   G3x = f3neg(f3scl(z3sq, sv, pp), pp);
  D0 = f3add(f3add(
    f3add(f3mul(G2x,G3c,rr,pp), f3neg(f3mul(G3x,G2c,rr,pp),pp), pp),
    f3neg(f3mul(G1x, f3add(G3c, f3neg(G2c,pp), pp), rr, pp), pp), pp),
    f3mul(G1c, f3add(G3x, f3neg(G2x,pp), pp), rr, pp), pp);
  D0inv = f3inv(D0, rr, pp);
  H1n2 = f3add(G3x, f3neg(G2x,pp), pp);
  H1n1 = f3scl(2, f3add(G3c, f3neg(G2c,pp), pp), pp);
  H1n0 = f3add(f3mul(G2x,G3c,rr,pp), f3neg(f3mul(G2c,G3x,rr,pp),pp), pp);
  H2n2 = f3add(G1x, f3neg(G3x,pp), pp);
  H2n1 = f3scl(2, f3add(G1c, f3neg(G3c,pp), pp), pp);
  H2n0 = f3add(f3mul(G3x,G1c,rr,pp), f3neg(f3mul(G3c,G1x,rr,pp),pp), pp);
  H3n2 = f3add(G2x, f3neg(G1x,pp), pp);
  H3n1 = f3scl(2, f3add(G2c, f3neg(G1c,pp), pp), pp);
  H3n0 = f3add(f3mul(G1x,G2c,rr,pp), f3neg(f3mul(G1c,G2x,rr,pp),pp), pp);
  H1x2=f3mul(H1n2,D0inv,rr,pp); H1x1=f3mul(H1n1,D0inv,rr,pp); H1x0=f3mul(H1n0,D0inv,rr,pp);
  H2x2=f3mul(H2n2,D0inv,rr,pp); H2x1=f3mul(H2n1,D0inv,rr,pp); H2x0=f3mul(H2n0,D0inv,rr,pp);
  H3x2=f3mul(H3n2,D0inv,rr,pp); H3x1=f3mul(H3n1,D0inv,rr,pp); H3x0=f3mul(H3n0,D0inv,rr,pp);
  P0=f3mul(H1x0,H2x0,rr,pp);
  P1=f3add(f3mul(H1x0,H2x1,rr,pp),f3mul(H1x1,H2x0,rr,pp),pp);
  P2=f3add(f3add(f3mul(H1x0,H2x2,rr,pp),f3mul(H1x1,H2x1,rr,pp),pp),f3mul(H1x2,H2x0,rr,pp),pp);
  P3=f3add(f3mul(H1x1,H2x2,rr,pp),f3mul(H1x2,H2x1,rr,pp),pp);
  P4=f3mul(H1x2,H2x2,rr,pp);
  Q0r=f3mul(P0,H3x0,rr,pp);
  Q1r=f3add(f3mul(P0,H3x1,rr,pp),f3mul(P1,H3x0,rr,pp),pp);
  Q2r=f3add(f3add(f3mul(P0,H3x2,rr,pp),f3mul(P1,H3x1,rr,pp),pp),f3mul(P2,H3x0,rr,pp),pp);
  Q3r=f3add(f3add(f3mul(P1,H3x2,rr,pp),f3mul(P2,H3x1,rr,pp),pp),f3mul(P3,H3x0,rr,pp),pp);
  Q4r=f3add(f3add(f3mul(P2,H3x2,rr,pp),f3mul(P3,H3x1,rr,pp),pp),f3mul(P4,H3x0,rr,pp),pp);
  Q5r=f3add(f3mul(P3,H3x2,rr,pp),f3mul(P4,H3x1,rr,pp),pp);
  Q6r=f3mul(P4,H3x2,rr,pp);
  if(Q0r[2]!=0||Q0r[3]!=0||Q3r[2]!=0||Q3r[3]!=0||Q6r[2]!=0||Q6r[3]!=0,return([-1,-1]));
  lc = Q6r[1]; if(lc==0, return([-1,-1]));
  lcinv = lift(Mod(lc,pp)^(-1));
  aa = (Q3r[1]*lcinv)%pp; bb=(Q0r[1]*lcinv)%pp;
  [aa, bb]
};

trycase(pp, b1, kk) = {
  my(rr,h,hk,b2,E1,E2,t1,t2,target,T,a0,negb2_ff,cbrts,found,alpha,z3);
  rr = (-b1)%pp;
  h = lift(polrootsmod(x^2-x+1,pp)[1]);
  hk = lift(Mod(h,pp)^kk);
  b2 = lift(Mod(hk,pp)*Mod(b1,pp));
  E1 = ellinit([0,b1],pp); E2 = ellinit([0,b2],pp);
  t1 = pp+1-ellcard(E1); t2 = pp+1-ellcard(E2);
  target = (pp+1-t1)*(pp+1-t2);
  print("=== p=",pp," pair(0,",kk,")  b1=",b1," b2=",b2,"  t1=",t1," t2=",t2,"  target=",target," ===");
  T = Mod(1,pp)*t^3 - rr;
  if(!polisirreducible(T), print("  x^3-rr reducible -- E1 has rational 2-torsion, skip"); return(0));
  a0 = ffgen(T,'a);
  negb2_ff = Mod(pp+1-1,pp)*0 + (-b2)%pp + 0*a0; \\ embed -b2 as scalar FFELT
  z3 = lift(polrootsmod(x^2+x+1,pp)[1]);
  found = 0;
  for(root_idx=0,2,
    my(cb,beta_ff,beta_poly,alpha_v,beta_v,sv,qv,res,hh,cp,nj);
    cb = sqrtn(negb2_ff,3) * Mod(z3,pp)^root_idx;
    beta_ff = cb; \\ beta itself IS the cube root of -b2 (beta^3=-b2 directly)
    beta_v = apply(lift, Vecrev(beta_ff.pol, 3));
    alpha_v = [0,1,0];
    sv = f3add(alpha_v, beta_v, pp);
    qv = f3mul(alpha_v, beta_v, rr, pp);
    res = iferr(richelot(sv,qv,z3,rr,pp), E, [-1,-1]);
    if(res[1]==-1,
      print("  root_idx=",root_idx,"  beta=",beta_v,"  degenerate/not over F_p"),
      hh = Mod(1,pp)*x^6 + Mod(res[1],pp)*x^3 + Mod(res[2],pp);
      cp = hyperellcharpoly(hh);
      nj = subst(cp,variable(cp),1);
      print("  root_idx=",root_idx,"  beta=",beta_v,"  a=",res[1]," b=",res[2],"  #Jac=",nj,"  target=",target,"  match=",nj==target);
      if(nj==target, found=1);
    );
  );
  found;
};

trycase(1039,11,2);
print("");
trycase(1039,11,5);
