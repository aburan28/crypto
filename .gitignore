/target
Cargo.lock

# macOS resource-fork sidecar files (created on filesystems mounted via
# Finder / SMB / etc.). Empty payload, just filesystem cruft.
._*
.DS_Store

# SageMath preparser output (generated when running `sage foo.sage`).
*.sage.py

# Compiled C benchmark binaries in research/ecdlp_autolab (built locally
# from the checked-in .c sources; not artifacts to track).
research/ecdlp_autolab/phase21_rho_v3
research/ecdlp_autolab/phase22_rho_barrett

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Thread 25 instance-table caches. Derived data: the seed lists and the grid
# live in glv_hnp_phase2_thread25.py and the tables rebuild deterministically
# in ~2s per size with --rebuild.
secp256k1_cm_audit/glv_hnp_phase2_thread25_table.json
secp256k1_cm_audit/glv_hnp_phase2_thread25_t*.json
