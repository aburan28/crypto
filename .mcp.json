{
  "mcpServers": {
    "conductor": {
      "args": [
        "--project",
        "crypto"
      ],
      "command": "conductor-mcp",
      "type": "stdio"
    },
    "cairn": {
      "args": [
        "--log",
        "${HOME}/.cairn/cairn.jsonl",
        "--root",
        "${HOME}/.cairn",
        "mcp"
      ],
      "command": "cairn",
      "type": "stdio"
    }
  }
}
