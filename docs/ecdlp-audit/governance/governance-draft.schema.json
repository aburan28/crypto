              "correction": true,
              "request": {"type": "object", "properties": {"transition_kind": {"const": "additive_correction"}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "would_append_correction"}, "history_effect": {"const": "would_append_supersession"}}}
            }
          }
        },
        {
          "if": {"properties": {"scenario_kind": {"const": "staleness"}}, "required": ["scenario_kind"]},
          "then": {
            "required": ["event", "staleness"],
            "properties": {
              "event": true,
              "staleness": true,
              "request": {"type": "object", "properties": {"transition_kind": {"const": "staleness_recheck"}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "would_mark_stale_and_recompute"}, "history_effect": {"const": "would_append_assessment"}}}
            }
          }
        },
        {
          "if": {"properties": {"scenario_kind": {"const": "external_replication"}}, "required": ["scenario_kind"]},
          "then": {
            "required": ["event", "external_replication"],
            "properties": {
              "event": true,
              "external_replication": true,
              "request": {"type": "object", "properties": {"transition_kind": {"const": "external_replication_registration"}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "record_replication_only"}, "history_effect": {"const": "would_append_replication_entry"}}}
            }
          }
        }
      ]
    }
  }
