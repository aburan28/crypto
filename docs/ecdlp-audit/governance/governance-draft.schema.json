        "scenario_kind": {"enum": ["promotion", "rejection", "demotion", "additive_correction", "staleness", "external_replication"]},
        "synthetic_scope": {"$ref": "#/$defs/syntheticScope"},
        "subject": {"$ref": "#/$defs/subject"},
        "request": {"$ref": "#/$defs/request"},
        "assignments": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/assignment"}},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
        "preflight_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/preflightCheck"}},
        "event": {"$ref": "#/$defs/event"},
        "correction": {"$ref": "#/$defs/correction"},
        "staleness": {"$ref": "#/$defs/staleness"},
        "external_replication": {"$ref": "#/$defs/externalReplication"},
        "history_snapshot": {"$ref": "#/$defs/historySnapshot"},
        "identity_checks": {"$ref": "#/$defs/identityChecks"},
        "expected_outcome": {"$ref": "#/$defs/expectedOutcome"},
        "semantic_validator_required": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"scenario_kind": {"const": "promotion"}}, "required": ["scenario_kind"]},
          "then": {
            "properties": {
              "request": {"type": "object", "properties": {"transition_kind": {"const": "promotion"}}},
              "identity_checks": {"type": "object", "properties": {"author_not_reviewer": {"const": true}, "required_roles_distinct": {"const": true}, "release_approver_not_author": {"const": true}, "conflicts_clear": {"const": true}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "eligible_for_authoritative_review"}}}
            }
          }
        },
        {
          "if": {"properties": {"scenario_kind": {"const": "rejection"}}, "required": ["scenario_kind"]},
          "then": {
            "properties": {
              "request": {"type": "object", "properties": {"transition_kind": {"const": "promotion"}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "reject"}, "history_effect": {"const": "none"}}}
            }
          }
        },
        {
          "if": {"properties": {"scenario_kind": {"const": "demotion"}}, "required": ["scenario_kind"]},
          "then": {
            "required": ["event"],
            "properties": {
              "event": true,
              "request": {"type": "object", "properties": {"transition_kind": {"const": "demotion"}}},
              "expected_outcome": {"type": "object", "properties": {"workflow_disposition": {"const": "would_append_demotion"}, "history_effect": {"const": "would_append_assessment"}}}
            }
          }
        },
        {
          "if": {"properties": {"scenario_kind": {"const": "additive_correction"}}, "required": ["scenario_kind"]},
          "then": {
