{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto/blob/main/docs/ecdlp-audit/governance/governance-draft.schema.json",
  "title": "ECDLP audit governance draft records",
  "description": "Strict structural contract for non-authoritative WS8 policy, ownership, and workflow-drill records. Schema validity cannot promote a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "record_id",
    "status",
    "authoritative",
    "promotion_allowed",
    "self_promotion_allowed",
    "synthetic_only",
    "created_at",
    "source_plan",
    "draft_notice"
  ],
  "properties": {
    "schema_version": {"const": "ecdlp-audit.governance/v1-draft"},
    "record_kind": {"enum": ["policy", "ownership_matrix", "workflow_fixture"]},
    "record_id": {"type": "string", "pattern": "^gov\\.[a-z0-9][a-z0-9._-]+$"},
    "status": {"const": "draft"},
    "authoritative": {"const": false},
    "promotion_allowed": {"const": false},
    "self_promotion_allowed": {"const": false},
    "synthetic_only": {"const": true},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "source_plan": {"const": "research/notes/ecdlp-general/RESEARCH_COMPREHENSIVE_ECDLP_AUDIT_PLAN.md#workstream-8--add-independent-governance"},
    "draft_notice": {"type": "string", "minLength": 20},
    "policy": {"$ref": "#/$defs/policy"},
    "ownership_matrix": {"$ref": "#/$defs/ownershipMatrix"},
    "fixture": {"$ref": "#/$defs/workflowFixture"}
  },
  "oneOf": [
    {
      "properties": {
        "record_kind": {"const": "policy"},
        "policy": true,
        "ownership_matrix": false,
        "fixture": false
      },
      "required": ["policy"]
    },
    {
      "properties": {
        "record_kind": {"const": "ownership_matrix"},
        "policy": false,
        "ownership_matrix": true,
        "fixture": false
      },
      "required": ["ownership_matrix"]
    },
    {
      "properties": {
        "record_kind": {"const": "workflow_fixture"},
        "policy": false,
        "ownership_matrix": false,
        "fixture": true
      },
      "required": ["fixture"]
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recordRef": {"type": "string", "pattern": "^(gov|synthetic)\\.[a-z0-9][a-z0-9._-]+$"},
    "role": {
      "enum": [
        "author",
        "mathematical_reviewer",
        "implementation_reviewer",
        "evidence_replay_reviewer",
        "authorization_privacy_reviewer",
        "release_approver",
        "external_replicator"
      ]
    },
    "internalRole": {
      "enum": [
        "author",
        "mathematical_reviewer",
        "implementation_reviewer",
        "evidence_replay_reviewer",
        "authorization_privacy_reviewer",
        "release_approver"
      ]
    },
    "conditionalReviewerRole": {
      "enum": [
        "mathematical_reviewer",
        "implementation_reviewer",
        "authorization_privacy_reviewer"
      ]
    },
    "transitionKind": {
      "enum": [
        "promotion",
        "demotion",
        "additive_correction",
        "staleness_recheck",
        "external_replication_registration"
      ]
    },
    "claimStatus": {"enum": ["supported", "refuted", "unknown", "not_applicable"]},
    "maturity": {
      "type": ["string", "null"],
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", null]
    },
    "roleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "purpose", "required_independence", "may_request", "may_review", "may_finalize", "veto_scope", "must_record"],
      "properties": {
        "role": {"$ref": "#/$defs/internalRole"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "required_independence": {
          "enum": ["originator", "distinct_person", "distinct_person_and_fresh_replay"]
        },
        "may_request": {"type": "boolean"},
        "may_review": {"type": "boolean"},
        "may_finalize": {"type": "boolean"},
        "veto_scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/transitionKind"}},
        "must_record": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "relationship_to_author",
              "conflicts",
              "reviewed_revisions",
              "decision",
              "rationale",
              "evidence_receipts"
            ]
          }
        }
      }
    },
    "transitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_kind", "required_inputs", "required_roles", "conditional_roles", "machine_gates", "veto_is_blocking", "history_mode", "draft_state_effect"],
      "properties": {
        "transition_kind": {"$ref": "#/$defs/transitionKind"},
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/internalRole"}
        },
        "conditional_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/conditionalReviewerRole"}
        },
        "machine_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "veto_is_blocking": {"const": true},
        "history_mode": {"enum": ["append_assessment", "append_decision", "append_supersession", "append_replication_entry"]},
        "draft_state_effect": {"const": "none"}
      }
    },
    "stalenessClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "description", "invalidators", "maximum_age_days", "recheck_action"],
      "properties": {
        "class": {"enum": ["immutable_content", "revision_bound", "time_bound", "event_bound"]},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "invalidators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "maximum_age_days": {"type": ["integer", "null"], "minimum": 1},
        "recheck_action": {"enum": ["verify_digest", "replay_on_revision_change", "replay_at_deadline", "replay_on_event"]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "purpose",
        "dependencies",
        "roles",
        "independence",
        "transition_rules",
        "staleness_classes",
        "decision_log",
        "release_checklist",
        "external_replication",
        "adoption_prerequisites",
        "non_claims"
      ],
      "properties": {
        "policy_version": {"const": "ws8-policy/v1-draft"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "dependencies": {
          "type": "array",
          "const": ["WS3", "WS4", "WS7"]
        },
        "roles": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/roleDefinition"}
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author_may_approve_own_work", "reviewer_may_hold_multiple_required_or_invoked_roles", "release_approver_may_override_veto", "external_replication_auto_promotes", "conflicts_require_recusal", "semantic_identity_check_required"],
          "properties": {
            "author_may_approve_own_work": {"const": false},
            "reviewer_may_hold_multiple_required_or_invoked_roles": {"const": false},
            "release_approver_may_override_veto": {"const": false},
            "external_replication_auto_promotes": {"const": false},
            "conflicts_require_recusal": {"const": true},
            "semantic_identity_check_required": {"const": true}
          }
        },
        "transition_rules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/transitionRule"}
        },
        "staleness_classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/stalenessClass"}
        },
        "decision_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["append_only", "exact_revision_binding", "prior_decisions_preserved", "decision_fields"],
          "properties": {
            "append_only": {"const": true},
            "exact_revision_binding": {"const": true},
            "prior_decisions_preserved": {"const": true},
            "decision_fields": {
              "type": "array",
              "const": ["actor", "role", "relationship", "conflicts", "review_binding", "decision", "rationale", "evidence_receipts", "timestamp"]
            }
          }
        },
        "release_checklist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "external_replication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_is_append_only", "replicator_cannot_finalize", "receipt_and_scope_required", "negative_and_failed_results_retained", "full_recheck_after_entry"],
          "properties": {
            "registry_is_append_only": {"const": true},
            "replicator_cannot_finalize": {"const": true},
            "receipt_and_scope_required": {"const": true},
            "negative_and_failed_results_retained": {"const": true},
            "full_recheck_after_entry": {"const": true}
          }
        },
        "adoption_prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "roleOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "owns", "must_not", "minimum_independence"],
      "properties": {
        "role": {"$ref": "#/$defs/internalRole"},
        "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "must_not": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "minimum_independence": {"enum": ["originator", "distinct_person", "distinct_person_and_fresh_replay"]}
      }
    },
    "actionOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_kind", "requester", "accountable", "required_reviewers", "conditional_reviewers", "finalizer", "veto_roles", "protected"],
      "properties": {
        "transition_kind": {"$ref": "#/$defs/transitionKind"},
        "requester": {"$ref": "#/$defs/internalRole"},
        "accountable": {"$ref": "#/$defs/internalRole"},
        "required_reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/internalRole"}},
        "conditional_reviewers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conditionalReviewerRole"}},
        "finalizer": {"const": "release_approver"},
        "veto_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/internalRole"}},
        "protected": {"const": true}
      }
    },
    "pathOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_pattern", "required_roles", "conditional_roles", "purpose"],
      "properties": {
        "path_pattern": {"$ref": "#/$defs/nonEmptyString"},
        "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/internalRole"}},
        "conditional_roles": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conditionalReviewerRole"}},
        "purpose": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "ownershipMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_version", "policy_record_id", "role_ownership", "action_ownership", "path_ownership", "enforcement", "non_claims"],
      "properties": {
        "matrix_version": {"const": "ws8-ownership/v1-draft"},
        "policy_record_id": {"const": "gov.policy.ws8.v1-draft"},
        "role_ownership": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/roleOwnership"}},
        "action_ownership": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/actionOwnership"}},
        "path_ownership": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathOwnership"}},
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codeowners_installed", "protected_approvals_installed", "semantic_validator_installed", "draft_can_change_authoritative_state"],
          "properties": {
            "codeowners_installed": {"const": false},
            "protected_approvals_installed": {"const": false},
            "semantic_validator_installed": {"const": false},
            "draft_can_change_authoritative_state": {"const": false}
          }
        },
        "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "syntheticScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_only", "public_synthetic", "contains_real_target", "contains_secret", "operational_execution", "scientific_evidence"],
      "properties": {
        "fixture_only": {"const": true},
        "public_synthetic": {"const": true},
        "contains_real_target": {"const": false},
        "contains_secret": {"const": false},
        "operational_execution": {"const": false},
        "scientific_evidence": {"const": false}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "description", "claim_status_before", "maturity_before", "authoritative_state_before"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^synthetic\\.[a-z0-9][a-z0-9._-]+$"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "claim_status_before": {"$ref": "#/$defs/claimStatus"},
        "maturity_before": {"$ref": "#/$defs/maturity"},
        "authoritative_state_before": {"const": "unchanged_fixture_baseline"}
      }
    },
    "revisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "revision_digest"],
      "properties": {
        "component": {"enum": ["source_assessment", "proposed_aggregate", "evidence_bundle", "evidence_profile", "accounting_receipt", "implementation", "authorization_record", "governance_schema", "dependency_lock"]},
        "revision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_revision_digest", "governance_schema_revision_digest", "dependency_revision_digest"],
      "properties": {
        "aggregate_revision_digest": {"$ref": "#/$defs/digest"},
        "governance_schema_revision_digest": {"$ref": "#/$defs/digest"},
        "dependency_revision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_kind", "requested_by", "author_identity", "source_assessment_id", "proposed_assessment_id", "review_binding", "exact_revisions", "conditional_roles_invoked", "evidence_receipt_ids", "requested_claim_status", "requested_maturity", "justification"],
      "properties": {
        "transition_kind": {"$ref": "#/$defs/transitionKind"},
        "requested_by": {"const": "author"},
        "author_identity": {"type": "string", "pattern": "^synthetic:actor:[a-z0-9_-]+$"},
        "source_assessment_id": {"$ref": "#/$defs/recordRef"},
        "proposed_assessment_id": {"$ref": "#/$defs/recordRef"},
        "review_binding": {"$ref": "#/$defs/reviewBinding"},
        "exact_revisions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/revisionBinding"},
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {"component": {"const": "proposed_aggregate"}},
                "required": ["component"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {"component": {"const": "governance_schema"}},
                "required": ["component"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {"component": {"const": "dependency_lock"}},
                "required": ["component"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "conditional_roles_invoked": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/conditionalReviewerRole"}
        },
        "evidence_receipt_ids": {"type": "array", "items": {"$ref": "#/$defs/recordRef"}},
        "requested_claim_status": {"$ref": "#/$defs/claimStatus"},
        "requested_maturity": {"$ref": "#/$defs/maturity"},
        "justification": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actor_id", "relationship_to_author", "contributed_to_subject", "conflict_disclosed", "conflict_description", "eligible"],
      "properties": {
        "role": {"$ref": "#/$defs/internalRole"},
        "actor_id": {"type": "string", "pattern": "^synthetic:actor:[a-z0-9_-]+$"},
        "relationship_to_author": {"enum": ["same_person", "same_team", "different_team", "external"]},
        "contributed_to_subject": {"type": "boolean"},
        "conflict_disclosed": {"type": "boolean"},
        "conflict_description": {"type": ["string", "null"], "minLength": 1},
        "eligible": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actor_id", "review_binding", "decision", "rationale", "evidence_receipt_ids", "decided_at"],
      "properties": {
        "role": {"$ref": "#/$defs/internalRole"},
        "actor_id": {"type": "string", "pattern": "^synthetic:actor:[a-z0-9_-]+$"},
        "review_binding": {"$ref": "#/$defs/reviewBinding"},
        "decision": {"enum": ["approve", "reject", "recuse", "waive_not_required", "blocked"]},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_receipt_ids": {"type": "array", "items": {"$ref": "#/$defs/recordRef"}},
        "decided_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "checker", "result", "receipt_id", "rationale"],
      "properties": {
        "check": {"enum": ["schema", "identity", "revision_binding", "evidence_profile", "accounting", "authorization", "staleness", "conflicts", "history", "required_roles"]},
        "checker": {"enum": ["machine", "reviewer"]},
        "result": {"enum": ["pass", "fail", "not_required"]},
        "receipt_id": {"type": ["string", "null"], "pattern": "^(gov|synthetic)\\.[a-z0-9][a-z0-9._-]+$"},
        "rationale": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_kind", "detected_at", "evidence_receipt_id", "description"],
      "properties": {
        "event_kind": {"enum": ["evidence_retracted", "evidence_stale", "identity_revision_changed", "gate_refuted", "correction_required", "external_replication_received"]},
        "detected_at": {"$ref": "#/$defs/timestamp"},
        "evidence_receipt_id": {"$ref": "#/$defs/recordRef"},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "replacement_id", "reason", "prior_record_digest", "replacement_digest", "prior_record_preserved", "destructive_rewrite"],
      "properties": {
        "supersedes": {"$ref": "#/$defs/recordRef"},
        "replacement_id": {"$ref": "#/$defs/recordRef"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "prior_record_digest": {"$ref": "#/$defs/digest"},
        "replacement_digest": {"$ref": "#/$defs/digest"},
        "prior_record_preserved": {"const": true},
        "destructive_rewrite": {"const": false}
      }
    },
    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staleness_class", "trigger", "last_checked_at", "recheck_due_at", "gate_fresh", "contiguous_maturity_recomputed"],
      "properties": {
        "staleness_class": {"enum": ["revision_bound", "time_bound", "event_bound"]},
        "trigger": {"$ref": "#/$defs/nonEmptyString"},
        "last_checked_at": {"$ref": "#/$defs/timestamp"},
        "recheck_due_at": {"$ref": "#/$defs/timestamp"},
        "gate_fresh": {"const": false},
        "contiguous_maturity_recomputed": {"const": true}
      }
    },
    "externalReplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_entry_id", "replicator_id", "organization_id", "independence_level", "artifact_digest", "result", "scope", "failed_attempts_retained", "auto_promotion"],
      "properties": {
        "registry_entry_id": {"$ref": "#/$defs/recordRef"},
        "replicator_id": {"type": "string", "pattern": "^synthetic:actor:[a-z0-9_-]+$"},
        "organization_id": {"type": "string", "pattern": "^synthetic:organization:[a-z0-9_-]+$"},
        "independence_level": {"const": "R5_external_public_replication"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "result": {"enum": ["replicated", "not_replicated", "inconclusive"]},
        "scope": {"$ref": "#/$defs/nonEmptyString"},
        "failed_attempts_retained": {"const": true},
        "auto_promotion": {"const": false}
      }
    },
    "historySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_record_ids", "prior_record_digests", "append_only", "records_deleted", "records_rewritten"],
      "properties": {
        "prior_record_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}},
        "prior_record_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "append_only": {"const": true},
        "records_deleted": {"const": false},
        "records_rewritten": {"const": false}
      }
    },
    "identityChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_not_reviewer", "required_roles_distinct", "release_approver_not_author", "conflicts_clear", "every_decision_matches_requested_aggregate", "every_decision_matches_governance_schema", "every_decision_matches_dependency_revision", "no_self_promotion_effect", "draft_cannot_promote"],
      "properties": {
        "author_not_reviewer": {"type": "boolean"},
        "required_roles_distinct": {"type": "boolean"},
        "release_approver_not_author": {"type": "boolean"},
        "conflicts_clear": {"type": "boolean"},
        "every_decision_matches_requested_aggregate": {"const": true},
        "every_decision_matches_governance_schema": {"const": true},
        "every_decision_matches_dependency_revision": {"const": true},
