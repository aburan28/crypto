        "history_effect": {"enum": ["none", "would_append_assessment", "would_append_supersession", "would_append_replication_entry"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "workflowFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_version",
        "scenario_kind",
        "synthetic_scope",
        "subject",
        "request",
        "assignments",
        "decisions",
        "preflight_checks",
        "history_snapshot",
        "identity_checks",
        "expected_outcome",
