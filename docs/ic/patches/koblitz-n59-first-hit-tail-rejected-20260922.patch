@@ -7674,6 +7674,10 @@ pub fn probe_scalar(seed: u64, trial: u64, r_u64: u64) -> u64 {
 /// length while the run stays short enough to keep the trial range
 /// worth parallelising.
 const PROBE_RUN: u64 = 64;
+/// Deterministic parallel granularity for a first-hit forced-point tail.
+/// A batch spans 2,048 probes, enough runs to occupy the default pool while
+/// bounding work after the earliest hit to fewer than 2,048 probes.
+const FIRST_HIT_RUN_BATCH: u64 = 32;
 
 /// The step a walked run takes between consecutive trials, fixed by the
 /// seed so the sequence is reproducible.
@@ -8028,6 +8032,100 @@ impl<'a> RelationCollector<'a> {
         };
         Some((relations, report))
     }
+
+    /// Collect the first exact three-summand relation containing
+    /// `fixed_point_index`, or exhaust the requested probe interval.
+    ///
+    /// Raw column coverage needs one nonzero row, so continuing after
+    /// the first verified pair-table hit only spends lookups.  The walk
+    /// and relation are identical to [`Self::collect_with_forced_point`].
+    /// Fixed batches of probe runs preserve deterministic accounting while
+    /// retaining parallel pair-table queries; the earliest hit in the first
+    /// successful batch is returned.
+    pub fn collect_first_with_forced_point(
+        &self,
+        unit: RelationWorkUnit,
+        fixed_point_index: usize,
+    ) -> Option<(Vec<CollectedRelation>, TargetedCollectionReport)> {
+        if self.opts.m != 3
+            || self.opts.strategy != DecompositionStrategy::PairTable
+            || fixed_point_index >= self.fb.points.len()
+        {
+            return None;
+        }
+        let (fc, g_fast) = self.fast.as_ref()?;
+        let pair = self.pair_table()?;
+        let begin = std::time::Instant::now();
+        let end = unit.start.saturating_add(unit.count);
+        if end == unit.start {
+            return Some((Vec::new(), TargetedCollectionReport::default()));
+        }
+        let fixed_negated = fc.neg(fc.lift(&self.fb.points[fixed_point_index]));
+        let stride = probe_run_stride(unit.seed, self.r_u64);
+        let stride_point = fc.mul_u64(*g_fast, stride);
+        let first_run = unit.start / PROBE_RUN;
+        let last_run = end.saturating_sub(1) / PROBE_RUN;
+        let mut trials = 0usize;
+        let mut pair_lookups = 0u64;
+        let mut batch_start = first_run;
+        while batch_start <= last_run {
+            let batch_end = (batch_start + FIRST_HIT_RUN_BATCH).min(last_run + 1);
+            let scanned: Vec<(usize, u64, Vec<CollectedRelation>)> =
+                (batch_start..batch_end)
+                    .into_par_iter()
+                    .map(|run| {
+                        let run_start = (run * PROBE_RUN).max(unit.start);
+                        let run_end = ((run + 1) * PROBE_RUN).min(end);
+                        let mut a = walked_probe_scalar(unit.seed, run_start, self.r_u64);
+                        let mut point = fc.mul_u64(*g_fast, a);
+                        let mut lookups = 0u64;
+                        let mut found = Vec::new();
+                        for trial in run_start..run_end {
+                            if !point.infinity && a != 0 {
+                                lookups += 1;
+                                let rest = fc.add(point, fixed_negated);
+                                if let Some(mut points) = pair.decompose_fast(rest, 2) {
+                                    points.push(fixed_point_index);
+                                    points.sort_unstable();
+                                    found.push(CollectedRelation { trial, a, points });
+                                }
+                            }
+                            a = ((a as u128 + stride as u128) % self.r_u64.max(2) as u128) as u64;
+                            point = fc.add(point, stride_point);
+                        }
+                        ((run_end - run_start) as usize, lookups, found)
+                    })
+                    .collect();
+            let mut found = Vec::new();
+            for (batch_trials, batch_lookups, relations) in scanned {
+                trials += batch_trials;
+                pair_lookups += batch_lookups;
+                found.extend(relations);
+            }
+            found.sort_by_key(|relation| relation.trial);
+            if let Some(relation) = found.into_iter().next() {
+                return Some((
+                    vec![relation],
+                    TargetedCollectionReport {
+                        trials,
+                        relations: 1,
+                        pair_lookups,
+                        elapsed_seconds: begin.elapsed().as_secs_f64(),
+                    },
+                ));
+            }
+            batch_start = batch_end;
+        }
+        Some((
+            Vec::new(),
+            TargetedCollectionReport {
+                trials,
+                relations: 0,
+                pair_lookups,
+                elapsed_seconds: begin.elapsed().as_secs_f64(),
+            },
+        ))
+    }
 }
 
