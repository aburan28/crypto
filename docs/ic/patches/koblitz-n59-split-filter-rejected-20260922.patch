+/// the second position from its retained filter bits also works for folded
+/// builders whose cached token intentionally keeps only those bits.
+#[inline]
+fn pair_filter_positions(hash: u64, mask: u64) -> (usize, usize) {
+    let bits = mask.count_ones();
+    debug_assert!(bits >= 2);
+    let half_bits = bits - 1;
+    let half = 1u64 << half_bits;
+    let half_mask = half - 1;
+    let retained = hash & mask;
+    let first = retained & half_mask;
+    let second = half | (pair_filter_hash(retained) & half_mask);
+    (first as usize, second as usize)
+}
