{
 "schema_version": 1,
 "operation": "koblitz_index_calculus_scaling_series",
 "date": "2026-09-11",
 "what_this_is": "Three same-binary, same-host series of the ic workflow at four Koblitz rungs, each with 32 synthetic known-answer targets and the in-process signed-Frobenius rho baseline. Reported so the rho side can be audited: every ratio here rests on a baseline that recovered all 32 logarithms at every rung. Series c was run on an idle host specifically to check the other two for load.",
 "what_this_is_not": [
  "Not an independent replay: all three series ran from the same build on the same host, so they bound run-to-run noise and measurement load, not implementation error.",
  "Not a crossover claim. No rung crosses, and a charged ratio near 1 would still need the ledger's 20% margin, its autolab flow and a second author.",
  "Not single-instance: the descent reuses a logarithm database the same process built.",
  "Not a statement about deployed curves: these subgroups are 21 to 40 bits."
 ],
 "claim_boundary": "synthetic_known_answer",
 "timing_class": {
  "charged": "per-target descent wall against the rho walk on the same target, same process",
  "amortised": "select + collect + logs wall divided over the targets, plus the descent"
 },
 "automorphism_discount": {
  "family": "signed Frobenius classes, A = 2n",
  "applies_to": "rho baseline"
 },
 "rho_baseline": {
  "method": "distinguished points with a recent-point cache; fruitless cycles escaped by doubling the cycle's smallest state",
  "parallel_walks": "32, scaled down to the instance; one batched field inversion per round",
  "expected_steps": "sqrt(pi*r/2) / sqrt(2n)",
  "measured_against_expected": "within about 1.2x at every rung"
 },
