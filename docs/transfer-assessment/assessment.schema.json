{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto/docs/transfer-assessment/assessment.schema.json",
  "title": "ECDLP correspondence assessment v3",
  "type": "object",
  "required": [
    "format", "case_id", "source", "destination", "transformation",
    "typed_path", "algebraic_screen", "obligations", "solver_assessment",
    "cost_comparison", "advantage_measurement", "sources", "open_obligations",
    "verdicts", "official_status_change"
  ],
  "properties": {
    "format": {"const": "correspondence-assessment-v3"},
    "case_id": {"type": "string", "minLength": 1},
    "authority": {"type": "string"},
    "source": {"type": "object"},
    "destination": {"type": "object"},
    "transformation": {"type": "object"},
    "typed_path": {"type": "object"},
    "algebraic_screen": {"$ref": "#/$defs/screens"},
    "obligations": {"$ref": "#/$defs/obligations"},
    "solver_assessment": {"$ref": "#/$defs/solver_assessment"},
    "cost_comparison": {
      "type": "object",
      "required": ["accounting_complete", "modeled_or_measured"],
      "properties": {
        "accounting_complete": {"$ref": "#/$defs/state"},
        "modeled_or_measured": {"enum": ["unmeasured", "modeled", "measured"]}
      }
    },
    "advantage_measurement": {"$ref": "#/$defs/advantage_measurement"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "uri", "revision"]}
    },
    "open_obligations": {"type": "array", "items": {"type": "string"}},
    "verdicts": {
      "type": "object",
      "required": [
        "valid_transfer", "algorithmically_relevant", "modeled_advantage",
        "measured_advantage", "novel_reduction_within_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "valid_transfer": {"$ref": "#/$defs/state"},
        "algorithmically_relevant": {"$ref": "#/$defs/state"},
        "modeled_advantage": {"$ref": "#/$defs/state"},
        "measured_advantage": {"$ref": "#/$defs/state"},
        "novel_reduction_within_boundary": {"$ref": "#/$defs/state"}
      }
    },
    "official_status_change": {"const": "none"}
  },
  "$defs": {
    "state": {"enum": ["unknown", "supported", "refuted", "not_applicable"]},
    "state_record": {
      "type": "object",
      "required": ["state", "evidence", "scope"],
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "string"}
      }
    },
    "screens": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dimension", "group_order", "frobenius_or_weil_polynomial",
        "field_of_definition", "riemann_hurwitz_or_different",
        "polarization_or_jacobian_locus"
      ],
      "properties": {
        "dimension": {"$ref": "#/$defs/state_record"},
        "group_order": {"$ref": "#/$defs/state_record"},
        "frobenius_or_weil_polynomial": {"$ref": "#/$defs/state_record"},
        "field_of_definition": {"$ref": "#/$defs/state_record"},
        "riemann_hurwitz_or_different": {"$ref": "#/$defs/state_record"},
        "polarization_or_jacobian_locus": {"$ref": "#/$defs/state_record"}
      }
    },
    "obligations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "existence", "explicit_construction", "map_correctness",
        "subgroup_preservation", "scalar_recovery",
        "destination_solver_applicability", "computational_advantage",
        "scaling_support", "novelty_within_boundary"
      ],
      "properties": {
        "existence": {"$ref": "#/$defs/state_record"},
        "explicit_construction": {"$ref": "#/$defs/state_record"},
        "map_correctness": {"$ref": "#/$defs/state_record"},
        "subgroup_preservation": {"$ref": "#/$defs/state_record"},
        "scalar_recovery": {"$ref": "#/$defs/state_record"},
        "destination_solver_applicability": {"$ref": "#/$defs/state_record"},
        "computational_advantage": {"$ref": "#/$defs/state_record"},
        "scaling_support": {"$ref": "#/$defs/state_record"},
        "novelty_within_boundary": {"$ref": "#/$defs/state_record"}
      }
    },
    "solver_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "family", "implementation", "applicability",
        "image_subgroup_access", "relation_or_search_compatibility",
        "individual_log_and_recovery"
      ],
      "properties": {
        "name": {"type": ["string", "null"]},
        "family": {
          "enum": [
            "none", "generic_group", "index_calculus", "weil_descent",
            "pairing_transfer", "lattice_or_linear_algebra", "other"
          ]
        },
        "implementation": {"type": ["string", "null"]},
        "applicability": {"$ref": "#/$defs/state_record"},
        "image_subgroup_access": {"$ref": "#/$defs/state_record"},
        "relation_or_search_compatibility": {"$ref": "#/$defs/state_record"},
        "individual_log_and_recovery": {"$ref": "#/$defs/state_record"}
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_search", "construction", "forward_map", "solver_setup",
        "relation_or_walk", "linear_algebra", "individual_log_or_descent",
        "source_recovery", "verification"
      ],
      "properties": {
        "route_search": {"type": "number", "minimum": 0},
        "construction": {"type": "number", "minimum": 0},
        "forward_map": {"type": "number", "minimum": 0},
        "solver_setup": {"type": "number", "minimum": 0},
        "relation_or_walk": {"type": "number", "minimum": 0},
        "linear_algebra": {"type": "number", "minimum": 0},
        "individual_log_or_descent": {"type": "number", "minimum": 0},
        "source_recovery": {"type": "number", "minimum": 0},
        "verification": {"type": "number", "minimum": 0}
      }
    },
    "cost_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "total", "phases", "correctness", "evidence"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "status": {"enum": ["modeled", "measured"]},
        "total": {"type": "number", "exclusiveMinimum": 0},
        "phases": {"$ref": "#/$defs/phases"},
        "correctness": {"$ref": "#/$defs/state"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "advantage_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_scope", "basis", "unit", "target_count", "source_reference",
        "destination_generic_control", "destination_candidate", "net_speedup",
        "net_speedup_ci95", "verified_pairs", "scaling_sizes",
        "replay_receipts", "unpriced_work", "resource_envelope", "evidence"
      ],
      "properties": {
        "claim_scope": {"enum": ["unmeasured", "stage_only", "cold_end_to_end", "amortized"]},
        "basis": {"enum": ["unmeasured", "modeled", "measured"]},
        "unit": {"type": ["string", "null"]},
        "target_count": {"type": "integer", "minimum": 1},
        "source_reference": {"anyOf": [{"$ref": "#/$defs/cost_arm"}, {"type": "null"}]},
        "destination_generic_control": {"anyOf": [{"$ref": "#/$defs/cost_arm"}, {"type": "null"}]},
        "destination_candidate": {"anyOf": [{"$ref": "#/$defs/cost_arm"}, {"type": "null"}]},
        "net_speedup": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "net_speedup_ci95": {
          "anyOf": [
            {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "minItems": 2, "maxItems": 2},
            {"type": "null"}
          ]
        },
        "verified_pairs": {"type": "integer", "minimum": 0},
        "scaling_sizes": {"type": "integer", "minimum": 0},
        "replay_receipts": {"type": "array", "items": {"type": "string"}},
        "unpriced_work": {"type": "array", "items": {"type": "string"}},
        "resource_envelope": {"type": ["object", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
