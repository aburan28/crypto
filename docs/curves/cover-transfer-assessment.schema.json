{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto/blob/main/docs/curves/cover-transfer-assessment.schema.json",
  "title": "Curve-cover transfer assessment sidecar",
  "description": "Hash-pinned assessments of exact curve-cover maps and exact EC1 subgroups. Geometry, induced maps, subgroup preservation, and computational advantage are separate claims. Schema validity is structural only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status_vocabulary",
    "assessment_date",
    "catalog_commit",
    "source_artifacts",
    "coverage",
    "map_assessments",
    "subgroup_assessments",
    "global_cost_accounting",
    "controls",
    "exploration_boundary",
    "open_obligations",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": "cover-transfer-assessments/v1"
    },
    "status_vocabulary": {
      "const": [
        "unknown",
        "supported",
        "refuted",
        "not_applicable"
      ]
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "catalog_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactPin"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "map_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapAssessment"
      }
    },
    "subgroup_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subgroupAssessment"
      }
    },
    "global_cost_accounting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cost"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "exploration_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "unknown"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown",
        "pdf",
        "graph_source",
        "graph_svg",
        "graph_png",
        "release_receipt"
      ],
      "properties": {
        "markdown": {
          "$ref": "#/$defs/path"
        },
        "pdf": {
          "$ref": "#/$defs/path"
        },
        "graph_source": {
          "$ref": "#/$defs/path"
        },
        "graph_svg": {
          "$ref": "#/$defs/path"
        },
        "graph_png": {
          "$ref": "#/$defs/path"
        },
        "release_receipt": {
          "$ref": "#/$defs/path"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)(?!.*//)(docs|research|src|tests)/[A-Za-z0-9._/-]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "status": {
      "enum": [
        "unknown",
        "supported",
        "refuted",
        "not_applicable"
      ]
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "refuted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role",
        "freshness"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_maps",
        "unique_cover_models",
        "geometry_verified_maps",
        "ec1_representations",
        "cover_rows_subgroup_not_tested",
        "ec1_subgroups_not_tested",
        "assessed_maps",
        "unassessed_maps",
        "assessed_subgroups",
        "scope_note"
      ],
      "properties": {
        "catalog_maps": {
          "type": "integer",
          "minimum": 0
        },
        "unique_cover_models": {
          "type": "integer",
          "minimum": 0
        },
        "geometry_verified_maps": {
          "type": "integer",
          "minimum": 0
        },
        "ec1_representations": {
          "type": "integer",
          "minimum": 0
        },
        "cover_rows_subgroup_not_tested": {
          "type": "integer",
          "minimum": 0
        },
        "ec1_subgroups_not_tested": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_maps": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed_maps": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_subgroups": {
          "type": "integer",
          "minimum": 0
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "field",
        "dimension_or_genus",
        "representation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "elliptic_curve",
            "hyperelliptic_curve",
            "jacobian",
            "picard_group",
            "subgroup"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "dimension_or_genus": {
          "type": "integer",
          "minimum": 1
        },
        "representation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mapAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "icv1_slug",
        "model_sha256",
        "cover_uid",
        "map_uid",
        "construction",
        "degree",
        "field_relationship",
        "typed_objects",
        "claims",
        "full_transfer_pipeline",
        "boundary"
      ],
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/id"
        },
        "icv1_slug": {
          "type": "string",
          "pattern": "^icv1-[a-z0-9-]+$"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cover_uid": {
          "type": "string",
          "pattern": "^urn:hc-model:1:sha256:[0-9a-f]{64}$"
        },
        "map_uid": {
          "type": "string",
          "pattern": "^urn:curve-cover-map:1:sha256:[0-9a-f]{64}$"
        },
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "degree": {
          "type": "integer",
          "minimum": 1
        },
        "field_relationship": {
          "enum": [
            "same_field",
            "extension",
            "restriction_of_scalars"
          ]
        },
        "typed_objects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/typedObject"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "assessment"
            ],
            "properties": {
              "claim": {
                "$ref": "#/$defs/id"
              },
              "assessment": {
                "$ref": "#/$defs/assessment"
              }
            }
          }
        },
        "full_transfer_pipeline": {
          "$ref": "#/$defs/assessment"
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subgroupAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "map_uid",
        "ec1",
        "curve_uid",
        "subgroup_order",
        "generator",
        "claims",
        "boundary"
      ],
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/id"
        },
        "map_uid": {
          "type": "string",
          "pattern": "^urn:curve-cover-map:1:sha256:[0-9a-f]{64}$"
        },
        "ec1": {
          "type": "string",
          "pattern": "^EC1.+$"
        },
        "curve_uid": {
          "type": "string",
          "pattern": "^urn:ec-record:1:sha256:[0-9a-f]{64}$"
        },
        "subgroup_order": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "generator": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "assessment"
            ],
            "properties": {
              "claim": {
                "$ref": "#/$defs/id"
              },
              "assessment": {
                "$ref": "#/$defs/assessment"
              }
            }
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "value",
        "unit",
        "source_refs",
        "note"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "measured",
            "modeled",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "assessment",
        "command"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/id"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
