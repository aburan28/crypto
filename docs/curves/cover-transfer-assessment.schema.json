{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto/blob/main/docs/curves/cover-transfer-assessment.schema.json",
  "title": "Curve-cover transfer assessment ledger",
  "description": "Hash-pinned assessments of every exact curve-cover map and linked EC1 subgroup. Profiles and result templates compress repeated claims; memberships bind those claims to exact content-addressed identities, while typed bindings link each target, cover, declared field, Jacobian context, and map without implying arithmetic support. Schema validity is structural only, so the repository verifier must also check references, counts, content digests, coverage, and effective claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status_vocabulary",
    "assessment_date",
    "catalog_commit",
    "source_artifacts",
    "claim_contract",
    "result_templates",
    "profiles",
    "memberships",
    "typed_bindings",
    "exact_overlays",
    "coverage",
    "global_cost_accounting",
    "controls",
    "exploration_boundary",
    "open_obligations",
    "report",
    "migration"
  ],
  "properties": {
    "schema_version": {
      "const": "cover-transfer-assessments/v2"
    },
    "status_vocabulary": {
      "const": [
        "unknown",
        "supported",
        "refuted",
        "not_applicable"
      ]
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "catalog_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactPin"
      }
    },
    "claim_contract": {
      "$ref": "#/$defs/claimContract"
    },
    "result_templates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resultTemplate"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "memberships": {
      "$ref": "#/$defs/memberships"
    },
    "typed_bindings": {
      "$ref": "#/$defs/typedBindings"
    },
    "exact_overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exactOverlay"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "global_cost_accounting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cost"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "exploration_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "open_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/openObligation"
      }
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "status": {
      "enum": [
        "unknown",
        "supported",
        "refuted",
        "not_applicable"
      ]
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "mapUid": {
      "type": "string",
      "pattern": "^urn:curve-cover-map:1:sha256:[0-9a-f]{64}$"
    },
    "coverUid": {
      "type": "string",
      "pattern": "^urn:hc-model:1:sha256:[0-9a-f]{64}$"
    },
    "declaredFieldUid": {
      "type": "string",
      "pattern": "^urn:declared-field:1:sha256:[0-9a-f]{64}$"
    },
    "jacobianContextUid": {
      "type": "string",
      "pattern": "^urn:jacobian-context:1:sha256:[0-9a-f]{64}$"
    },
    "modelSha256": {
      "$ref": "#/$defs/sha256"
    },
    "icv1Slug": {
      "type": "string",
      "pattern": "^icv1-[a-z0-9-]+-[0-9a-f]{8}$"
    },
    "curveUid": {
      "type": "string",
      "pattern": "^urn:ec-record:1:sha256:[0-9a-f]{64}$"
    },
    "ec1": {
      "type": "string",
      "pattern": "^EC1(?:N[0-9]+|P[0-9]+|Q[0-9]+D[0-9]+)C[a-z][a-z0-9]*h[0-9a-f]{12,64}$"
    },
    "subgroupTriple": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/ec1"
        },
        {
          "$ref": "#/$defs/curveUid"
        },
        {
          "$ref": "#/$defs/mapUid"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "resultTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "scope": {
          "$ref": "#/$defs/nonemptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "obligation_id": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "obligation_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "refuted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "obligation_id"
              ]
            }
          }
        }
      ]
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role",
        "freshness"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "$ref": "#/$defs/nonemptyString"
        },
        "freshness": {
          "$ref": "#/$defs/resultTemplate"
        }
      }
    },
    "claimContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map",
        "subgroup"
      ],
      "properties": {
        "map": {
          "$ref": "#/$defs/claimDescriptions"
        },
        "subgroup": {
          "$ref": "#/$defs/claimDescriptions"
        }
      }
    },
    "claimDescriptions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "claimTemplateBindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate_id",
        "hypotheses",
        "claims",
        "boundary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "map_base",
            "subgroup_base"
          ]
        },
        "predicate_id": {
          "$ref": "#/$defs/id"
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "uniqueItems": true
        },
        "claims": {
          "$ref": "#/$defs/claimTemplateBindings"
        },
        "full_transfer_pipeline": {
          "$ref": "#/$defs/id"
        },
        "boundary": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "memberships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_base",
        "subgroup_base"
      ],
      "properties": {
        "map_base": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapMembershipGroup"
          }
        },
        "subgroup_base": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subgroupMembershipGroup"
          }
        }
      }
    },
    "typedBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "jacobians",
        "maps"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/declaredFieldUid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/declaredFieldBinding"
          }
        },
        "jacobians": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/jacobianContextUid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jacobianContextBinding"
          }
        },
        "maps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/mapUid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/typedMapBinding"
          }
        }
      }
    },
    "declaredFieldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_uid",
        "record",
        "characteristic",
        "extension_degree",
        "representation"
      ],
      "properties": {
        "field_uid": {
          "$ref": "#/$defs/declaredFieldUid"
        },
        "record": {
          "$ref": "#/$defs/declaredFieldRecord"
        },
        "characteristic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "extension_degree": {
          "type": "integer",
          "minimum": 1
        },
        "representation": {
          "enum": [
            "prime",
            "odd_polynomial_extension",
            "binary_polynomial_extension"
          ]
        }
      }
    },
    "declaredFieldRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "p"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^fp-[1-9][0-9]*$"
            },
            "p": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "p",
            "modulus"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^fpk-[1-9][0-9]*-[1-9][0-9]*-[0-9a-f]{8}$"
            },
            "p": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "modulus": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "modulus"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^f2m-[1-9][0-9]*-[0-9a-f]{8}$"
            },
            "modulus": {
              "type": "string",
              "pattern": "^0x[0-9a-f]+$"
            }
          }
        }
      ]
    },
    "jacobianContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jacobian_uid",
        "record"
      ],
      "properties": {
        "jacobian_uid": {
          "$ref": "#/$defs/jacobianContextUid"
        },
        "record": {
          "$ref": "#/$defs/jacobianContextRecord"
        }
      }
    },
    "jacobianContextRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_cover_uid",
        "declared_field_uid",
        "dimension",
        "object",
        "infinity_configuration"
      ],
      "properties": {
        "schema_version": {
          "const": "jacobian-context/v1"
        },
        "source_cover_uid": {
          "$ref": "#/$defs/coverUid"
        },
        "declared_field_uid": {
          "$ref": "#/$defs/declaredFieldUid"
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "object": {
          "const": "Picard_degree_zero"
        },
        "infinity_configuration": {
          "enum": [
            "one_rational_point",
            "two_rational_points"
          ]
        }
      }
    },
    "typedMapBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_uid",
        "target_icv1_slug",
        "target_model_sha256",
        "source_cover_uid",
        "source_jacobian_uid",
        "field_relationship"
      ],
      "properties": {
        "map_uid": {
          "$ref": "#/$defs/mapUid"
        },
        "target_icv1_slug": {
          "$ref": "#/$defs/icv1Slug"
        },
        "target_model_sha256": {
          "$ref": "#/$defs/modelSha256"
        },
        "source_cover_uid": {
          "$ref": "#/$defs/coverUid"
        },
        "source_jacobian_uid": {
          "$ref": "#/$defs/jacobianContextUid"
        },
        "field_relationship": {
          "$ref": "#/$defs/sameFieldRelationship"
        }
      }
    },
    "sameFieldRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_field_uid",
        "target_field_uid",
        "degree"
      ],
      "properties": {
        "kind": {
          "const": "same_declared_field_identity"
        },
        "source_field_uid": {
          "$ref": "#/$defs/declaredFieldUid"
        },
        "target_field_uid": {
          "$ref": "#/$defs/declaredFieldUid"
        },
        "degree": {
          "const": 1
        }
      }
    },
    "mapMembershipGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "count",
        "members_sha256",
        "members"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "members_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapUid"
          },
          "uniqueItems": true
        }
      }
    },
    "subgroupMembershipGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "count",
        "members_sha256",
        "members"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "members_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subgroupTriple"
          },
          "uniqueItems": true
        }
      }
    },
    "exactOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_id",
        "kind",
        "target",
        "claim_overrides",
        "evidence_additions",
        "boundary"
      ],
      "properties": {
        "overlay_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "map",
            "subgroup"
          ]
        },
        "target": {},
        "claim_overrides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence_additions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "boundary": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "map"
            },
            "target": {
              "$ref": "#/$defs/mapUid"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "subgroup"
            },
            "target": {
              "$ref": "#/$defs/subgroupTriple"
            }
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "claim_overrides": {
              "minProperties": 1
            }
          }
        },
        {
          "properties": {
            "evidence_additions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_maps",
        "unique_cover_models",
        "geometry_verified_maps",
        "ec1_representations",
        "assessed_maps",
        "unassessed_maps",
        "assessed_subgroups",
        "unassessed_subgroups",
        "map_membership_entries",
        "subgroup_membership_entries",
        "map_profiles",
        "subgroup_profiles",
        "scope_note"
      ],
      "properties": {
        "catalog_maps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unique_cover_models": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "geometry_verified_maps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "ec1_representations": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "assessed_maps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unassessed_maps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "assessed_subgroups": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unassessed_subgroups": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "map_membership_entries": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "subgroup_membership_entries": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "map_profiles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "subgroup_profiles": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "scope_note": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "value",
        "unit",
        "source_refs",
        "note"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "measured",
            "modeled",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "measured",
                  "modeled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "$ref": "#/$defs/nonemptyString"
              },
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "assessment",
        "command"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/id"
        },
        "assessment": {
          "$ref": "#/$defs/resultTemplate"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "openObligation": {
      "type": "object",
