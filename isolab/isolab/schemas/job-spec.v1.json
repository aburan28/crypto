{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isolab.job/v1",
  "title": "isolab job spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command"
  ],
  "properties": {
    "schema": {
      "const": "isolab.job/v1"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "pool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$",
      "default": "default"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "podman",
            "docker",
            "direct"
          ]
        },
        "oci_runtime": {
          "enum": [
            "auto",
            "crun",
            "runc",
            "runsc"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "network": {
          "enum": [
            "none",
            "host",
            "bridge"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0?[0-7]{3}$"
          },
          "content": {
            "type": "string",
            "maxLength": 4194304
          },
          "encoding": {
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "local_file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "git": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "commit"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sparse_paths": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_s": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "stdin": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "repeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cooldown_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "drop_caches": {
          "type": "boolean"
        },
        "sample_period_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "perf_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 24
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "memory_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 16
        },
        "numa_node": {
          "oneOf": [
            {
              "enum": [
                "single",
                "any"
              ]
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "smt": {
          "enum": [
            "isolate",
            "allow",
            "off"
          ]
        },
        "gpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        },
        "scratch_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "strict",
            "standard",
            "best_effort"
          ]
        },
        "settle_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "max_psi_some_avg10": {
          "type": "number",
          "minimum": 0
        },
        "max_other_cpu": {
          "type": "number",
          "minimum": 0
        },
        "max_job_cpu_steal_pct": {
          "type": "number",
          "minimum": 0
        },
        "governor": {
          "enum": [
            "performance",
            "any"
          ]
        },
        "turbo": {
          "enum": [
            "off",
            "any"
          ]
        },
        "aslr": {
          "enum": [
            "off",
            "any"
          ]
        },
        "require": {
          "type": "array",
          "items": {
            "enum": [
              "perf_counters",
              "cpu_partition",
              "numa_bind",
              "irq_moved",
              "evicted",
              "bare_metal",
              "frequency_pinned",
              "thp_never",
              "smt_off",
              "no_steal"
            ]
          },
          "uniqueItems": true
        },
        "min_isolation_tier": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            null
          ]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_kernel": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
        },
        "require_images": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "build_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_log_bytes": {
          "type": "integer",
          "minimum": 4096
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_artifact_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verify": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "builtin": {
              "enum": [
                "taskq-certificate"
              ]
            },
            "certificate_file": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "argv"
              ]
            },
            {
              "required": [
                "builtin"
              ]
            }
          ]
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 64
    }
  }
}
