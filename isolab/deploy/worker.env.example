ISOLAB_URL=nats://replace-me@127.0.0.1:4222
# cpus the worker may hand to jobs; leave a full core per NUMA node outside it
ISOLAB_CPUS=4-15
# extra flags, e.g. --pool default --pool gpu --label site=home --default-image localhost/isolab-base:latest --oci-runtime crun
ISOLAB_WORKER_EXTRA=--pool default --default-image localhost/isolab-base:latest
