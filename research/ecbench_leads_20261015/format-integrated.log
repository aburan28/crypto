+        self.redc(x as u128)
+    }
+    fn sm(&self, c: i64) -> u64 {
+        if (-16..=16).contains(&c) {
+            self.small[(c + 16) as usize]
+        } else {
+            self.to_m(c.rem_euclid(self.n as i64) as u64)
+        }
+    }
+    fn pow(&self, a: u64, mut e: u64) -> u64 {
+        let mut r = self.small[17];
+        let mut b = a;
+        let mut first = true;
+        while e > 0 {
+            if e & 1 == 1 {
+                if first {
+                    r = b;
+                    first = false;
+                } else {
+                    r = self.mul(r, b);
+                }
+            }
+            e >>= 1;
+            if e > 0 {
+                b = self.mul(b, b);
+            }
+        }
+        r
+    }
+    fn inv(&self, a: u64) -> u64 {
+        assert!(a != 0, "F_ell inverse of zero");
+        self.pow(a, self.n - 2)
+    }
 }
 
