+fn pct(v: &mut Vec<f64>, lo: f64, hi: f64) -> (f64, f64) {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let n = v.len();
+    let i = ((lo * n as f64).floor() as usize).min(n - 1);
+    let j = (((hi * n as f64).ceil() as usize).max(1) - 1).min(n - 1);
+    (v[i], v[j])
+}
 
