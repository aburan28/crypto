allocatemem(200000000);
lines=readstr("research/conductor_gap_cm_orbits_20261015/prepared/pairs.gpvec");
for(i=1,#lines,v=eval(lines[i]); id=v[1];l=v[2];p=v[3];N=v[4];t=p+1-N; if(!isprime(l)||!isprime(p)||!isprime(N),error("prime proof failed"));if(t^2-4*p!=-19*l^2||N^2<=16*p,error("discriminant or Hasse separation failed"));T=ellinit([v[5],v[6]],p);K=[Mod(v[7],p),Mod(v[8],p)];if(!ellisoncurve(T,K)||ellmul(T,K,l)!=[0],error("kernel witness failed"));if(lift(Mod(v[5]*v[9]^2,p))!=v[10]||lift(Mod(v[6]*v[9]^3,p))!=v[11],error("twist model mismatch"));E0=ellinit([v[10],v[11]],p);E1=ellinit([v[14],v[15]],p);G0=[Mod(v[12],p),Mod(v[13],p)];G1=[Mod(v[16],p),Mod(v[17],p)];if(!ellisoncurve(E0,G0)||!ellisoncurve(E1,G1)||ellmul(E0,G0,N)!=[0]||ellmul(E1,G1,N)!=[0],error("endpoint generator witness failed"));if(E0.disc==0||E1.disc==0||lift(E0.j)!=lift(Mod(-884736,p))||E1.j==E0.j,error("endpoint stratum classification failed"));print("{\"pair\":",id,",\"prime_proofs\":true,\"two_hasse_unique_orders\":true,\"prime_kernel_order\":true,\"endpoint_conductors\":[\"1\",\"",l,"\"]}"));
quit;
