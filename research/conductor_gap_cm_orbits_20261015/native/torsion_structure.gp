\\ Compact torsion-module witnesses for the rational-kernel benchmark family.
\\ [case,ell,p,N,q,twist_a,twist_b,Kx,Ky,d,crater_a,crater_b,floor_a,floor_b]
allocatemem(400000000);
cm_path=getenv("CM_TORSION_INPUT");if(type(cm_path)!="t_STR"||#cm_path==0,cm_path="research/conductor_gap_cm_orbits_20261015/prepared/torsion-structure.gpvec");
rows=readstr(cm_path);
ptstr(P)=Str("[\"",lift(P[1]),"\",\"",lift(P[2]),"\"]");
for(i=1,#rows,v=eval(rows[i]);id=v[1];l=v[2];p=v[3];N=v[4];q=v[5];d=v[10];if(!isprime(l)||!isprime(p)||!isprime(N)||!isprime(q)||l==q,error("prime prerequisites failed"));if(p!=q*l^2-l+1||N!=q*l^2-2*l+4||l^4<=16*p||kronecker(d,p)!=-1,error("family/Hasse prerequisites failed"));RT=ellinit([v[6],v[7]],p);FT=ellinit([Mod(v[13]/d^2,p),Mod(v[14]/d^3,p)]);if(lift(Mod(v[6]*d^2,p))!=v[11]||lift(Mod(v[7]*d^3,p))!=v[12],error("twist coordinates mismatch"));K1=[Mod(v[8],p),Mod(v[9],p)];if(!ellisoncurve(RT,K1)||ellmul(RT,K1,l)!=[0],error("first root torsion witness failed"));K2=[0];w=Mod(1,p);for(x=0,1000,rhs=Mod(x,p)^3+v[6]*x+v[7];if(kronecker(lift(rhs),p)==1,K2=ellmul(RT,[Mod(x,p),sqrt(rhs)],q);if(K2!=[0]&&ellmul(RT,K2,l)==[0],w=ellweilpairing(RT,K1,K2,l);if(w!=1,break))));if(K2==[0]||w==1||w^l!=1,error("independent rank-two torsion witnesses failed"));H=[0];HL=[0];for(x=0,1000,rhs=Mod(x,p)^3+FT.a4*x+FT.a6;if(kronecker(lift(rhs),p)==1,H=ellmul(FT,[Mod(x,p),sqrt(rhs)],q);if(H!=[0],HL=ellmul(FT,H,l);if(HL!=[0]&&ellmul(FT,HL,l)==[0],break))));if(H==[0]||HL==[0]||ellmul(FT,HL,l)!=[0],error("floor order-ell-squared witness failed"));print("{\"case\":",id,",\"ell\":\"",l,"\",\"p\":\"",p,"\",\"q\":",q,",\"root_basis\":[",ptstr(K1),",",ptstr(K2),"],\"weil_pairing\":\"",lift(w),"\",\"floor_order_ell_squared_point\":",ptstr(H),",\"floor_ell_multiple\":",ptstr(HL),",\"twist_cardinality_by_hasse_unique_multiple\":\"",q*l^2,"\",\"root_twist_invariant_factors\":[\"",l,"\",\"",q*l,"\"],\"floor_twist_invariant_factors\":[\"1\",\"",q*l^2,"\"],\"derived_rational_degree_ell_kernel_lines\":[\"",l+1,"\",\"1\"],\"original_curve_prime_order\":\"",N,"\",\"status\":\"point-orders-and-pairing-verified; module and kernel-line counts derived\"}"));
quit;
