import Mathlib.Data.Int.GCD
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Tactic.Ring

set_option autoImplicit false

namespace WeakCurveProperties

/-- Exponents in the product of the index-I subgroup and the e-th powers. -/
def twistExponentImage (M I e k : ℤ) : Prop :=
  ∃ a b c : ℤ, k = I*a + e*b + M*c

/-- Bezout proves the complete image criterion, rather than just one direction. -/
theorem twist_exponent_image_iff {M I e k : ℤ} (hIM : I ∣ M) :
    twistExponentImage M I e k ↔ (I.gcd e : ℤ) ∣ k := by
  constructor
  · rintro ⟨a,b,c,hk⟩
    rw [hk]
    exact dvd_add (dvd_add (dvd_mul_of_dvd_left (Int.gcd_dvd_left I e) a)
      (dvd_mul_of_dvd_left (Int.gcd_dvd_right I e) b))
      (dvd_mul_of_dvd_left ((Int.gcd_dvd_left I e).trans hIM) c)
  · rintro ⟨q,hq⟩
    refine ⟨I.gcdA e*q, I.gcdB e*q, 0, ?_⟩
    rw [hq, Int.gcd_eq_gcd_ab]
    ring

/-- When h divides the group order, the quotient exponent tests h-divisibility. -/
theorem quotient_exponent_test {M h : ℕ} (hM : 0 < M) (hh : 0 < h)
    (hdiv : h ∣ M) (k : ℤ) :
    (M : ℤ) ∣ k*(M/h : ℕ) ↔ (h : ℤ) ∣ k := by
  have hq : M/h ≠ 0 := Nat.ne_of_gt (Nat.div_pos (Nat.le_of_dvd hM hdiv) hh)
  have heq : (M : ℤ) = (M/h : ℕ)*(h : ℤ) := by
    exact_mod_cast (Nat.div_mul_cancel hdiv).symm
  rw [heq, mul_comm k]
  exact mul_dvd_mul_iff_left (by exact_mod_cast hq)

/-- A kernel-checked finite cyclic group test for the precise twist image. -/
theorem cyclic_twist_image_test {G : Type*} [CommGroup G] (g : G)
    {M I e : ℕ} (horder : orderOf g = M) (hM : 0 < M)
    (hI : 0 < I) (hIM : I ∣ M) (k : ℤ) :
    twistExponentImage M I e k ↔
      (g^k)^(M / Nat.gcd I e) = 1 := by
  have hpos : 0 < Nat.gcd I e := Nat.gcd_pos_of_pos_left e hI
  have hd : Nat.gcd I e ∣ M := (Nat.gcd_dvd_left I e).trans hIM
  rw [twist_exponent_image_iff (by exact_mod_cast hIM)]
  have hcast : Int.gcd (I : ℤ) (e : ℤ) = Nat.gcd I e := by simp
  rw [hcast]
  rw [← zpow_natCast, ← zpow_mul, ← orderOf_dvd_iff_zpow_eq_one, horder]
  exact (quotient_exponent_test hM hpos hd k).symm

/-- The image subgroup is generated by the gcd-th power; this is the actual
group statement corresponding to the exponent criterion in the report. -/
theorem twist_image_subgroup {G : Type*} [Group G] (g : G) (I e : ℤ) :
    Subgroup.zpowers (g^I) ⊔ Subgroup.zpowers (g^e) =
      Subgroup.zpowers (g^(I.gcd e : ℤ)) :=
  Subgroup.zpowers_zpow_sup g I e

/-- In a finite cyclic group, subgroup membership is exactly a power test. -/
theorem cyclic_subgroup_power_test {G : Type*} [CommGroup G] [Finite G]
    [IsCyclic G] (S : Subgroup G) (x : G) :
    x ∈ S ↔ x^(Nat.card S) = 1 := by
  have heq : S = (powMonoidHom (Nat.card S) : G →* G).ker := by
    apply IsCyclic.subgroup_eq_iff_card_eq.mpr
    rw [IsCyclic.card_powMonoidHom_ker]
    exact (Nat.gcd_eq_right_iff_dvd.mpr S.card_subgroup_dvd_card).symm
  exact Iff.of_eq (congrArg (fun H : Subgroup G => x ∈ H) heq)

/-- The same criterion in terms of subgroup index, the form used by the census. -/
theorem cyclic_subgroup_index_test {G : Type*} [CommGroup G] [Finite G]
    [IsCyclic G] (S : Subgroup G) (x : G) :
    x ∈ S ↔ x^(Nat.card G / S.index) = 1 := by
  have hi : 0 < S.index := Nat.pos_of_ne_zero S.index_ne_zero_of_finite
  have hc : Nat.card G / S.index = Nat.card S := by
    rw [← S.card_mul_index, Nat.mul_div_cancel _ hi]
  rw [hc]
  exact cyclic_subgroup_power_test S x

/-- Actual group membership in the two generated images is the gcd power test. -/
theorem cyclic_twist_membership_test {G : Type*} [CommGroup G] [Finite G]
    (g : G) (hgen : Subgroup.zpowers g = ⊤) {I e : ℕ}
    (hIM : I ∣ Nat.card G) (x : G) :
    x ∈ Subgroup.zpowers (g^(I : ℤ)) ⊔ Subgroup.zpowers (g^(e : ℤ)) ↔
      x^(Nat.card G / Nat.gcd I e) = 1 := by
  let : IsCyclic G := isCyclic_iff_exists_zpowers_eq_top.mpr ⟨g,hgen⟩
  rw [twist_image_subgroup]
  have hd : Nat.gcd I e ∣ Nat.card G := (Nat.gcd_dvd_left I e).trans hIM
  have hi : (Subgroup.zpowers (g^(Int.gcd (I : ℤ) (e : ℤ) : ℤ))).index =
      Nat.gcd I e := by
    rw [Subgroup.index_zpowers_zpow hgen, orderOf_eq_card_of_zpowers_eq_top hgen]
    simp only [Int.gcd_natCast_natCast]
    exact Nat.gcd_eq_left_iff_dvd.mpr hd
  rw [cyclic_subgroup_index_test, hi]

/-- Index of the product with e-th powers for an arbitrary subgroup. -/
theorem cyclic_sup_power_index {G : Type*} [CommGroup G] [Finite G]
    [IsCyclic G] (S : Subgroup G) (e : ℕ) :
    (S ⊔ (powMonoidHom e : G →* G).range).index = Nat.gcd e S.index := by
  obtain ⟨g,hg⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic G)
  obtain ⟨i,hi⟩ := S.exists_zpowers_eq_of_zpowers_eq_top hg
  have hr : (powMonoidHom e : G →* G).range = Subgroup.zpowers (g^(e : ℤ)) := by
    rw [MonoidHom.range_eq_map, ← hg, MonoidHom.map_zpowers,
      powMonoidHom_apply, zpow_natCast]
  rw [← hi, hr, Subgroup.zpowers_zpow_sup, Subgroup.index_zpowers_zpow hg,
    Subgroup.index_zpowers_zpow hg]
  simp only [Int.gcd, Int.natAbs_natCast]
  ac_rfl

/-- The report's complete cyclic twist image test. This applies to the unit
group of a finite field and the embedded subfield's unit subgroup. -/
theorem finite_cyclic_twist_descent {G : Type*} [CommGroup G] [Finite G]
    [IsCyclic G] (S : Subgroup G) (e : ℕ) (x : G) :
    x ∈ S ⊔ (powMonoidHom e : G →* G).range ↔
      x^(Nat.card G / Nat.gcd e (Nat.card G / Nat.card S)) = 1 := by
  rw [cyclic_subgroup_index_test, cyclic_sup_power_index, S.index_eq_card_div]

end WeakCurveProperties
