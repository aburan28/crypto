// cubic_n3_p29.magma: run as `magma -b cubic_n3_p29.magma`; prints wall and CPU seconds of GroebnerBasis.
K := GF(29);
P<x1,x2,x3> := PolynomialRing(K, 3, "grevlex");
I := ideal<P | 16+23*x3+11*x3^3+24*x2+9*x2*x3+19*x2*x3^2+27*x2^2+15*x2^2*x3+24*x2^3+26*x1*x3+22*x1*x3^2+3*x1*x2+17*x1*x2*x3+9*x1*x2^2+15*x1^2+19*x1^2*x3+20*x1^2*x2+23*x1^3,
  6*x3+11*x3^2+16*x3^3+11*x2+2*x2*x3+24*x2*x3^2+12*x2^2+17*x2^2*x3+24*x2^3+x1+11*x1*x3+5*x1*x3^2+26*x1*x2+x1*x2^2+12*x1^2+12*x1^2*x3+3*x1^2*x2+23*x1^3,
  24+15*x3+21*x3^2+7*x3^3+11*x2+28*x2*x3+22*x2*x3^2+x2^2+4*x2^2*x3+3*x2^3+x1+13*x1*x3+18*x1*x3^2+3*x1*x2+22*x1*x2*x3+2*x1*x2^2+9*x1^2+18*x1^2*x3+5*x1^2*x2+2*x1^3>;
t := Cputime(); w := Realtime();
G := GroebnerBasis(I);
printf "magma_gb_cpu_s %o\nmagma_gb_wall_s %o\n", Cputime(t), Realtime(w);
O := [P | x1*x2^2+17*x2^3+17*x1^2*x3+x1*x2*x3+9*x2^2*x3+22*x1*x3^2+28*x2*x3^2+13*x3^3+13*x1*x2+18*x2^2+15*x2*x3+16*x3^2+7*x1+27*x2+17*x3+2,
  x1^2*x2+21*x2^3+18*x1^2*x3+21*x1*x2*x3+11*x2^2*x3+6*x1*x3^2+7*x2*x3^2+26*x3^3+7*x1^2+13*x1*x2+18*x2^2+6*x1*x3+7*x2*x3+14*x3^2+12*x1+22*x3,
  x1^3+19*x2^3+5*x1^2*x3+x1*x2*x3+9*x2^2*x3+x1*x3^2+9*x2*x3^2+27*x3^3+16*x1^2+14*x1*x2+10*x2^2+6*x1*x3+25*x2*x3+3*x3^2+7*x1+22*x2+8*x3+10,
  x2^3*x3+3*x1^2*x3^2+24*x1*x2*x3^2+4*x2^2*x3^2+11*x1*x3^3+27*x2*x3^3+16*x3^4+28*x2^3+21*x1*x2*x3+6*x2^2*x3+25*x1*x3^2+5*x2*x3^2+25*x3^3+20*x1^2+18*x1*x2+12*x2^2+7*x1*x3+23*x2*x3+2*x3^2+18*x1+5*x2+2*x3+10,
  x2^4+27*x1^2*x3^2+22*x1*x2*x3^2+16*x2^2*x3^2+24*x1*x3^3+15*x2*x3^3+22*x3^4+19*x2^3+27*x1^2*x3+12*x1*x2*x3+13*x2^2*x3+23*x1*x3^2+8*x2*x3^2+18*x3^3+3*x1^2+17*x1*x2+x1*x3+11*x2*x3+23*x3^2+24*x1+16*x2+2*x3+16,
  x2^2*x3^3+26*x1*x3^4+7*x2*x3^4+x3^5+11*x1^2*x3^2+21*x1*x2*x3^2+27*x2^2*x3^2+21*x1*x3^3+9*x2*x3^3+21*x3^4+8*x2^3+12*x1^2*x3+24*x1*x2*x3+9*x2^2*x3+27*x1*x3^2+8*x2*x3^2+8*x3^3+13*x1^2+6*x1*x2+13*x2^2+17*x1*x3+18*x2*x3+2*x1+2*x2+23*x3+17,
  x1*x2*x3^3+24*x1*x3^4+7*x2*x3^4+5*x3^5+19*x1^2*x3^2+19*x1*x2*x3^2+4*x2^2*x3^2+23*x1*x3^3+22*x2*x3^3+4*x3^4+13*x2^3+17*x1^2*x3+24*x1*x2*x3+18*x2^2*x3+23*x1*x3^2+24*x3^3+19*x1^2+25*x1*x2+2*x2^2+17*x1*x3+2*x2*x3+2*x3^2+10*x1+28*x2+8*x3+24,
  x1^2*x3^3+17*x1*x3^4+24*x2*x3^4+15*x3^5+23*x1^2*x3^2+11*x1*x2*x3^2+18*x2^2*x3^2+13*x1*x3^3+3*x2*x3^3+26*x3^4+16*x2^3+6*x1^2*x3+18*x1*x2*x3+15*x2^2*x3+5*x1*x3^2+8*x2*x3^2+19*x3^3+22*x1^2+22*x1*x2+9*x2^2+17*x1*x3+17*x2*x3+2*x3^2+14*x1+7*x2+19*x3+11,
  x2*x3^5+6*x3^6+x1*x3^4+4*x2*x3^4+20*x3^5+9*x1^2*x3^2+21*x1*x2*x3^2+15*x2^2*x3^2+17*x1*x3^3+17*x2*x3^3+27*x3^4+10*x2^3+11*x1^2*x3+2*x1*x2*x3+22*x2^2*x3+11*x1*x3^2+20*x2*x3^2+21*x3^3+28*x1^2+9*x1*x2+8*x2^2+19*x1*x3+16*x2*x3+16*x3^2+24*x1+26*x2+13*x3+16,
  x1*x3^5+8*x3^6+19*x1*x3^4+27*x2*x3^4+3*x3^5+15*x1^2*x3^2+8*x1*x2*x3^2+19*x2^2*x3^2+11*x1*x3^3+26*x2*x3^3+23*x3^4+3*x2^3+28*x1^2*x3+27*x1*x2*x3+10*x2^2*x3+28*x1*x3^2+26*x2*x3^2+2*x3^3+10*x1^2+11*x1*x2+x1*x3+2*x2*x3+2*x3^2+5*x1+9*x2+17*x3+25,
  x3^7+25*x3^6+26*x1*x3^4+2*x2*x3^4+5*x3^5+7*x1^2*x3^2+5*x2^2*x3^2+24*x1*x3^3+x2*x3^3+22*x3^4+18*x2^3+20*x1*x2*x3+9*x2^2*x3+24*x1*x3^2+13*x2*x3^2+18*x3^3+9*x1^2+x1*x2+9*x2^2+7*x1*x3+18*x2*x3+4*x3^2+17*x1+26*x2+7*x3+19];
printf "magma_basis_size %o\nours_size %o\n", #G, #O;
printf "same_ideal %o\n", ideal<P | O> eq I;
printf "same_reduced_basis %o\n", Set(G) eq Set(O);
quit;
