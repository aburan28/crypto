// overdet_n6_m9_p101.magma: run as `magma -b overdet_n6_m9_p101.magma`; prints wall and CPU seconds of GroebnerBasis.
K := GF(101);
P<x1,x2,x3,x4,x5,x6> := PolynomialRing(K, 6, "grevlex");
I := ideal<P | 22+23*x6+67*x6^2+93*x5+8*x5*x6+100*x5^2+80*x4+9*x4*x6+31*x4*x5+69*x4^2+47*x3+29*x3*x6+48*x3*x5+73*x3*x4+33*x3^2+13*x2+40*x2*x6+12*x2*x5+34*x2*x4+57*x2*x3+66*x2^2+57*x1+99*x1*x6+29*x1*x5+41*x1*x4+10*x1*x3+50*x1*x2+21*x1^2,
