  58+21*x6+29*x6^2+26*x5+63*x5*x6+30*x5^2+45*x4+19*x4*x6+33*x4*x5+81*x4^2+73*x3+46*x3*x6+80*x3*x5+51*x3*x4+69*x3^2+29*x2+65*x2*x6+61*x2*x5+54*x2*x4+85*x2*x3+73*x2^2+11*x1+75*x1*x6+44*x1*x5+74*x1*x4+66*x1*x3+74*x1*x2+48*x1^2,
  64+89*x6+12*x6^2+54*x5+48*x5*x6+71*x5^2+75*x4+69*x4*x6+67*x4*x5+60*x4^2+37*x3+27*x3*x6+13*x3*x5+2*x3*x4+24*x3^2+52*x2+15*x2*x6+50*x2*x5+2*x2*x4+77*x2*x3+18*x2^2+15*x1+28*x1*x6+55*x1*x5+16*x1*x4+24*x1*x3+49*x1*x2+62*x1^2,
  26+30*x6+26*x6^2+x5+34*x5*x6+71*x5^2+92*x4+84*x4*x6+28*x4*x5+61*x4^2+8*x3+93*x3*x6+79*x3*x5+92*x3*x4+61*x3^2+55*x2+79*x2*x6+97*x2*x5+35*x2*x4+35*x2*x3+88*x2^2+75*x1+80*x1*x6+94*x1*x5+97*x1*x4+33*x1*x3+52*x1*x2+42*x1^2,
  73+31*x6+63*x6^2+78*x5+61*x5*x6+81*x5^2+61*x4+37*x4*x6+53*x4*x5+x4^2+26*x3+91*x3*x6+16*x3*x5+70*x3*x4+6*x3^2+76*x2+65*x2*x6+8*x2*x5+42*x2*x4+63*x2*x3+28*x2^2+16*x1+20*x1*x6+51*x1*x5+79*x1*x4+3*x1*x3+82*x1*x2+23*x1^2,
  46+17*x6+59*x6^2+48*x5+18*x5*x6+54*x5^2+31*x4+28*x4*x6+58*x4*x5+49*x4^2+80*x3+58*x3*x6+19*x3*x5+61*x3*x4+15*x3^2+32*x2+43*x2*x6+29*x2*x5+2*x2*x4+92*x2*x3+35*x2^2+35*x1+5*x1*x6+31*x1*x5+98*x1*x4+67*x1*x3+68*x1*x2+44*x1^2,
  16+75*x6+43*x6^2+23*x5+10*x5*x6+82*x5^2+31*x4+58*x4*x6+80*x4*x5+91*x4^2+87*x3+48*x3*x6+34*x3*x5+11*x3*x4+100*x3^2+88*x2+13*x2*x4+40*x2*x3+32*x2^2+9*x1+42*x1*x6+95*x1*x5+63*x1*x4+24*x1*x3+28*x1*x2+86*x1^2,
