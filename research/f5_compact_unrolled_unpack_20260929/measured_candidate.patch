+/// Build a compact lookup only when its actual allocation fits the budget.
+fn compact_unrolled_columns(cols: &[u64]) -> Option<Vec<u32>> {
+    const MAX_BYTES: usize = 256 * 1024;
+    if cols.len().checked_mul(std::mem::size_of::<u32>())? > MAX_BYTES {
+        return None;
+    }
+    let mut compact = Vec::new();
+    compact.try_reserve_exact(cols.len()).ok()?;
+    if compact.capacity().checked_mul(std::mem::size_of::<u32>())? > MAX_BYTES {
+        return None;
+    }
+    for &mask in cols {
+        compact.push(u32::try_from(mask).ok()?);
+    }
+    Some(compact)
+}
+
+/// Decode set columns in ascending order, writing two masks per iteration.
+fn unpack_row_compact_unrolled(row: &[u64], cols: &[u32], n_vars: usize) -> F2BoolPoly {
+    let valid_words = cols.len().div_ceil(64);
+    let tail_bits = cols.len() % 64;
+    if row.len() != valid_words
+        || (tail_bits != 0 && row.last().is_some_and(|&last| last >> tail_bits != 0))
+    {
+        let wide: Vec<u64> = cols.iter().map(|&mask| mask as u64).collect();
+        return unpack_row_scalar_direct(row, &wide, n_vars);
+    }
+
+    let terms: usize = row.iter().map(|word| word.count_ones() as usize).sum();
+    let mut monos = Vec::<F2BoolMono>::with_capacity(terms);
+    let out = monos.as_mut_ptr();
+    let mut written = 0;
+    for (w, &word) in row.iter().enumerate() {
+        let base = w * 64;
+        let mut bits = word;
+        while bits != 0 {
+            let first = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            // SAFETY: the row width and padding were checked before the loop.
+            let first_mask = unsafe { *cols.get_unchecked(first) } as u64;
+            if bits == 0 {
+                // SAFETY: `written` is below the precomputed row popcount.
+                unsafe { out.add(written).write(F2BoolMono::from_mask(first_mask)) };
+                written += 1;
+                break;
+            }
+            let second = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            // SAFETY: the row width and padding were checked before the loop.
+            let second_mask = unsafe { *cols.get_unchecked(second) } as u64;
+            // SAFETY: both slots are within the precomputed row popcount.
+            unsafe {
+                out.add(written).write(F2BoolMono::from_mask(first_mask));
+                out.add(written + 1)
+                    .write(F2BoolMono::from_mask(second_mask));
+            }
+            written += 2;
+        }
+    }
+    debug_assert_eq!(written, terms);
+    // SAFETY: every slot was initialized exactly once.
+    unsafe { monos.set_len(terms) };
+    F2BoolPoly {
+        terms: monos,
+        n_vars,
+    }
+}
