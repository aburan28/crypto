+#[cfg(test)]
+mod row_qualification {
+    use super::Echelon;
+
+    // Batch RREF with Fermat inversion is independent of the incremental
+    // reducer and its extended-Euclidean inverse. All arithmetic is widened.
+    fn reference_rank(input: &[Vec<u64>], columns: usize, prime: u64) -> usize {
+        let modulus = u128::from(prime);
+        let mut matrix: Vec<Vec<u128>> = input.iter()
+            .map(|row| row[..columns].iter().map(|&v| u128::from(v)).collect()).collect();
+        let mut rank = 0;
+        for column in 0..columns {
+            let Some(pivot) = (rank..matrix.len()).find(|&i| matrix[i][column] != 0) else { continue };
+            matrix.swap(rank, pivot);
+            let (mut power, mut exponent, mut inverse) = (matrix[rank][column], prime - 2, 1);
+            while exponent != 0 {
+                if exponent & 1 != 0 { inverse = inverse * power % modulus; }
+                power = power * power % modulus;
+                exponent >>= 1;
+            }
+            for value in &mut matrix[rank] { *value = *value * inverse % modulus; }
+            for row in 0..matrix.len() {
+                if row == rank { continue; }
+                let factor = matrix[row][column];
+                for c in 0..columns {
+                    matrix[row][c] = (matrix[row][c] + modulus - factor * matrix[rank][c] % modulus) % modulus;
+                }
+            }
+            rank += 1;
+        }
+        rank
+    }
+
+    #[test]
+    fn incremental_rank_and_solution_match_independent_batch_elimination() {
+        for prime in [3, 5, 2003, 4_196_903, (1u64 << 61) - 1] {
+            for columns in [1, 2, 7, 16, 24] {
+                let solution: Vec<u64> = (0..columns).map(|i| (prime - 1 - i as u64 % prime) % prime).collect();
+                let mut reducer = Echelon::new(columns, prime);
+                let mut rows: Vec<Vec<u64>> = Vec::new();
+                let mut state = 0xC61D_2026_0925u64 ^ prime ^ columns as u64;
+                for step in 0..(3 * columns + 8) {
+                    let mut row = vec![0; columns + 1];
+                    if step >= 2 * columns + 8 {
+                        // End with a full independent basis even after singular prefixes.
+                        row[step - (2 * columns + 8)] = 1;
+                    } else if step % 4 == 1 && !rows.is_empty() {
+                        row = rows.last().unwrap().clone();
+                    } else if step % 4 != 0 {
+                        for value in &mut row[..columns] {
+                            state ^= state << 13; state ^= state >> 7; state ^= state << 17;
+                            *value = state % prime;
+                        }
+                    }
+                    row[columns] = row[..columns].iter().zip(&solution).fold(0u128,
+                        |sum, (&a, &b)| (sum + u128::from(a) * u128::from(b)) % u128::from(prime)) as u64;
+                    let previous = reducer.rank;
+                    let novel = reducer.push(row.clone());
+                    rows.push(row);
+                    let rank = reference_rank(&rows, columns, prime);
+                    assert_eq!(reducer.rank, rank, "prime={prime} columns={columns} step={step}");
+                    assert_eq!(novel, rank > previous);
+                    if rank == columns { assert_eq!(reducer.solve(), Some(solution.clone())); }
+                    else { assert_eq!(reducer.solve(), None); }
+                }
+                assert_eq!(reducer.rank, columns);
+            }
+        }
+    }
