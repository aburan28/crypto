+#[cfg(test)]
+mod candidate_policy_tests {
+    use super::*;
+
+    #[test]
+    fn exact_stop_and_full_pair_policies_have_real_distinct_shapes() {
+        for (n, a) in [(13, 0), (17, 1), (23, 0), (31, 0)] {
+            let kc = KoblitzCurve::new(a, n).unwrap();
+            let spec = FactorBaseSpec::SubgroupOrbits { seed: 43, points: 6 * n as usize };
+            let legacy = TinyIc::new(&kc, &spec, 17, 65536).unwrap();
+            // Distinct sampled abscissae can still share a Frobenius orbit.
+            assert!(legacy.columns() > 3);
+            for count in [2, 3, 4, 6] {
+                let policy = TinyPolicy { orbit_batch: 1, orbit_target: Some(count),
+                    row_kernel: RowKernel::Word, full_pair_table: true };
+                let mut ic = TinyIc::with_policy(&kc, &spec, 17, 65536, policy).unwrap();
+                assert_eq!(ic.columns(), count);
+                assert_eq!(ic.table_shape().0, count);
+                // The same draw stream stops earlier, before the old batch overshoot.
+                let old = legacy.base_points();
+                for point in ic.base_points() { assert!(old.contains(&point)); }
+                while ic.trials() < 65536 {
+                    let rows = ic.collect(1); ic.push(&rows);
+                    if ic.try_solve() { break; }
+                }
+                assert!(ic.verify_columns());
+                let target = kc.mul(kc.generator(), &BigUint::from(71u64));
+                let (answer, _, witness) = ic.solve_target(&target).unwrap();
+                assert!(!witness.points.is_empty());
+                assert_eq!(kc.mul(kc.generator(), &answer), target);
+            }
+        }
+    }
+}
