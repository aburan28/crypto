+/// Explicit scalar-row implementations used by the bounded candidate panel.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum RowKernel { Full, Suffix, Bounded, Word }
+
+impl RowKernel {
+    pub fn parse(name: &str) -> Result<Self, String> {
+        match name { "full" => Ok(Self::Full), "suffix" => Ok(Self::Suffix),
+            "bounded" => Ok(Self::Bounded), "word" => Ok(Self::Word),
+            _ => Err("unknown scalar-row kernel".into()) }
+    }
+    #[inline]
+    fn product(self, a: u64, b: u64, r: u64) -> u64 {
+        if self == Self::Word && r <= u32::MAX as u64 {
+            // Canonical operands are below r: their product fits in u64.
+            (a * b) % r
+        } else { mulmod(a, b, r) }
+    }
+}
+
+/// Choices affect real construction/reduction work and are emitted in reports.
+#[derive(Clone, Copy, Debug, serde::Serialize)]
+pub struct TinyPolicy {
+    pub orbit_batch: usize,
+    pub orbit_target: Option<usize>,
+    pub row_kernel: RowKernel,
+    pub full_pair_table: bool,
+}
+impl Default for TinyPolicy {
+    fn default() -> Self {
+        Self { orbit_batch: 8, orbit_target: None, row_kernel: RowKernel::Full, full_pair_table: false }
+    }
+}
+
+#[inline]
+fn submod(a: u64, b: u64, r: u64) -> u64 {
+    if a >= b { a - b } else { r - (b - a) }
+}
