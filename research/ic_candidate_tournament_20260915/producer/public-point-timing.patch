+#[test]
+fn simultaneous_live_buffers_remain_intact() {
+    std::thread::scope(|scope| {
+        for thread in 0..4u8 {
+            scope.spawn(move || {
+                for iteration in 0..5000usize {
+                    let byte=thread.wrapping_add(iteration as u8);
+                    let mut data=vec![byte; 16+iteration%512];
+                    let mut other=vec![byte ^ 0xff; 19+iteration%117];
+                    data.reserve(70);
+                    other.resize(200,byte ^ 0xff);
+                    assert!(data.iter().all(|&v|v==byte));
+                    assert!(other.iter().all(|&v|v==byte ^ 0xff));
+                }
+            });
+        }
+    });
+}
