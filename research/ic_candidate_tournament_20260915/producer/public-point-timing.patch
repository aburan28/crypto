+/// Decode the supplied public point without constructing a target scalar or
+/// silently reducing out-of-range coordinates. Seeds are provenance only.
+fn public_point(c: &KoblitzCurve, encoded: &[String; 2]) -> Result<BinaryPoint, String> {
+    let coordinate = |text: &str| -> Result<F2mElement, String> {
+        if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) ||
+            (text.len() > 1 && text.starts_with('0')) {
+            return Err("noncanonical public coordinate".into());
+        }
+        let value = text.parse::<BigUint>().map_err(|_| "invalid coordinate")?;
+        if value.bits() > u64::from(c.n) { return Err("coordinate outside field encoding".into()); }
+        Ok(F2mElement::from_biguint(&value, c.n))
+    };
+    let q = BinaryPoint::Affine { x: coordinate(&encoded[0])?, y: coordinate(&encoded[1])? };
+    if !c.curve.is_on_curve(&q) || c.mul(&q, &c.subgroup_order) != BinaryPoint::Infinity {
+        return Err("public point is outside the declared subgroup".into());
+    }
+    Ok(q)
+}
