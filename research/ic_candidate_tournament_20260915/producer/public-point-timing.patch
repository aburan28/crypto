+#[cfg(test)]
+mod public_input_tests {
+    use super::*;
+
+    fn job(mode: &str, target: Option<Value>, seeds: Vec<u64>) -> Job {
+        serde_json::from_value(json!({"mode":mode,"degree":13,"curve_a":0,
+            "target_seeds":seeds,"public_targets":target,"algorithm_seed":2026092527u64,
+            "factor_base":{"kind":"subgroup_orbits","seed":43,"points":78},
+            "config":{"batch_trials":1,"max_trials":4096}})).unwrap()
+    }
+
+    fn value(report: Report) -> Value {
+        match report { Report::Tree(v) => v, Report::Text(s, _) => serde_json::from_str(&s).unwrap() }
+    }
+
+    #[test]
+    fn public_coordinates_are_canonical_and_subgroup_checked() {
+        let c = KoblitzCurve::new(0, 13).unwrap();
+        for encoded in [["00", "1"], ["+1", "1"], ["8192", "1"], ["0", "1"]] {
+            assert!(public_point(&c, &encoded.map(String::from)).is_err());
+        }
+        let encoded: [String; 2] = serde_json::from_value(point(c.generator())).unwrap();
+        assert_eq!(public_point(&c, &encoded).unwrap(), *c.generator());
+    }
+
+    #[test]
+    fn measured_jobs_reject_generation_and_multiple_targets() {
+        let c = KoblitzCurve::new(0, 13).unwrap();
+        for mode in ["ic", "rho", "inventory"] {
+            assert!(run(&job(mode, None, vec![43])).is_err());
+            assert!(run(&job(mode, Some(json!([point(c.generator()), point(c.generator())])), vec![43,44])).is_err());
+        }
+        assert!(run(&job("fixture", None, vec![43])).is_ok());
+    }
+
+    #[test]
+    fn both_algorithms_use_the_point_and_ignore_provenance_seeds() {
+        let c = KoblitzCurve::new(0, 13).unwrap();
+        // Planted only as a correctness control, never a yield/timing sample.
+        let target = point(&c.mul(c.generator(), &BigUint::from(5u32)));
+        for mode in ["ic", "rho"] {
+            for seeds in [vec![], vec![111], vec![222]] {
+                let report = value(run(&job(mode, Some(json!([target])), seeds)).ok().unwrap());
+                assert_eq!(report["fixture"]["targets"][0], target);
+                assert_eq!(report["solutions"][0]["recovered"], "5");
+                assert_eq!(report["phase_schema"], 3);
+                let timing = if mode == "ic" { &report["diagnostics"] } else { &report };
+                assert_eq!(timing["target_input"], "supplied_public_point");
+                let online: u64 = if mode == "ic" {
+                    ["target_query", "target_pdp", "target_relation_check", "target_descent", "recovery_check"].iter()
+                        .map(|name| timing["phase_wall_ns"][name].as_u64().unwrap()).sum()
+                } else {
+                    timing["phase_wall_ns"]["reference_solve"].as_u64().unwrap() +
+                        timing["phase_wall_ns"]["recovery_check"].as_u64().unwrap()
+                };
+                assert_eq!(timing["online_wall_ns"].as_u64(), Some(online));
+                assert!(online > 0);
+            }
+        }
+    }
+}
