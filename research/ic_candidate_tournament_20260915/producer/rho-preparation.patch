+#[cfg(test)]
+mod rho_preparation_tests {
+    use super::*;
+
+    #[test]
+    fn prepared_entry_preserves_walk_charges_and_recovered_log() {
+        for (n,a) in [(13,0), (17,1), (23,1)] {
+            let c = KoblitzCurve::new(a,n).unwrap();
+            let q = c.mul(c.generator(), &BigUint::from(5u32));
+            let options = KoblitzSignedRhoOptions::default();
+            let before = koblitz_signed_frobenius_rho_with_progress(&c,&q,&options,&mut |_| {});
+            let mut calls = 0;
+            let after = koblitz_signed_frobenius_rho_with_preparation(&c,&q,&options,
+                &mut |fc| { calls += 1; assert_eq!(fc.n,n);
+                    assert!(matches!(fc.field.kernel_name(), "portable"|"pclmulqdq")); },
+                &mut |_| {}).unwrap();
+            assert_eq!(calls,1);
+            assert!(before.verified && after.verified);
+            assert_eq!(before.recovered_log,after.recovered_log);
+            assert_eq!(before.charges,after.charges);
+            assert_eq!(before.iterations,after.iterations);
+            assert_eq!(before.parallel_walks,after.parallel_walks);
+        }
+    }
+}
