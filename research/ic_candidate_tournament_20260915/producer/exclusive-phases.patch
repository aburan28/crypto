+#[cfg(test)]
+mod phase_admission_tests {
+    use super::*;
+
+    #[test]
+    fn direct_collision_is_skipped_and_real_descent_is_retained() {
+        let kc = KoblitzCurve::new(0, 13).unwrap();
+        let base = FactorBaseSpec::SubgroupOrbits { seed: 43, points: 78 };
+        let mut tiny = TinyIc::new(&kc, &base, 20260925, 4096).unwrap();
+        while !tiny.try_solve() && tiny.trials() < 4096 {
+            let rows = tiny.collect(1);
+            tiny.push(&rows);
+        }
+        assert!(tiny.verify_columns());
+        // Predict only the next descent query, then force it to be the identity.
+        // This is an admission control, never an ordinary-yield sample.
+        let mut next = SplitMix(tiny.rng.0);
+        let a = next.scalar(tiny.r);
+        let b = next.scalar(tiny.r);
+        let d = mulmod(tiny.r - a, invmod(b, tiny.r).unwrap(), tiny.r);
+        let q = kc.mul(kc.generator(), &BigUint::from(d));
+        let (found, attempts, witness) = tiny.solve_target(&q).unwrap();
+        assert_eq!(found, BigUint::from(d));
+        assert!(attempts >= 2);
+        assert_eq!(witness.points.len(), 3);
+        assert_eq!(tiny.diagnostics.ordinary_queries,
+            tiny.diagnostics.pdp_verified + tiny.diagnostics.pdp_unresolved);
+        assert_eq!(tiny.trials(), tiny.diagnostics.ordinary_queries + tiny.diagnostics.identity_queries);
+        assert_eq!(tiny.diagnostics.rank_events.len(), tiny.accepted);
+        assert_eq!(tiny.diagnostics.rank_events.last().unwrap()[2], tiny.columns() as u64);
+    }
+}
