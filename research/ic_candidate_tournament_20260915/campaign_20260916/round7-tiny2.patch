+
+/// `rand 0.8`'s `StdRng` (ChaCha12) and its `seed_from_u64` and
+/// `gen_range` for `u64`, reproduced word for word so the base recipe
+/// draws the same abscissae from a few dozen lines of scalar code instead
+/// of the generic block-generator machinery.  A test checks the stream
+/// against `StdRng` itself, draw for draw.
+struct SeededChaCha12 {
+    key: [u32; 8],
+    counter: u64,
+    buffer: [u32; 64],
+    index: usize,
+}
+
+impl SeededChaCha12 {
+    fn seed_from_u64(mut state: u64) -> Self {
+        // rand_core's PCG32 seed expansion.
+        const MUL: u64 = 6364136223846793005;
+        const INC: u64 = 11634580027462260723;
+        let mut key = [0u32; 8];
+        for k in key.iter_mut() {
+            state = state.wrapping_mul(MUL).wrapping_add(INC);
+            let xorshifted = (((state >> 18) ^ state) >> 27) as u32;
+            let rot = (state >> 59) as u32;
+            *k = xorshifted.rotate_right(rot);
+        }
+        Self { key, counter: 0, buffer: [0; 64], index: 64 }
+    }
+
+    fn refill(&mut self) {
+        for block in 0..4 {
+            let mut s = [
+                0x6170_7865, 0x3320_646e, 0x7962_2d32, 0x6b20_6574,
+                self.key[0], self.key[1], self.key[2], self.key[3],
+                self.key[4], self.key[5], self.key[6], self.key[7],
+                self.counter as u32, (self.counter >> 32) as u32, 0, 0,
+            ];
+            let input = s;
+            #[inline(always)]
+            fn qr(s: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize) {
+                s[a] = s[a].wrapping_add(s[b]); s[d] = (s[d] ^ s[a]).rotate_left(16);
+                s[c] = s[c].wrapping_add(s[d]); s[b] = (s[b] ^ s[c]).rotate_left(12);
+                s[a] = s[a].wrapping_add(s[b]); s[d] = (s[d] ^ s[a]).rotate_left(8);
+                s[c] = s[c].wrapping_add(s[d]); s[b] = (s[b] ^ s[c]).rotate_left(7);
+            }
+            for _ in 0..6 {
+                qr(&mut s, 0, 4, 8, 12); qr(&mut s, 1, 5, 9, 13); qr(&mut s, 2, 6, 10, 14); qr(&mut s, 3, 7, 11, 15);
+                qr(&mut s, 0, 5, 10, 15); qr(&mut s, 1, 6, 11, 12); qr(&mut s, 2, 7, 8, 13); qr(&mut s, 3, 4, 9, 14);
+            }
+            for (i, w) in s.iter().enumerate() {
+                self.buffer[block * 16 + i] = w.wrapping_add(input[i]);
+            }
+            self.counter = self.counter.wrapping_add(1);
+        }
+        self.index = 0;
+    }
+
+    /// rand_core's `BlockRng::next_u64` over a 64-word buffer.
+    fn next_u64(&mut self) -> u64 {
+        let len = 64;
+        if self.index < len - 1 {
+            let lo = self.buffer[self.index];
+            let hi = self.buffer[self.index + 1];
+            self.index += 2;
+            (u64::from(hi) << 32) | u64::from(lo)
+        } else if self.index >= len {
+            self.refill();
+            self.index = 2;
+            (u64::from(self.buffer[1]) << 32) | u64::from(self.buffer[0])
+        } else {
+            let lo = self.buffer[len - 1];
+            self.refill();
+            self.index = 1;
+            (u64::from(self.buffer[0]) << 32) | u64::from(lo)
+        }
+    }
+
+    /// `rng.gen_range(low..high)` for `u64` in rand 0.8: widening multiply
+    /// with rejection below the zone.
+    fn gen_range_u64(&mut self, low: u64, high: u64) -> u64 {
+        let range = high - low; // inclusive upper bound high - 1
+        if range == 0 {
+            return self.next_u64();
+        }
+        let zone = (range << range.leading_zeros()).wrapping_sub(1);
+        loop {
+            let v = self.next_u64();
+            let wide = (v as u128) * (range as u128);
+            let (hi, lo) = ((wide >> 64) as u64, wide as u64);
+            if lo <= zone {
+                return low.wrapping_add(hi);
+            }
+        }
+    }
