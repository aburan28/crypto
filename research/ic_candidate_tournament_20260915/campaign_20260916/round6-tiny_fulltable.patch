+    #[test]
+    fn euclid_inverse_matches_fermat() {
+        for (n, a) in CELLS {
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let irr = kc.curve.irreducible.low_terms.iter().fold(1u64 << n, |acc, &t| acc | (1u64 << t));
+            let arith = Arith { fc, irr };
+            let mask = (1u64 << n) - 1;
+            let mut state = 0x1234_5678_9abc_def0u64 ^ u64::from(n);
+            for _ in 0..2000 {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                let x = (state >> 11) & mask;
+                if x == 0 {
+                    continue;
+                }
+                assert_eq!(arith.inv(x), arith.fc.field.inv(x), "n={n} x={x}");
+                assert_eq!(arith.mul(x, arith.inv(x)), 1);
+            }
+        }
+    }
+
+    #[test]
+    fn arithmetic_matches_fast_curve() {
+        for (n, a) in CELLS {
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let irr = kc.curve.irreducible.low_terms.iter().fold(1u64 << n, |acc, &t| acc | (1u64 << t));
+            let arith = Arith { fc: fc.clone(), irr };
+            let g = fc.lift(kc.generator());
+            let r = kc.subgroup_order.to_u64().unwrap();
+            for k in [1u64, 2, 3, 5, 17, 1000, r - 1, r / 3 + 1] {
+                let k = k % r;
+                if k == 0 {
+                    continue;
+                }
+                assert_eq!(arith.mul_point(g, k), fc.mul_u64(g, k), "n={n} k={k}");
+            }
+            let p = fc.mul_u64(g, 12345 % r);
+            let q = fc.mul_u64(g, 777 % r);
+            assert_eq!(arith.add(p, q), fc.add(p, q));
+            assert_eq!(arith.double(p), fc.double(p));
+            assert_eq!(arith.add(p, arith.neg(p)), FastPoint::INFINITY);
+            assert_eq!(arith.frobenius_k(p, 3), fc.frobenius_k(p, 3));
+        }
+    }
+
+    #[test]
+    fn normal_basis_rotation_locates_frobenius_images() {
+        for (n, a) in CELLS {
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let irr = kc.curve.irreducible.low_terms.iter().fold(1u64 << n, |acc, &t| acc | (1u64 << t));
+            let arith = Arith { fc, irr };
+            let canon = NormalBasis::new(&arith).unwrap();
+            let mask = (1u64 << n) - 1;
+            let mut state = 0xdead_beef_u64 ^ u64::from(n);
+            for _ in 0..500 {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                let x = (state >> 7) & mask;
+                if x <= 1 {
+                    continue;
+                }
+                let (key, rot_x) = canon.canon(x);
+                for k in 0..n {
+                    let y = arith.fc.field.sqr_k(x, k);
+                    let (key_y, rot_y) = canon.canon(y);
+                    assert_eq!(key, key_y);
+                    assert_eq!((rot_x + n - rot_y) % n, k, "n={n} x={x} k={k}");
+                }
+                assert_eq!(arith.fc.field.sqr_k(x, rot_x) , {
+                    // the element whose coords are the least rotation
+                    let mut best = x; let mut bx = x;
+                    for _ in 1..n { bx = arith.sqr(bx); if canon.coords(bx) < canon.coords(best) { best = bx; } }
+                    best
+                });
+            }
+        }
+    }
+
+    #[test]
+    fn base_matches_general_construction() {
+        let mut checked = 0;
+        for (n, a) in CELLS {
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let spec = FactorBaseSpec::SubgroupOrbits { seed: 43, points: 6 * n as usize };
+            let Ok(general) = spec.materialize(&kc) else {
+                // A toy group too small for the recipe: both must decline.
+                assert!(TinyIc::new(&kc, &spec, 7, 4096).is_err(), "n={n} a={a}");
+                continue;
+            };
+            let tiny = TinyIc::new(&kc, &spec, 7, 4096).unwrap();
+            let mut expected: Vec<(BigUint, BigUint)> = general.points.iter().map(point_key).collect();
+            let mut actual: Vec<(BigUint, BigUint)> = tiny.base_points().iter().map(point_key).collect();
+            expected.sort();
+            actual.sort();
+            assert_eq!(expected, actual, "base differs on n={n} a={a}");
+            assert_eq!(tiny.columns(), general.signed_orbits.len(), "columns on n={n} a={a}");
+            // every base point is in the subgroup and the index layout is consistent
+            for (i, p) in tiny.base_points().iter().enumerate() {
+                let (o, k, s) = tiny.location(i);
+                let rep = tiny.base_points()[tiny.index(o, 0, false)].clone();
+                let mut expected = rep;
+                for _ in 0..k { expected = kc.frobenius(&expected); }
+                if s {
+                    if let BinaryPoint::Affine { x, y } = &expected {
+                        expected = BinaryPoint::Affine { x: x.clone(), y: x.add(y) };
+                    }
+                }
+                assert_eq!(*p, expected);
+                assert_eq!(kc.mul(p, &kc.subgroup_order), BinaryPoint::Infinity);
+            }
+            checked += 1;
+        }
+        assert!(checked >= 7);
+    }
+
+    #[test]
+    fn complete_solve_verifies_in_general_arithmetic() {
+        for (n, a) in CELLS {
+            if n < 13 { continue; }
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let spec = FactorBaseSpec::SubgroupOrbits { seed: 43, points: 6 * n as usize };
+            for seed in [1u64, 2, 3] {
+                let mut tiny = TinyIc::new(&kc, &spec, seed, 4096).unwrap();
+                let mut all = Vec::new();
+                let mut solved = false;
+                while tiny.trials() < 4096 && !solved {
+                    let rows = tiny.collect(4);
+                    tiny.push(&rows);
+                    all.extend(rows);
+                    solved = tiny.try_solve();
+                }
+                assert!(solved, "n={n} a={a} seed={seed}");
+                let base = tiny.base_points();
+                let g = kc.generator();
+                for rel in &all {
+                    let sum = rel.points.iter().fold(BinaryPoint::Infinity, |s, &i| kc.add(&s, &base[i]));
+                    assert_eq!(sum, kc.mul(g, &BigUint::from(rel.a)));
+                    assert_eq!(rel.points.len(), 3);
+                }
+                let logs = tiny.column_logs().unwrap();
+                assert_eq!(logs.len(), tiny.columns());
+                for (c, l) in &logs {
+                    assert_eq!(kc.mul(g, l), *c);
+                }
+                assert!(tiny.verify_columns());
+                let r = kc.subgroup_order.to_u64().unwrap();
+                for d in [5u64, 99, r - 2, r / 2] {
+                    let q = kc.mul(g, &BigUint::from(d));
+                    let (found, trials) = tiny.solve_target(&q).expect("descent");
+                    assert_eq!(found, BigUint::from(d), "n={n} a={a} d={d}");
+                    assert!(trials >= 1);
+                }
+                let (accepted, duplicates, attempts) = tiny.accounting();
+                assert_eq!(accepted + duplicates, all.len());
+                assert!(attempts >= 1);
+            }
+        }
+    }
+
+    #[test]
+    fn unsupported_recipes_are_declined() {
+        let kc = KoblitzCurve::new(0, 13).unwrap();
+        assert!(!supports(&kc, &FactorBaseSpec::Factor { index: 0 }, 3));
+        assert!(!supports(&kc, &FactorBaseSpec::SubgroupOrbits { seed: 1, points: 8 }, 2));
+        let composite = KoblitzCurve::new(0, 15);
+        if let Some(kc) = composite {
+            assert!(!supports(&kc, &FactorBaseSpec::SubgroupOrbits { seed: 1, points: 8 }, 3));
+        }
+        let _ = F2mElement::zero(13);
+    }
+}
