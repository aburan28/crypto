+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::binary_ecc::F2mElement;
+    use crate::cryptanalysis::koblitz_index_calculus::point_key;
+
+    const CELLS: [(u32, u8); 9] = [
+        (5, 0),
+        (7, 1),
+        (13, 0),
+        (17, 1),
+        (19, 0),
+        (19, 1),
+        (23, 0),
+        (31, 0),
+        (31, 1),
