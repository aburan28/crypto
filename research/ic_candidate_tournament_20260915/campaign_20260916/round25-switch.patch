+    /// The switch prices the pair collector with the formula the collector's
+    /// own row rule minimises: on every supported cell, the rows it predicts
+    /// at the base actually sampled are the rows the collector built; at the
+    /// tournament's `points = 6n` the planned orbit count is the sampled one
+    /// or, where a small group merges draws, just above it.
+    #[test]
+    fn pair_work_matches_the_collectors_row_rule() {
+        for (n, a) in CELLS {
+            if n < 13 { continue; }
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let r = kc.subgroup_order.to_u64().unwrap();
+            for (seed, points) in [(43u64, 6 * n as usize), (7, 2 * n as usize), (43, 20 * n as usize)] {
+                let spec = FactorBaseSpec::SubgroupOrbits { seed, points };
+                let tiny = TinyIc::new_with(&kc, &spec, 1, 4096, Collector::Pair).unwrap();
+                let (rows, orbits, _, _) = tiny.table_shape();
+                assert_eq!(pair_rows_work(n, r, orbits).0, rows, "n={n} a={a} points={points}");
+                if points == 6 * n as usize {
+                    let planned = pair_orbits_planned(n, r, points);
+                    assert!(orbits <= planned && orbits + 2 >= planned, "n={n} a={a}: {orbits} vs {planned}");
+                }
+            }
+        }
+    }
+
+    /// The rule's own output at the tournament's twelve cells, `points = 6n`
+    /// as the tournament's jobs ask: the pair table up to `r ≈ 4.2·10⁶`, the
+    /// triple table from `n37a0` on.  A regression pin of the rule, not a
+    /// measurement; the margins are wide (`W₃/W₂` ≥ 2.0 on the pair side,
+    /// ≤ 0.78 on the triple side).
+    #[test]
+    fn the_switch_rule_at_the_tournament_cells() {
+        let cells = [
+            (13u32, 2_003u64, false),
+            (17, 65_587, false),
+            (19, 130_873, false),
+            (19, 262_543, false),
+            (23, 2_095_853, false),
+            (23, 4_196_903, false),
+            (29, 42_457, false),
+            (31, 1_439_393, false),
+            (37, 230_603_167, true),
+            (43, 4_644_189_029, true),
+            (59, 10_063_074_221, true),
+            (61, 11_514_943_771, true),
+        ];
+        for (n, r, triple) in cells {
+            let c = choose_collector(n, r, 6 * n as usize);
+            let expected = if triple { Collector::TripleCounted } else { Collector::Pair };
+            assert_eq!(c.collector, expected, "n={n} r={r}: {c:?}");
+            assert_eq!((c.triple_orbits, c.triple_rows), (counted_orbits(n, r), counted_rows(n, r, c.triple_orbits)));
+            let q = c.triple_work / c.pair_work;
+            assert!(if triple { q < 0.78 } else { q > 2.0 }, "n={n}: margin {q}");
+        }
+    }
+
+    /// The chosen collector is the collector: built through the switch's
+    /// choice it samples the same base, builds the same table and solves.
+    #[test]
+    fn the_switch_runs_the_chosen_collector() {
+        for (n, a) in CELLS {
+            if n < 13 { continue; }
+            let Some(kc) = KoblitzCurve::new(a, n) else { continue };
+            let r = kc.subgroup_order.to_u64().unwrap();
+            let spec = FactorBaseSpec::SubgroupOrbits { seed: 43, points: 6 * n as usize };
+            let choice = choose_collector(n, r, 6 * n as usize);
+            let mut tiny = TinyIc::new_with(&kc, &spec, 3, 4096, choice.collector).unwrap();
+            let alone = TinyIc::new_with(&kc, &spec, 3, 4096, choice.collector).unwrap();
+            assert_eq!(tiny.base_points(), alone.base_points());
+            assert_eq!(tiny.table_shape(), alone.table_shape());
+            if choice.collector == Collector::TripleCounted {
+                assert_eq!(tiny.table_shape().1, choice.triple_orbits);
+            }
+            let mut solved = false;
