+// ── Choosing a collector ────────────────────────────────────────────
+
+/// The pair collector's expected work at `K` orbits and `t` rows, the
+/// quantity its row rule minimises in [`TinyIc::new_with`]: `t·|F|` table
+/// entries plus `(K + TABLE_PROBES)/(λ₂·cov₂(t))` rests scanned,
+/// `λ₂ = |F|(|F|+1)/(2r)` and `cov₂ = 1 − ((K−t)/K)²`.  Written out here so
+/// the choice below can price a base before sampling it; the collector
+/// itself is not changed and keeps its own copy of the formula
+/// (`pair_work_matches_the_collectors_row_rule` holds the two together).
+fn pair_work(n: u32, r: u64, orbits: usize, rows: usize) -> f64 {
+    let size = (2 * n as usize * orbits) as f64;
+    let lambda = size * (size + 1.0) / 2.0 / r as f64;
+    let rest = (orbits - rows) as f64 / orbits as f64;
+    let cov = 1.0 - rest * rest;
+    rows as f64 * size + (orbits as f64 + TABLE_PROBES) / (lambda * cov).max(1e-12)
+}
+
+/// Rows minimising [`pair_work`] at `orbits`, with that work; ties go to
+/// the fewer rows, as the collector's `min_by` does.
+fn pair_rows_work(n: u32, r: u64, orbits: usize) -> (usize, f64) {
+    let mut best = (1, pair_work(n, r, orbits, 1));
+    for rows in 2..=orbits {
+        let w = pair_work(n, r, orbits, rows);
+        if w < best.1 {
+            best = (rows, w);
+        }
+    }
+    best
+}
+
+/// The orbit count the pair collector will sample for a job asking for
+/// `points` base points: the base policy's count where it asks for more than
+/// one batch, otherwise whole batches of eight orbits until `2n·K ≥ points`.
+/// A prediction made before sampling: a small group can merge two draws into
+/// one orbit (`n13a0` samples seven), which the choice does not wait for.
+fn pair_orbits_planned(n: u32, r: u64, points: usize) -> usize {
+    let policy = policy_orbits(r);
+    if policy > 8 {
+        return policy;
+    }
+    let per_batch = 8 * 2 * n as usize;
+    8 * points.max(1).div_ceil(per_batch)
+}
+
+/// What [`choose_collector`] priced, for reports.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CollectorChoice {
+    pub collector: Collector,
+    pub pair_orbits: usize,
+    pub pair_rows: usize,
+    /// [`pair_work`] at the pair plan.
+    pub pair_work: f64,
+    pub triple_orbits: usize,
+    pub triple_rows: usize,
+    /// [`triple_work`] (W₃) at the counted sizing's orbits and rows.
+    pub triple_work: f64,
+}
+
+/// Pair table or triple table, decided per curve before any base point is
+/// drawn, from `(n, r, points)` alone.
+///
+/// Each collector is priced in the same units -- table entries built plus
+/// rests scanned -- by the model it already sizes itself with: the pair
+/// collector's expected work ([`pair_work`]) at its planned base and its own
+/// row rule, and W₃ ([`triple_work`]) at the orbits and rows the counted
+/// sizing chooses ([`counted_orbits`], [`counted_rows`]).  The triple table
+/// is chosen when its modelled work is strictly smaller; a tie keeps the
+/// pair table.  No constant is fitted: the threshold is the two models'
+/// break-even.  The chosen collector then runs exactly as it runs alone.
+pub fn choose_collector(n: u32, r: u64, points: usize) -> CollectorChoice {
+    let pair_orbits = pair_orbits_planned(n, r, points);
+    let (pair_rows, pair_w) = pair_rows_work(n, r, pair_orbits);
+    let triple_orbits = counted_orbits(n, r);
+    let triple_rows = counted_rows(n, r, triple_orbits);
+    let triple_w = triple_work(n, r, triple_orbits, triple_rows);
+    CollectorChoice {
+        collector: if triple_w < pair_w { Collector::TripleCounted } else { Collector::Pair },
+        pair_orbits,
+        pair_rows,
+        pair_work: pair_w,
+        triple_orbits,
+        triple_rows,
+        triple_work: triple_w,
+    }
+}
