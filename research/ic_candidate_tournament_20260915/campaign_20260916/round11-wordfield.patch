+/// Carry-less `a · b` of two words as `(low, high)`, without hardware help.
+fn clmul64_soft(a: u64, b: u64) -> (u64, u64) {
+    let mut lo = 0u64;
+    let mut hi = 0u64;
+    for i in 0..64u32 {
+        if (b >> i) & 1 == 1 {
+            lo ^= a << i;
+            if i > 0 {
+                hi ^= a >> (64 - i);
             }
         }
     }
+    (lo, hi)
