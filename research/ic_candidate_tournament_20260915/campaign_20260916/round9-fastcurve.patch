+/// The deterministic abscissa sequence a generator is searched along:
+/// every `i < 2^n` in order when exhaustive, otherwise a fixed LCG.
+#[derive(Clone, Copy)]
+struct GeneratorSearch {
+    exhaustive: bool,
+    budget: u64,
+    mask: u64,
+    state: u64,
+    n: u32,
+}
+
+impl GeneratorSearch {
+    fn abscissae(self) -> impl Iterator<Item = u64> {
+        let mut state = self.state;
+        (0..self.budget).map(move |i| {
+            if self.exhaustive {
+                i
+            } else {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+                state & self.mask
+            }
+        })
+    }
+}
+
+/// The first point of the search sequence whose cofactor multiple is a
+/// non-trivial point of order `r`, in the general arithmetic.
+fn find_generator_general(
+    curve: &BinaryCurve,
+    cofactor: &BigUint,
+    r: &BigUint,
+    search: &GeneratorSearch,
+) -> Option<BinaryPoint> {
+    for raw in search.abscissae() {
+        let x = F2mElement::from_biguint(&BigUint::from(raw), search.n);
+        for p in points_with_x(curve, &x) {
+            let cand = scalar_mul(curve, &p, cofactor);
+            if cand != BinaryPoint::Infinity && scalar_mul(curve, &cand, r) == BinaryPoint::Infinity {
+                return Some(cand);
+            }
+        }
+    }
+    None
+}
+
+/// [`find_generator_general`] in single-word arithmetic: the same
+/// abscissae in the same order, the same lifts in the same order
+/// (`factor_base_points_with_x` reproduces `points_with_x`), the same
+/// tests, so the same generator.  `None` when the field is too wide or
+/// the search fails, and the general search then decides.
+fn find_generator_fast(
+    curve: &BinaryCurve,
+    cofactor: &BigUint,
+    r: &BigUint,
+    search: &GeneratorSearch,
+) -> Option<BinaryPoint> {
+    let fc = FastCurve::new(curve)?;
+    for raw in search.abscissae() {
+        let x = F2mElement::from_biguint(&BigUint::from(raw), search.n);
+        for p in factor_base_points_with_x(curve, &x) {
+            let cand = fc.mul(fc.lift(&p), cofactor);
+            if !cand.infinity && fc.mul(cand, r).infinity {
+                return Some(fc.lower(cand));
+            }
+        }
+    }
+    None
+}
