 /// Trial-division factorisation into `(prime, exponent)` pairs.  Only
 /// ever called on `#E` for toy `n`.
 fn factorise(mut v: BigUint) -> Vec<(BigUint, u32)> {
+    // The same trial division in one word when the value fits.
+    if let Some(mut w) = v.to_u64_digits().first().copied().filter(|_| v.bits() <= 64) {
+        let mut out: Vec<(BigUint, u32)> = Vec::new();
+        let mut d = 2u64;
+        while d.checked_mul(d).is_some_and(|dd| dd <= w) {
+            let mut e = 0;
+            while w % d == 0 {
+                w /= d;
+                e += 1;
+            }
+            if e > 0 {
+                out.push((BigUint::from(d), e));
+            }
+            d += 1;
+        }
+        if w > 1 {
+            out.push((BigUint::from(w), 1));
+        }
+        return out;
+    }
