+    /// The single-word generator search and eigenvalue check return
+    /// exactly what the general arithmetic returns, on every cell the
+    /// worker accepts and on a subfield curve.
+    #[test]
+    fn fast_construction_matches_general() {
+        let mut checked = 0;
+        let mut curves: Vec<KoblitzCurve> = (5..=31).step_by(2)
+            .flat_map(|n| [0u8, 1].into_iter().filter_map(move |a| KoblitzCurve::new(a, n)))
+            .collect();
+        curves.extend(KoblitzCurve::subfield(3, 15, 2, 1));
+        for kc in &curves {
+            let mask = if kc.n >= 64 { u64::MAX } else { (1u64 << kc.n) - 1 };
+            let exhaustive = kc.n <= 24;
+            let mut state = 0x9e37_79b9_7f4a_7c15u64 ^ (kc.n as u64) ^ ((kc.a as u64) << 32);
+            if kc.k > 1 {
+                state ^= (u64::from(kc.k) << 40) ^ (kc.b_index << 48);
+            }
+            let search = GeneratorSearch {
+                exhaustive,
+                budget: if exhaustive { 1u64 << kc.n } else { 1u64 << 20 },
+                mask,
+                state,
+                n: kc.n,
+            };
+            let general = find_generator_general(&kc.curve, &kc.cofactor, &kc.subgroup_order, &search);
+            let fast = find_generator_fast(&kc.curve, &kc.cofactor, &kc.subgroup_order, &search);
+            assert_eq!(general, fast, "generator on {}", kc.label());
+            assert_eq!(general.as_ref(), Some(kc.generator()), "constructed generator on {}", kc.label());
+            // both eigenvalue candidates, checked in both arithmetics
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let g = fc.lift(kc.generator());
+            let pi = fc.frobenius_k(g, kc.k);
+            let pi_general = kc.frobenius(kc.generator());
+            for candidate in [kc.lambda.clone(), (&kc.subgroup_order - &kc.lambda) % &kc.subgroup_order,
+                              (&kc.lambda + BigUint::one()) % &kc.subgroup_order] {
+                let fast_ok = fc.mul(g, &candidate) == pi;
+                let general_ok = scalar_mul(&kc.curve, kc.generator(), &candidate) == pi_general;
+                assert_eq!(fast_ok, general_ok, "eigenvalue check on {}", kc.label());
+            }
+            assert_eq!(fc.mul(g, &kc.lambda), pi, "lambda on {}", kc.label());
+            // one-word and big-integer trial division agree
+            let big = &kc.group_order * BigUint::from(1u64 << 40);
+            let small = factorise(kc.group_order.clone());
+            let product = small.iter().fold(BigUint::one(), |acc, (p, e)| acc * p.pow(*e));
+            assert_eq!(product, kc.group_order);
+            assert_eq!(factorise(big.clone()).iter().fold(BigUint::one(), |acc, (p, e)| acc * p.pow(*e)), big);
+            assert_eq!(small.last().map(|(p, _)| p.clone()), Some(kc.subgroup_order.clone()));
+            checked += 1;
+        }
+        assert!(checked >= 15, "{checked}");
+    }
