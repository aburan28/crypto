+/// Orbits for a subgroup of order `r`: `8 * round((r / 4,196,903)^0.157)`,
+/// never fewer than one batch.  The exponent is the growth of the measured
+/// optima (8, 16, 24 orbits across 1100x in `r`, round 0022), not the
+/// pair-table model's `r^(1/3)`, which predicts 30 and 83 and measured worse.
+fn policy_orbits(r: u64) -> usize {
+    let scale = ((r as f64) / 4_196_903.0).powf(0.157).max(1.0);
+    8 * (scale.round() as usize).max(1)
+}
+
+#[cfg(test)]
+mod policy_tests {
+    use super::policy_orbits;
+
+    #[test]
+    fn policy_is_one_batch_across_the_whole_panel_and_grows_beyond_it() {
+        for r in [2_003u64, 42_457, 65_587, 130_873, 262_543, 1_439_393, 2_095_853, 4_196_903] {
+            assert_eq!(policy_orbits(r), 8, "panel r = {r}");
+        }
+        assert_eq!(policy_orbits(230_603_167), 16);
+        assert_eq!(policy_orbits(4_644_189_029), 24);
+        assert_eq!(policy_orbits(10_063_074_221), 24);
+        assert_eq!(policy_orbits(11_514_943_771), 24);
+    }
+}
