+/// A López–Dahab projective point `(X : Y : Z)`, the affine
+/// `(X/Z, Y/Z²)`; `Z = 0` is `O`.
+struct LdPoint {
+    x: F2mElement,
+    y: F2mElement,
+    z: F2mElement,
+}
+
+impl LdPoint {
+    fn infinity(m: u32) -> Self {
+        Self { x: F2mElement::one(m), y: F2mElement::zero(m), z: F2mElement::zero(m) }
+    }
+}
+
+/// `[2]P` (Hankerson–Menezes–Vanstone, Algorithm 3.24).
+fn ld_double(curve: &BinaryCurve, p: &LdPoint) -> LdPoint {
+    let irr = &curve.irreducible;
+    if p.z.is_zero() {
+        return LdPoint::infinity(curve.m);
+    }
+    let z2 = p.z.square(irr);
+    let x2 = p.x.square(irr);
+    let z3 = x2.mul(&z2, irr);
+    if z3.is_zero() {
+        // `x = 0`: the point has order two.
+        return LdPoint::infinity(curve.m);
+    }
+    let bz4 = curve.b.mul(&z2.square(irr), irr);
+    let x3 = x2.square(irr).add(&bz4);
+    let inner = curve.a.mul(&z3, irr).add(&p.y.square(irr)).add(&bz4);
+    let y3 = bz4.mul(&z3, irr).add(&x3.mul(&inner, irr));
+    LdPoint { x: x3, y: y3, z: z3 }
+}
+
+/// Mixed addition `P + Q` with `Q = (qx, qy)` affine (Algorithm 3.25).
+/// The degenerate cases (`Q = ±P`) go through the affine formulas.
+fn ld_add_affine(curve: &BinaryCurve, p: &LdPoint, qx: &F2mElement, qy: &F2mElement) -> LdPoint {
+    let irr = &curve.irreducible;
+    if p.z.is_zero() {
+        return LdPoint { x: qx.clone(), y: qy.clone(), z: F2mElement::one(curve.m) };
+    }
+    let z1sq = p.z.square(irr);
+    let a = qy.mul(&z1sq, irr).add(&p.y);
+    let b = qx.mul(&p.z, irr).add(&p.x);
+    if b.is_zero() {
+        let q = BinaryPoint::Affine { x: qx.clone(), y: qy.clone() };
+        return match point_add(curve, &ld_to_affine(curve, p), &q) {
+            BinaryPoint::Infinity => LdPoint::infinity(curve.m),
+            BinaryPoint::Affine { x, y } => LdPoint { x, y, z: F2mElement::one(curve.m) },
+        };
+    }
+    let c = p.z.mul(&b, irr);
+    let d = b.square(irr).mul(&c.add(&curve.a.mul(&z1sq, irr)), irr);
+    let z3 = c.square(irr);
+    let e = a.mul(&c, irr);
+    let x3 = a.square(irr).add(&d).add(&e);
+    let f = x3.add(&qx.mul(&z3, irr));
+    let g = qx.add(qy).mul(&z3.square(irr), irr);
+    let y3 = e.add(&z3).mul(&f, irr).add(&g);
+    LdPoint { x: x3, y: y3, z: z3 }
+}
+
+/// `(X : Y : Z) ↦ (X/Z, Y/Z²)`: the one inversion of a product.
+fn ld_to_affine(curve: &BinaryCurve, p: &LdPoint) -> BinaryPoint {
+    let irr = &curve.irreducible;
+    if p.z.is_zero() {
+        return BinaryPoint::Infinity;
+    }
+    let zi = p.z.flt_inverse(irr).expect("non-zero Z");
+    BinaryPoint::Affine { x: p.x.mul(&zi, irr), y: p.y.mul(&zi.square(irr), irr) }
+}
