+    /// One representative point per signed Frobenius orbit, in orbit order:
+    /// entry `o` is `points[index(o, 0, false)]`, from which the whole base
+    /// regenerates as `+Frob^k(R), -Frob^k(R)` for `k < n`. The checker
+    /// performs that expansion itself, so a report carrying these instead of
+    /// the full base names the same base with `2n` times fewer points.
+    pub fn orbit_representatives(&self) -> Vec<(u64, u64)> {
+        (0..self.columns.len())
+            .map(|o| self.points[self.index(o as u32, 0, false)])
+            .map(|p| (p.x, p.y))
+            .collect()
+    }
+
     #[inline]
     fn index(&self, orbit: u32, k: u32, negated: bool) -> usize {
