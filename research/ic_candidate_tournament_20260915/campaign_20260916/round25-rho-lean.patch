+/// `(w, ⌊w·2^64/m⌋)` for a fixed multiplier `w < m`.
+fn shoup_quotient(w: u64, m: u64) -> (u64, u64) {
+    (w, (((w as u128) << 64) / m as u128) as u64)
+}
+
+/// `a·w mod m` for `a < m < 2^63`, from [`shoup_quotient`]: the estimate
+/// `⌊a·w'/2^64⌋` is the true quotient or one less, so one conditional
+/// subtraction finishes it.  Equal to [`mulmod_u64`].
+#[inline]
+fn shoup_mulmod(a: u64, (w, quotient): (u64, u64), m: u64) -> u64 {
+    let q = ((a as u128 * quotient as u128) >> 64) as u64;
+    let r = a.wrapping_mul(w).wrapping_sub(q.wrapping_mul(m));
+    if r >= m { r - m } else { r }
+}
+
+/// `(a + b) mod m` for `a, b < m < 2^63`.
+#[inline]
+fn addmod_u64(a: u64, b: u64, m: u64) -> u64 {
+    let s = a + b;
+    if s >= m { s - m } else { s }
+}
