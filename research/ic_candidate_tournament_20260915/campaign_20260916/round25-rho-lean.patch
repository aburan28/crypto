+    /// The lean setup's batched fixed-base points are the matched setup's
+    /// double-and-add points, and its candidate check agrees with the
+    /// general arithmetic.
+    #[test]
+    fn lean_rho_setup_points_match_double_and_add() {
+        for (a, n) in [(0u8, 13u32), (1, 23), (1, 43), (1, 61)] {
+            let kc = KoblitzCurve::new(a, n).unwrap();
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let r = kc.subgroup_order.to_u64_digits()[0];
+            let d = BigUint::from(r / 3 + 1);
+            let target = kc.mul(kc.generator(), &d);
+            let (g, q) = (fc.lift(kc.generator()), fc.lift(&target));
+            let lambda = (&kc.lambda % &kc.subgroup_order).to_u64_digits()[0];
+            let lambda_pow: Vec<u64> = (0..n)
+                .scan(1u64, |c, _| {
+                    let v = *c;
+                    *c = mulmod_u64(*c, lambda, r);
+                    Some(v)
+                })
+                .collect();
+            let lean = LeanRho::new(&kc, g, q, r, &lambda_pow).unwrap();
+            for (k, &l) in lambda_pow.iter().enumerate() {
+                for (s, w) in [(0, l), (1, r - l)] {
+                    assert_eq!(lean.factor_quotient[2 * k + s].0, w);
+                    for &a in &[0, 1, r / 2, r - 1, (k as u64 * 0x9e37_79b9) % r] {
+                        assert_eq!(shoup_mulmod(a, lean.factor_quotient[2 * k + s], r), mulmod_u64(a, w, r));
+                    }
+                }
+            }
+            let mut state = 0x243f_u64 ^ u64::from(n);
+            let mut scalars = vec![(1, 1), (r - 1, 1), (1, r - 1), (r - 1, r - 1)];
+            for _ in 0..60 {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                let x = (state >> 11) % (r - 1) + 1;
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                scalars.push((x, (state >> 11) % (r - 1) + 1));
+            }
+            let points = lean.setup_points(&scalars);
+            for (&(x, y), &p) in scalars.iter().zip(&points) {
+                assert_eq!(p, fc.add(fc.mul_u64(g, x), fc.mul_u64(q, y)), "n={n} ({x}, {y})");
+            }
+            assert!(lean.is_log(&d));
+            assert!(!lean.is_log(&(&d + 1u32)));
+        }
+    }
