+                let q = kc.mul(kc.generator(), &d);
+                let options = KoblitzSignedRhoOptions {
+                    seed: seed ^ (i as u64) << 32,
+                    progress_interval: 64,
+                    parallel_walks,
+                    ..KoblitzSignedRhoOptions::default()
