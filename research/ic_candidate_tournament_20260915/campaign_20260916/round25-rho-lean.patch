+
+/// **The lean walk's arithmetic.**  The same walk, the same points, the
+/// same coefficients and the same ledger as the matched walk; only how
+/// each value is computed changes, and every change uses what the IC arm
+/// already uses for the same job:
+///
+/// - field multiplication, squaring and inversion are the IC arm's
+///   (`koblitz_tiny_ic::Arith`): a carry-less squaring and a Euclidean
+///   inverse, where the matched walk used a bit-spreading squaring and a
+///   Fermat inverse of `n` squarings and `n` multiplications;
+/// - the setup points `[a]G + [b]Q` come from doubling tables of `G` and
+///   `Q` with the additions of one bit position sharing one inversion
+///   (`Arith::fixed_base_mul_many`, the IC arm's fixed-base product),
+///   instead of two López–Dahab double-and-add products and three
+///   inversions per point; the scalars are drawn in the same order;
+/// - a collision's candidate `d` is checked as `[d]G = Q` in the same
+///   single-word arithmetic from the table of `G`, as the IC arm checks its
+///   own candidates (the worker still re-verifies the reported log in the
+///   general arithmetic, as before).
+struct LeanRho {
+    arith: crate::cryptanalysis::koblitz_tiny_ic::Arith,
+    /// `[2^i]G` and `[2^i]Q` for every bit of the subgroup order.
+    g_table: Vec<FastPoint>,
+    q_table: Vec<FastPoint>,
+    target: FastPoint,
+    /// For every `k < n`, the canonical form's two coefficient factors
+    /// `λ^k` and `−λ^k mod r`, each with its Shoup quotient, at
+    /// `2k` and `2k + 1`.
+    factor_quotient: Vec<(u64, u64)>,
+}
+
+impl LeanRho {
+    fn new(
+        curve: &KoblitzCurve,
+        g: FastPoint,
+        q: FastPoint,
+        modulus: u64,
+        lambda_pow: &[u64],
+    ) -> Option<Self> {
+        if g.infinity || q.infinity || modulus >= 1 << 62 {
+            return None;
+        }
+        let arith = crate::cryptanalysis::koblitz_tiny_ic::Arith::new(curve)?;
+        let bits = 64 - modulus.leading_zeros();
+        let g_table = arith.doubling_table(g, bits);
+        let q_table = arith.doubling_table(q, bits);
+        let factor_quotient = lambda_pow
+            .iter()
+            .flat_map(|&l| {
+                let negated = if l == 0 { 0 } else { modulus - l };
+                [shoup_quotient(l, modulus), shoup_quotient(negated, modulus)]
+            })
+            .collect();
+        Some(Self { arith, g_table, q_table, target: q, factor_quotient })
+    }
+
+    /// `[a_i]G + [b_i]Q` for every pair, in order.
+    fn setup_points(&self, scalars: &[(u64, u64)]) -> Vec<FastPoint> {
+        let a: Vec<u64> = scalars.iter().map(|s| s.0).collect();
+        let b: Vec<u64> = scalars.iter().map(|s| s.1).collect();
+        let ag = self.arith.fixed_base_mul_many(&self.g_table, &a);
+        let bq = self.arith.fixed_base_mul_many(&self.q_table, &b);
+        let mut dens: Vec<u64> = ag
+            .iter()
+            .zip(&bq)
+            .map(|(p, q)| if p.infinity || q.infinity || p.x == q.x { 0 } else { p.x ^ q.x })
+            .collect();
+        let mut scratch = Vec::with_capacity(dens.len());
+        self.arith.batch_inv(&mut dens, &mut scratch);
+        ag.iter()
+            .zip(&bq)
+            .zip(&dens)
+            .map(|((&p, &q), &inv)| {
+                if inv == 0 {
+                    self.arith.add(p, q)
+                } else {
+                    self.arith.add_with_lambda(p, q, self.arith.mul(p.y ^ q.y, inv))
+                }
+            })
+            .collect()
+    }
+
+    /// Whether `[d]G = Q`.
+    fn is_log(&self, d: &BigUint) -> bool {
+        d.bits() <= self.g_table.len() as u64
+            && self.arith.fixed_base_mul(&self.g_table, d.to_u64_digits().first().copied().unwrap_or(0))
+                == self.target
+    }
 }
 
