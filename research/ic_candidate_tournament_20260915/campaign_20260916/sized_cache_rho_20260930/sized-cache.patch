 /// points is what catches a repeat further back than that.
 const RECENT_SLOTS: usize = 1 << 12;
 
+/// Slots of the recent-point cache for a walk expected to take
+/// `expected_steps` steps: four times that, rounded up to a power of two,
+/// between 64 and `RECENT_SLOTS`.  A small group's walk is a few hundred
+/// steps, and zero-filling the full cache on every solve costs more than
+/// the walk.  From about 1,000 expected steps on the size is `RECENT_SLOTS`
+/// again, so larger cells run exactly as before.
+fn rho_recent_slots(expected_steps: f64) -> usize {
+    ((4.0 * expected_steps).ceil() as usize)
+        .next_power_of_two()
+        .clamp(64, RECENT_SLOTS)
+}
