 #[cfg(test)]
 mod tests {
+    #[test]
+    fn the_orbit_name_from_zero_runs_equals_the_rotation_loop() {
+        // Every width the pipeline runs (and up to a whole word), random
+        // and sparse words, the all-ones word, powers of two and periodic
+        // words: the same least rotation and the same least index.
+        for n in (5..=31).chain([33, 47, 62]) {
+            let basis = super::NormalBasis { n, mask: (1u64 << n) - 1, tables: (0..((n + 3) / 4) as usize).map(|i| {
+                let mut t = [0u64; 16];
+                for (b, slot) in t.iter_mut().enumerate() {
+                    *slot = ((b as u64) << (4 * i)) & ((1u64 << n) - 1);
+                }
+                t
+            }).collect() };
+            let mask = (1u64 << n) - 1;
+            let mut state = 0x243f_6a88_85a3_08d3u64 ^ u64::from(n);
+            let mut words: Vec<u64> = vec![0, mask, 1, 1 << (n - 1), mask ^ 1, mask >> 1];
+            let period = |p: u32| {
+                let mut w = 0u64;
+                let mut i = 0;
+                while i < n {
+                    w |= 1 << i;
+                    i += p;
+                }
+                w & mask
+            };
+            words.extend((1..=n).filter(|p| n % p == 0).map(period));
+            for _ in 0..3000 {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                words.push(state & mask);
+                words.push(state & (state >> 11) & (state >> 23) & mask);
+                words.push(!(state & (state >> 5)) & mask);
+            }
+            for &w in &words {
+                assert_eq!(basis.canon(w), basis.canon_reference(w), "n={n} word={w:#b}");
+            }
+        }
+    }
