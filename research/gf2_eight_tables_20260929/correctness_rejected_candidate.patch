+/// Use eight tables only on large matrices whose logical table fits in 4 MiB.
+pub fn effective_tables(config: Config, rows: usize, n_cols: usize) -> usize {
+    if config.tables != 8 {
+        return config.tables.clamp(1, 4);
+    }
+    let bytes = 8usize
+        .checked_mul(1usize << table_bits(rows))
+        .and_then(|n| n.checked_mul(n_cols.div_ceil(64)))
+        .and_then(|n| n.checked_mul(std::mem::size_of::<u64>()));
+    if rows >= 4000 && n_cols >= 4096 && bytes.is_some_and(|n| n <= EIGHT_TABLE_BUDGET) {
+        8
+    } else {
+        DEFAULT_TABLES
+    }
+}
