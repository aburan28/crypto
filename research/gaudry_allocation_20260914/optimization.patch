     #[test]
+    fn normal_forms_preserve_relations_and_reuse_completed_dependencies() {
+        let p = 67;
+        let mut rng = StdRng::seed_from_u64(20260914);
+        for (rows, cols) in [(1, 4), (6, 9), (9, 6)] {
+            for _ in 0..12 {
+                let mut input: Vec<Vec<u64>> = (0..rows)
+                    .map(|_| (0..cols).map(|_| rng.gen_range(0..p)).collect())
+                    .collect();
+                // Include dependent rows and a free leading column.
+                if rows > 1 { input[rows - 1] = input[0].clone(); }
+                for row in &mut input { row[0] = 0; }
+                let mut echelon = input.clone();
+                let mut muls = 0;
+                let pivots = echelon_mod_p(&mut echelon, p, &mut muls);
+                let standard: HashMap<usize, usize> = (0..cols)
+                    .filter(|c| !pivots.contains(c)).enumerate()
+                    .map(|(i, c)| (c, i)).collect();
+                let dim = standard.len();
+                let mut nfs = NormalForms::new(&echelon, &pivots, &standard, dim, p);
+                let forms: Vec<Vec<u64>> = (0..cols)
+                    .map(|c| nfs.nf(c, &mut muls).unwrap().to_vec()).collect();
+                // Every original linear relation must vanish in the quotient.
+                for row in &input {
+                    for k in 0..dim {
+                        assert_eq!(row.iter().enumerate().fold(0, |acc, (c, &a)|
+                            am(acc, mm(a, forms[c][k], p), p)), 0);
+                    }
+                }
+                let before = muls;
+                for c in (0..cols).rev() {
+                    assert_eq!(nfs.nf(c, &mut muls).unwrap(), forms[c]);
+                }
+                assert_eq!(muls, before, "cache hits must perform no field products");
+            }
+        }
+        // An unavailable border column must remain a failed lookup, even if
+        // a previous call populated other dependencies.
+        let matrix = vec![vec![1, 1, 1], vec![0, 1, 0]];
+        let mut nfs = NormalForms::new(&matrix, &[0, 1], &HashMap::new(), 0, p);
+        let mut muls = 0;
+        assert!(nfs.nf(1, &mut muls).is_some());
+        assert!(nfs.nf(0, &mut muls).is_none());
+        assert!(nfs.nf(0, &mut muls).is_none());
+    }
