\\ Independently replay the short-coordinate models with PARI ellchangecurve.
cv(v,z)=sum(i=1,#v,v[i]*z^(i-1));
check_models(p,k,m,lambda,sa,sb,sj,ta,tb,tj)={my(z=ffgen(Mod(1,p)*Polrev(concat(m,[1])),'z),lam=cv(lambda,z),E=ellinit([0,-(1+lam),0,lam,0],z),Ep=ellinit([0,2*(1+lam),0,(1-lam)^2,0],z));my(S=ellchangecurve(E,[1,-E.a2/3,0,0]),T=ellchangecurve(Ep,[1,-Ep.a2/3,0,0]));if(S.a2||T.a2||S.a4!=cv(sa,z)||S.a6!=cv(sb,z)||S.j!=cv(sj,z)||T.a4!=cv(ta,z)||T.a6!=cv(tb,z)||T.j!=cv(tj,z),error("short model replay failed"));print("p=",p,",degree=",k,",short_model_pair=EXACT_MATCH");};
