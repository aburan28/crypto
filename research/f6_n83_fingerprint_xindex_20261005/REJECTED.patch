+/// Most misses compare only an in-slot fingerprint. A matching fingerprint
+/// always checks the full x coordinate owned by the signed-sum array.
+struct FingerprintXIndex {
+    slots: Vec<u64>,
+}
+
+impl FingerprintXIndex {
+    const EMPTY: u64 = u64::MAX;
+    const FINGERPRINT: u64 = 0xffff_ffff_0000_0000;
+
+    fn new(pair_count: usize) -> Option<Self> {
+        let capacity = pair_count
+            .div_ceil(2)
+            .checked_mul(2)?
+            .max(8)
+            .checked_next_power_of_two()?;
+        Some(Self {
+            slots: vec![Self::EMPTY; capacity],
+        })
+    }
+
+    #[inline]
+    fn hash(x: u128) -> u64 {
+        let mut value = (x as u64) ^ ((x >> 64) as u64).rotate_left(23);
+        value ^= value >> 30;
+        value = value.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        value ^= value >> 27;
+        value = value.wrapping_mul(0x94d0_49bb_1331_11eb);
+        value ^= value >> 31;
+        value
+    }
+
+    #[inline]
+    fn probe(&self, x: u128, sums: &[SignedPairSum]) -> (usize, bool) {
+        let mask = self.slots.len() - 1;
+        let hash = Self::hash(x);
+        let mut slot = (hash as usize) & mask;
+        loop {
+            let entry = self.slots[slot];
+            if entry == Self::EMPTY {
+                return (slot, false);
+            }
+            if (entry & Self::FINGERPRINT) == (hash & Self::FINGERPRINT)
+                && sums[(entry as u32) as usize]
+                    .point
+                    .is_some_and(|(stored_x, _)| stored_x == x)
+            {
+                return (slot, true);
+            }
+            slot = (slot + 1) & mask;
+        }
+    }
+
+    #[inline]
+    fn get(&self, x: u128, sums: &[SignedPairSum]) -> Option<usize> {
+        let (slot, found) = self.probe(x, sums);
+        found.then_some((self.slots[slot] as u32) as usize)
+    }
+
+    fn grow(&mut self, sums: &[SignedPairSum]) -> Option<()> {
+        let capacity = self.slots.len().checked_mul(2)?;
+        let mut replacement = Self {
+            slots: vec![Self::EMPTY; capacity],
+        };
+        for &entry in &self.slots {
+            if entry != Self::EMPTY {
+                let index = entry as u32;
+                let x = sums[index as usize].point?.0;
+                let (slot, found) = replacement.probe(x, sums);
+                debug_assert!(!found);
+                replacement.slots[slot] = entry;
+            }
+        }
+        *self = replacement;
+        Some(())
+    }
+
+    fn insert_first(&mut self, x: u128, sums: &[SignedPairSum]) -> Option<bool> {
+        let (mut slot, found) = self.probe(x, sums);
+        if found {
+            return Some(false);
+        }
+        if sums.len().checked_add(1)? > self.slots.len() * 7 / 10 {
+            self.grow(sums)?;
+            slot = self.probe(x, sums).0;
+        }
+        let index = u32::try_from(sums.len()).ok()?;
+        self.slots[slot] = (Self::hash(x) & Self::FINGERPRINT) | u64::from(index);
+        Some(true)
+    }
+}
