+/// Which table a job's relations are found through.
+///
+/// `Pair` stores `C_o + P_j` and scans one summand per probe: three-term
+/// relations, `r^(2/3)` at the balanced optimum.  `Triple` stores
+/// `C_o + P_j + P_l` (`j ≤ l`) and scans one summand per probe: four-term
+/// relations, `r^(3/5)`, so its ratio to rho grows as `r^(1/10)` rather
+/// than `r^(1/6)`.  Everything else -- base sampler, canonical orbit names,
+/// block scan, rows, descent -- is shared.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Collector {
+    Pair,
+    Triple,
+}
+
+impl Collector {
+    /// Base points per relation.
+    pub fn summands(self) -> usize {
+        match self {
+            Collector::Pair => 3,
+            Collector::Triple => 4,
+        }
+    }
+}
+
+/// A stored triple sum `C_o + P_j + P_l`, `j ≤ l`, with the rotation that
+/// names its orbit.  The pair table's entry with one more index.
+#[derive(Clone, Copy)]
+struct TripleEntry {
+    sum_x: u64,
+    sum_y: u64,
+    j: u16,
+    l: u16,
+    orbit: u8,
+    rotation: u8,
+}
+
+impl TripleEntry {
+    #[inline]
+    fn sum(&self) -> FastPoint {
+        FastPoint::affine(self.sum_x, self.sum_y)
+    }
+}
+
+/// [`PairTable`]'s open addressing over triple-sum orbits.
+struct TripleTable {
+    keys: Vec<u64>,
+    slots: Vec<u32>,
+    entries: Vec<TripleEntry>,
+    shift: u32,
+}
+
+impl TripleTable {
+    fn with_capacity(count: usize) -> Self {
+        let bits = (usize::BITS - (2 * count.max(1)).leading_zeros()).max(4);
+        let slots = 1usize << bits;
+        Self {
+            keys: Vec::with_capacity(count),
+            slots: vec![0; slots],
+            entries: Vec::with_capacity(count),
+            shift: 64 - bits,
+        }
+    }
+
+    #[inline]
+    fn slot(&self, key: u64) -> usize {
+        (key.wrapping_mul(0x9e37_79b9_7f4a_7c15) >> self.shift) as usize
+    }
+
+    fn insert(&mut self, key: u64, entry: TripleEntry) {
+        let mask = self.slots.len() - 1;
+        let mut i = self.slot(key);
+        loop {
+            let s = self.slots[i];
+            if s == 0 {
+                self.keys.push(key);
+                self.entries.push(entry);
+                self.slots[i] = self.entries.len() as u32;
+                return;
+            }
+            if self.keys[s as usize - 1] == key {
+                return;
+            }
+            i = (i + 1) & mask;
+        }
+    }
+
+    #[inline]
+    fn get(&self, key: u64) -> Option<&TripleEntry> {
+        let mask = self.slots.len() - 1;
+        let mut i = self.slot(key);
+        loop {
+            let s = self.slots[i];
+            if s == 0 {
+                return None;
+            }
+            if self.keys[s as usize - 1] == key {
+                return Some(&self.entries[s as usize - 1]);
+            }
+            i = (i + 1) & mask;
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.entries.len()
+    }
+}
+
+/// The triple collector's expected work at `K` orbits and `t` rows, in
+/// the pair model's own units: a row costs `|F|(|F|+1)/2` entries, and a
+/// probe scans `1/(λ₃·cov₃(t))` rests, `λ₃ = C(|F|+2, 3)/r` being the
+/// expected triple-sum witnesses of a rest and `cov₃ = 1 − ((K−t)/K)³` the
+/// fraction of triples with a summand in a built row.
+fn triple_work(n: u32, r: u64, orbits: usize, rows: usize) -> f64 {
+    let size = (2 * n as usize * orbits) as f64;
+    let lambda = size * (size + 1.0) * (size + 2.0) / 6.0 / r as f64;
+    let rest = (orbits - rows) as f64 / orbits as f64;
+    let cov = 1.0 - rest * rest * rest;
+    rows as f64 * size * (size + 1.0) / 2.0
+        + (orbits as f64 + TABLE_PROBES) / (lambda * cov).max(1e-12)
+}
+
+/// Rows minimising [`triple_work`] at `orbits`.
+fn triple_rows(n: u32, r: u64, orbits: usize) -> usize {
+    (1..=orbits)
+        .min_by(|&a, &b| triple_work(n, r, orbits, a).total_cmp(&triple_work(n, r, orbits, b)))
+        .unwrap_or(orbits)
+}
+
+/// Orbits for the triple collector: the `K` minimising its expected work,
+/// never fewer than two -- the certificate checker needs more than one
+/// column -- and never more than the packed entry can index.
+fn triple_orbits(n: u32, r: u64) -> usize {
+    let limit = (usize::from(u16::MAX) / (2 * n as usize)).min(usize::from(u8::MAX)).min(64);
+    (2..=limit.max(2))
+        .min_by(|&a, &b| {
+            triple_work(n, r, a, triple_rows(n, r, a)).total_cmp(&triple_work(n, r, b, triple_rows(n, r, b)))
+        })
+        .unwrap_or(2)
+}
