+/// The triple collector's expected work counted rather than modelled: table
+/// entries plus rests scanned.  A fresh target is found exactly when it is a
+/// sum of four base points with a summand in one of the first `rows` orbits,
+/// which happens with chance `p = 1 − exp(−[C(|F|+3,4) − C(|F|−2n·rows+3,4)]/r)`;
+/// it needs `K` relations for rank and one descent, and each target costs
+/// `|F|` rests.  W₃ ([`triple_work`]) models `|F|·C(|F|+2,3)/r` witnesses a
+/// target, about four times the four-sums that exist.
+fn counted_work(n: u32, r: u64, orbits: usize, rows: usize) -> f64 {
+    let size = (2 * n as usize * orbits) as f64;
+    let rest = size - (2 * n as usize * rows) as f64;
+    let four = |m: f64| m * (m + 1.0) * (m + 2.0) * (m + 3.0) / 24.0;
+    let p = -(-(four(size) - four(rest)) / r as f64).exp_m1();
+    rows as f64 * size * (size + 1.0) / 2.0 + (orbits as f64 + 1.0) * size / p.max(1e-300)
+}
+
+/// Rows minimising [`counted_work`] at `orbits`, with that work.  The table
+/// term grows with the row count, so the search stops once one more row's
+/// table alone exceeds the best total.
+fn counted_rows_work(n: u32, r: u64, orbits: usize) -> (usize, f64) {
+    let size = (2 * n as usize * orbits) as f64;
+    let mut best = (1, counted_work(n, r, orbits, 1));
+    for rows in 2..=orbits {
+        if rows as f64 * size * (size + 1.0) / 2.0 >= best.1 {
+            break;
+        }
+        let w = counted_work(n, r, orbits, rows);
+        if w < best.1 {
+            best = (rows, w);
+        }
+    }
+    best
+}
+
+/// Rows for the counted collector at `orbits`.
+fn counted_rows(n: u32, r: u64, orbits: usize) -> usize {
+    counted_rows_work(n, r, orbits).0
+}
+
+/// Orbits for the counted collector: the `K ≥ 2` minimising [`counted_work`]
+/// at its own rows, under the same ceiling as [`triple_orbits`].  One row's
+/// table grows with `K`, so the search stops once it alone exceeds the best
+/// total.  A fixed function of `(n, r)`.
+fn counted_orbits(n: u32, r: u64) -> usize {
+    let limit = (usize::from(u16::MAX) / (2 * n as usize)).min(usize::from(u8::MAX)).min(64).max(2);
+    let mut best = (2, counted_rows_work(n, r, 2).1);
+    for k in 3..=limit {
+        let size = (2 * n as usize * k) as f64;
+        if size * (size + 1.0) / 2.0 >= best.1 {
+            break;
+        }
+        let (_, w) = counted_rows_work(n, r, k);
+        if w < best.1 {
+            best = (k, w);
+        }
+    }
+    best.0
+}
