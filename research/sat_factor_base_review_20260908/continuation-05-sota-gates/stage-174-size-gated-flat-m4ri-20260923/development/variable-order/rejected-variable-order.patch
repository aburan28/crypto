+/// Return the old-variable to new-variable map used by the native F4 arm.
+/// Relabelling variables leaves the Boolean variety and algebraic factor base
+/// unchanged, but DegRevLex is sensitive to the order.  The explicit form is
+/// an experimental hook for measured single-target searches; it is always
+/// reported with the result and the default remains the historical identity.
+fn native_f4_variable_order(ell: usize) -> Result<(String, Vec<usize>), String> {
+    let n_vars = 2 * ell;
+    let requested = std::env::var("PQ_F4_VARIABLE_ORDER").unwrap_or_else(|_| "identity".into());
+    let order = match requested.as_str() {
+        "identity" => (0..n_vars).collect(),
+        "reverse" => (0..n_vars).map(|old| n_vars - 1 - old).collect(),
+        "basis-reverse" => (0..n_vars)
+            .map(|old| {
+                let block = old / ell;
+                block * ell + ell - 1 - old % ell
+            })
+            .collect(),
+        "interleave" => (0..n_vars)
+            .map(|old| {
+                let block = old / ell;
+                2 * (old % ell) + block
+            })
+            .collect(),
+        "interleave-basis-reverse" => (0..n_vars)
+            .map(|old| {
+                let block = old / ell;
+                2 * (ell - 1 - old % ell) + block
+            })
+            .collect(),
+        _ => requested
+            .split(',')
+            .map(|value| {
+                value
+                    .parse::<usize>()
+                    .map_err(|_| format!("invalid F4 variable index `{value}`"))
+            })
+            .collect::<Result<Vec<_>, _>>()?,
+    };
+    if order.len() != n_vars {
+        return Err(format!(
+            "F4 variable order has {} entries; expected {n_vars}",
+            order.len()
+        ));
+    }
+    let mut seen = vec![false; n_vars];
+    for &new in &order {
+        if new >= n_vars || std::mem::replace(&mut seen[new], true) {
+            return Err(format!(
+                "F4 variable order must be a permutation of 0..{n_vars}"
+            ));
+        }
+    }
+    Ok((requested, order))
+}
+
+fn sym_element_from_subspace_variable_order(
+    basis: &[F2mElement],
+    old_offset: usize,
+    old_to_new: &[usize],
+    n: u32,
+    n_vars: usize,
+) -> SymElement {
+    let mut coords = vec![Vec::new(); n as usize];
+    for (basis_index, element) in basis.iter().enumerate() {
+        let variable = old_to_new[old_offset + basis_index];
+        let bits = element.raw_bits().first().copied().unwrap_or(0);
+        for (field_index, monomials) in coords.iter_mut().enumerate() {
+            if bits >> field_index & 1 == 1 {
+                monomials.push(F2BoolMono::var(variable as u32));
+            }
+        }
+    }
+    SymElement {
+        coords: coords
+            .into_iter()
+            .map(|monomials| F2BoolPoly::from_monos(monomials, n_vars))
+            .collect(),
+    }
+}
+
+fn solver_root_to_source_order(root: u64, old_to_new: &[usize]) -> u64 {
+    old_to_new
+        .iter()
+        .enumerate()
+        .fold(0u64, |source, (old, &new)| {
+            source | (((root >> new) & 1) << old)
+        })
+}
