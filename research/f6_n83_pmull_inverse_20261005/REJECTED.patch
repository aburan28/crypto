+    /// Itoh–Tsujii inversion for the pinned degree-83 field.
+    ///
+    /// # Safety
+    /// The caller must have checked ARM64 AES/PMULL support and the pinned
+    /// degree-83 irreducible polynomial.
+    #[target_feature(enable = "aes")]
+    pub(super) unsafe fn inverse(a: u128) -> Option<u128> {
+        if a == 0 {
+            return None;
+        }
+        // Build a^(2^82 - 1) by reading the remaining bits of 82 = 0b1010010.
+        let mut beta = a;
+        let mut len = 1;
+        for bit in [0, 1, 0, 0, 1, 0] {
+            let mut shifted = beta;
+            for _ in 0..len {
+                shifted = unsafe { square(shifted) };
+            }
+            beta = unsafe { mul(beta, shifted) };
+            len *= 2;
+            if bit == 1 {
+                beta = unsafe { mul(square(beta), a) };
+                len += 1;
+            }
+        }
+        debug_assert_eq!(len, 82);
+        Some(unsafe { square(beta) })
+    }
