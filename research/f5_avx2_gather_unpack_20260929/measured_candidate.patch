+/// Build a compact lookup only when its actual allocation fits the budget.
+fn compact_gather_columns(cols: &[u64]) -> Option<Vec<u32>> {
+    const MAX_BYTES: usize = 256 * 1024;
+    if cols.len().checked_mul(std::mem::size_of::<u32>())? > MAX_BYTES {
+        return None;
+    }
+    let mut compact = Vec::new();
+    compact.try_reserve_exact(cols.len()).ok()?;
+    if compact.capacity().checked_mul(std::mem::size_of::<u32>())? > MAX_BYTES {
+        return None;
+    }
+    for &mask in cols {
+        compact.push(u32::try_from(mask).ok()?);
+    }
+    Some(compact)
+}
+
+fn packed_row_fits_columns(row: &[u64], cols_len: usize) -> bool {
+    let tail_bits = cols_len % 64;
+    row.len() == cols_len.div_ceil(64)
+        && (tail_bits == 0 || row.last().is_none_or(|&last| last >> tail_bits == 0))
+}
+
+/// Expand four column bits per loop with one AVX2 gather and four wide writes.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2")]
+unsafe fn unpack_row_avx2_gather(row: &[u64], cols: &[u32], n_vars: usize) -> F2BoolPoly {
+    use std::arch::x86_64::{
+        __m256i, _mm256_cvtepu32_epi64, _mm256_storeu_si256, _mm_i32gather_epi32, _mm_setr_epi32,
+    };
+
+    if !packed_row_fits_columns(row, cols.len()) {
+        let wide: Vec<u64> = cols.iter().map(|&mask| mask as u64).collect();
+        return unpack_row_scalar_direct(row, &wide, n_vars);
+    }
+    let terms: usize = row.iter().map(|word| word.count_ones() as usize).sum();
+    let mut monos = Vec::<F2BoolMono>::with_capacity(terms);
+    let out = monos.as_mut_ptr();
+    let mut written = 0;
+    for (w, &word) in row.iter().enumerate() {
+        let base = w * 64;
+        let mut bits = word;
+        let mut groups = bits.count_ones() / 4;
+        while groups != 0 {
+            let c0 = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            let c1 = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            let c2 = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            let c3 = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            let indices = _mm_setr_epi32(c0 as i32, c1 as i32, c2 as i32, c3 as i32);
+            // SAFETY: all four set bits name columns after the row-width
+            // and padding check; each column index fits i32 under the cap.
+            let gathered = unsafe { _mm_i32gather_epi32(cols.as_ptr().cast(), indices, 4) };
+            let wide = _mm256_cvtepu32_epi64(gathered);
+            // SAFETY: the precomputed popcount reserves these four slots;
+            // F2BoolMono is transparent over u64 and the store is unaligned.
+            unsafe { _mm256_storeu_si256(out.add(written).cast::<__m256i>(), wide) };
+            written += 4;
+            groups -= 1;
+        }
+        while bits != 0 {
+            let column = base + bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            // SAFETY: the row-width check covers all set bits and the
+            // remaining output slot is in the precomputed popcount.
+            let mask = unsafe { *cols.get_unchecked(column) } as u64;
+            unsafe { out.add(written).write(F2BoolMono::from_mask(mask)) };
+            written += 1;
+        }
+    }
+    debug_assert_eq!(written, terms);
+    // SAFETY: every output slot was written exactly once.
+    unsafe { monos.set_len(terms) };
+    F2BoolPoly {
+        terms: monos,
+        n_vars,
+    }
+}
