 use rayon::prelude::*;
 
+
+fn diag_on() -> bool {
+    std::env::var_os("F4T_DIAG").is_some()
+}
+fn diag_mem() -> String {
+    let s = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let get = |k: &str| {
+        s.lines()
+            .find(|l| l.starts_with(k))
+            .and_then(|l| l.split_whitespace().nth(1))
+            .and_then(|v| v.parse::<u64>().ok())
+            .unwrap_or(0)
+            / 1024
+    };
+    format!("rss {} MB hwm {} MB", get("VmRSS:"), get("VmHWM:"))
+}
