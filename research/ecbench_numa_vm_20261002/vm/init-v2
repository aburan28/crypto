#!/bin/busybox sh
/bin/busybox mkdir -p /proc /sys /dev /tmp /out /root
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox --install -s /bin
export PATH=/bin HOME=/root
echo "=== ECBENCH-VM-BEGIN"
echo "cmdline: $(cat /proc/cmdline)"
echo "uname: $(uname -a)"
for n in /sys/devices/system/node/node[0-9]*; do echo "$n cpus=$(cat $n/cpulist) $(grep MemTotal $n/meminfo)"; done
for c in 0 1 2 3 6 7; do echo "cpu$c siblings=$(cat /sys/devices/system/cpu/cpu$c/topology/thread_siblings_list)"; done
echo "isolated=$(cat /sys/devices/system/cpu/isolated) pressure=$(ls /proc/pressure 2>&1 | tr '\n' ' ')"
/ecbench host
echo "=== RUN-AUTO"
/ecbench run --spec /spec.json --out /out/auto --allow-busy --settle 1 --quiet --cpus auto; echo "run-auto exit $?"
/ecbench verify --dir /out/auto --replay-all --exit-code > /out/auto-audit.json; echo "verify-auto exit $?"
echo "=== RUN-NODE0"
/ecbench run --spec /spec.json --out /out/node0 --allow-busy --settle 1 --quiet --cpus 2,3; echo "run-node0 exit $?"
/ecbench verify --dir /out/node0 --replay-all --exit-code > /out/node0-audit.json; echo "verify-node0 exit $?"
echo "=== RUN-LONE-SIBLING (must be refused)"
/ecbench run --spec /spec.json --out /out/lone --allow-busy --settle 1 --quiet --cpus 2; echo "run-lone exit $?"
echo "=== RUN-SAME-DIR (must be refused, auto must stay intact)"
/ecbench run --spec /spec.json --out /out/auto --allow-busy --settle 1 --quiet --cpus 2,3; echo "run-same-dir exit $?"
echo "=== INTERRUPT"
sleep 100000 &
SLEEPER=$!
echo "sleeper mask before: $(taskset -p $SLEEPER)"
/ecbench run --spec /spec-long.json --out /out/sig --allow-busy --settle 1 --quiet --cpus 2,3 &
RUNNER=$!
sleep 4
echo "sleeper mask during: $(taskset -p $SLEEPER)"
echo "children during: $(ps | grep -c '[e]cbench exec')"
kill -TERM $RUNNER
wait $RUNNER; echo "runner exit $?"
sleep 1
echo "sleeper mask after: $(taskset -p $SLEEPER)"
echo "children after: $(ps | grep -c '[e]cbench exec')"
echo "session status: $(grep '"status"' /out/sig/session.json | tail -1)"
echo "records written: $(wc -l < /out/sig/records.jsonl)"
/ecbench verify --dir /out/sig > /out/sig-audit.json; echo "verify-sig exit $?"
grep -A4 '"problems"' /out/sig-audit.json
kill $SLEEPER
for s in auto node0 sig; do
  echo "=== FILE $s/records.jsonl"; cat /out/$s/records.jsonl
  echo "=== FILE $s/session.json"; cat /out/$s/session.json
  echo "=== FILE $s/host.json"; cat /out/$s/host.json
  echo "=== FILE $s/plan.json"; cat /out/$s/plan.json
  echo "=== FILE $s/spec.json"; cat /out/$s/spec.json
  echo "=== FILE $s-audit.json"; cat /out/$s-audit.json
done
echo "=== ECBENCH-VM-END"
poweroff -f
