// generic_d3_s0: four equations in e1..e4 over GF(269); written by
// examples/gaudry_quartic_replay.rs --export-magma.  Ours: 2 rational
// solutions, 6407643 F_p multiplications, 26 ms (gaudry_quartic::solve_system4).
K := GF(269);
P<e1,e2,e3,e4> := PolynomialRing(K, 4, "grevlex");
F := [P |
  249 + 74*e4 + 250*e4^2 + 253*e4^3 + 256*e3 + 225*e3*e4 + 268*e3*e4^2 + 217*e3^2 + 4*e3^2*e4 + 121*e3^3 + 137*e2 + 156*e2*e4 + 151*e2*e4^2 + 252*e2*e3 + 120*e2*e3*e4 + 153*e2*e3^2 + 6*e2^2 + 240*e2^2*e4 + 18*e2^2*e3 + 268*e2^3 + 146*e1 + 76*e1*e4 + 114*e1*e4^2 + 168*e1*e3 + 101*e1*e3*e4 + 245*e1*e3^2 + 13*e1*e2 + 79*e1*e2*e4 + 147*e1*e2*e3 + 69*e1*e2^2 + 234*e1^2 + 51*e1^2*e4 + 232*e1^2*e3 + 178*e1^2*e2 + 214*e1^3,
  8 + 85*e4 + 174*e4^2 + 156*e4^3 + 207*e3 + 187*e3*e4 + 81*e3*e4^2 + 122*e3^2 + 261*e3^2*e4 + 66*e3^3 + 207*e2 + 202*e2*e4 + 26*e2*e4^2 + 168*e2*e3 + 32*e2*e3*e4 + 108*e2*e3^2 + 63*e2^2 + 148*e2^2*e4 + 256*e2^2*e3 + 142*e2^3 + 196*e1 + 35*e1*e4 + 230*e1*e4^2 + 87*e1*e3 + 78*e1*e3*e4 + 105*e1*e3^2 + 221*e1*e2 + 63*e1*e2*e4 + 222*e1*e2*e3 + 169*e1*e2^2 + 65*e1^2 + 67*e1^2*e4 + 244*e1^2*e3 + 82*e1^2*e2 + 57*e1^3,
  199 + 87*e4 + 197*e4^2 + 12*e4^3 + 172*e3 + 88*e3*e4 + 86*e3*e4^2 + 23*e3^2 + 114*e3^2*e4 + 96*e3^3 + 177*e2 + 242*e2*e4 + 268*e2*e4^2 + 251*e2*e3 + 122*e2*e3*e4 + 195*e2*e3^2 + 25*e2^2 + 140*e2^2*e4 + 195*e2^2*e3 + 205*e2^3 + 248*e1 + 215*e1*e4 + 92*e1*e4^2 + 2*e1*e3 + 6*e1*e3*e4 + 125*e1*e3^2 + 61*e1*e2 + 255*e1*e2*e4 + 240*e1*e2*e3 + 249*e1*e2^2 + 61*e1^2 + 38*e1^2*e4 + 255*e1^2*e3 + 84*e1^2*e2 + 95*e1^3,
  155 + 111*e4 + 61*e4^2 + 210*e4^3 + 27*e3 + 2*e3*e4 + 19*e3*e4^2 + 8*e3^2 + 101*e3^2*e4 + 216*e3^3 + 56*e2 + 178*e2*e4 + 117*e2*e4^2 + 128*e2*e3 + 257*e2*e3*e4 + 222*e2*e3^2 + 178*e2^2 + 86*e2^2*e4 + 200*e2^2*e3 + 186*e2^3 + 61*e1 + 151*e1*e4 + 183*e1*e4^2 + 164*e1*e3 + 200*e1*e3*e4 + 223*e1*e3^2 + 97*e1*e2 + 117*e1*e2*e4 + 201*e1*e2*e3 + 103*e1*e2^2 + 268*e1^2 + 31*e1^2*e4 + 253*e1^2*e3 + 82*e1^2*e2 + 230*e1^3
];
I := ideal<P | F>;
ours := { [K| 83, 175, 143, 108], [K| 84, 242, 41, 177] };
t0 := Cputime(); G := GroebnerBasis(I); tg := Cputime(t0);
printf "RESULT-GB name=generic_d3_s0 p=269 magma_gb_s=%o basis_len=%o dim=%o\n", tg, #G, Dimension(I);
t1 := Cputime(); V := Variety(I); tv := Cputime(t1);
theirs := { [K| v[1], v[2], v[3], v[4]] : v in V };
printf "RESULT-VAR name=generic_d3_s0 magma_variety_s=%o magma_solutions=%o ours_solutions=2 agree=%o\n", tv, #theirs, theirs eq ours;
