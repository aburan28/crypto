+/// The signed sum array already owns every full x coordinate. Keep only its
+/// index in each hash slot, then compare the full coordinate on a probe.
+/// This avoids a second, randomly accessed copy of millions of x values.
+struct FlatXIndex {
+    slots: Vec<u32>,
+}
+
+impl FlatXIndex {
+    const EMPTY: u32 = u32::MAX;
+
+    fn new(pair_count: usize) -> Option<Self> {
+        let capacity = pair_count
+            .div_ceil(2)
+            .checked_mul(2)?
+            .max(8)
+            .checked_next_power_of_two()?;
+        Some(Self {
+            slots: vec![Self::EMPTY; capacity],
+        })
+    }
+
+    #[inline]
+    fn bucket(x: u128, mask: usize) -> usize {
+        let mut value = (x as u64) ^ ((x >> 64) as u64).rotate_left(23);
+        value ^= value >> 30;
+        value = value.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        value ^= value >> 27;
+        value = value.wrapping_mul(0x94d0_49bb_1331_11eb);
+        value ^= value >> 31;
+        (value as usize) & mask
+    }
+
+    #[inline]
+    fn probe(&self, x: u128, sums: &[SignedPairSum]) -> (usize, bool) {
+        let mask = self.slots.len() - 1;
+        let mut slot = Self::bucket(x, mask);
+        loop {
+            let index = self.slots[slot];
+            if index == Self::EMPTY {
+                return (slot, false);
+            }
+            if sums[index as usize]
+                .point
+                .is_some_and(|(stored_x, _)| stored_x == x)
+            {
+                return (slot, true);
+            }
+            slot = (slot + 1) & mask;
+        }
+    }
+
+    #[inline]
+    fn get(&self, x: u128, sums: &[SignedPairSum]) -> Option<usize> {
+        let (slot, found) = self.probe(x, sums);
+        found.then_some(self.slots[slot] as usize)
+    }
+
+    fn grow(&mut self, sums: &[SignedPairSum]) -> Option<()> {
+        let capacity = self.slots.len().checked_mul(2)?;
+        let mut replacement = Self {
+            slots: vec![Self::EMPTY; capacity],
+        };
+        for &index in &self.slots {
+            if index != Self::EMPTY {
+                let x = sums[index as usize].point?.0;
+                let (slot, found) = replacement.probe(x, sums);
+                debug_assert!(!found);
+                replacement.slots[slot] = index;
+            }
+        }
+        *self = replacement;
+        Some(())
+    }
+
+    fn insert_first(&mut self, x: u128, sums: &[SignedPairSum]) -> Option<bool> {
+        let (mut slot, found) = self.probe(x, sums);
+        if found {
+            return Some(false);
+        }
+        if sums.len().checked_add(1)? > self.slots.len() * 7 / 10 {
+            self.grow(sums)?;
+            slot = self.probe(x, sums).0;
+        }
+        self.slots[slot] = u32::try_from(sums.len()).ok()?;
+        Some(true)
+    }
+}
+
