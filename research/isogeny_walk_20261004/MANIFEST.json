{
  "schema": "isogeny-walk-raw-manifest/v1",
  "why_not_committed": "raw outputs of the 20k walks exceed what belongs in Git; the walk is deterministic, so the command regenerates the same bytes from the commit that adds this file",
  "durable_location": "none uploaded; regenerate with the command below and compare SHA-256",
  "build": "cargo build --release --bin isogeny_walk",
