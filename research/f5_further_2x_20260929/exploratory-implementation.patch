+
+/// Echelonize the leading degree band as sorted column lists, then finish
+/// the lower-degree suffix with the packed kernel. The high pivot rows are
+/// retained so the caller gets the whole basis, not only consequences.
+fn sparse_leading_echelon(matrix: Vec<Vec<u64>>, cols: &[u64]) -> SparseLeadingEchelon {
+    use crate::cryptanalysis::sparse_macaulay::{leading_band_end, xor_sorted};
+    let n_cols = cols.len();
+    let low_start = leading_band_end(cols);
+    let mut rows: Vec<Vec<u32>> = matrix
+        .into_iter()
+        .map(|row| {
+            let mut columns = Vec::new();
+            for (word_index, mut word) in row.into_iter().enumerate() {
+                while word != 0 {
+                    let c = word_index * 64 + word.trailing_zeros() as usize;
+                    if c < n_cols {
+                        columns.push(c as u32);
+                    }
+                    word &= word - 1;
+                }
+            }
+            columns
+        })
+        .collect();
+    let mut buckets = vec![Vec::<usize>::new(); low_start];
+    let mut low_indices = Vec::new();
+    for (i, row) in rows.iter().enumerate() {
+        if let Some(&lead) = row.first() {
+            if (lead as usize) < low_start {
+                buckets[lead as usize].push(i);
+            } else {
+                low_indices.push(i);
+            }
+        }
+    }
+    let mut high_rows = Vec::new();
+    let mut term_visits = 0u64;
+    for c in 0..low_start {
+        let bucket = std::mem::take(&mut buckets[c]);
+        let Some(&pivot) = bucket.iter().min_by_key(|&&i| rows[i].len()) else {
+            continue;
+        };
+        let pivot_row = std::mem::take(&mut rows[pivot]);
+        for i in bucket {
+            if i == pivot {
+                continue;
+            }
+            term_visits += (rows[i].len() + pivot_row.len()) as u64;
+            let reduced = xor_sorted(&rows[i], &pivot_row);
+            if let Some(&lead) = reduced.first() {
+                if (lead as usize) < low_start {
+                    debug_assert!((lead as usize) > c);
+                    buckets[lead as usize].push(i);
+                } else {
+                    low_indices.push(i);
+                }
+            }
+            rows[i] = reduced;
+        }
+        high_rows.push(pivot_row);
+    }
+    let low_cols = n_cols - low_start;
+    let low_words = low_cols.div_ceil(64);
+    let mut low_matrix = Vec::with_capacity(low_indices.len());
+    for i in low_indices {
+        let mut row = vec![0u64; low_words];
+        for &column in &rows[i] {
+            let c = column as usize - low_start;
+            row[c / 64] |= 1u64 << (c % 64);
+        }
+        low_matrix.push(row);
+    }
+    let mut dense_word_ops = 0;
+    let low_rank = if low_matrix.is_empty() || low_cols == 0 {
+        0
+    } else if low_matrix.len() >= 128 && low_cols >= 256 {
+        crate::cryptanalysis::gf2_elim::echelon_counted(
+            &mut low_matrix,
+            low_cols,
+            &mut dense_word_ops,
+        )
+    } else {
+        crate::cryptanalysis::koblitz_groebner::echelon_f2_counted(
+            &mut low_matrix,
+            low_cols,
+            &mut dense_word_ops,
+        )
+    };
+    SparseLeadingEchelon {
+        rank: high_rows.len() + low_rank,
+        high_rows,
+        low_matrix,
+        low_start,
+        dense_word_ops,
+        term_visits,
+    }
+}
