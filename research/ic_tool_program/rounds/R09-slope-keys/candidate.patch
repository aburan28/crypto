+//! Times the `m = 3` collection scan on a real folded table three ways, over
+//! the same trials, alternating, in one process:
+//!
+//! * `call`: one `decompose_fast_scan` per trial (the base);
+//! * `pipe`: `prepare_scan` of trial `t` with trial `t − 1`'s filter
+//!   words prefetched, then `finish_scan` of `t − 1`;
+//! * `bare`: the same split with no prefetch, which prices the split alone.
+//!
+//! For the two split forms it also times the halves.  Every form must give
+//! the same answers; the hit counts are printed and compared.
+//!
+//! `cargo run --release --example pipe_scan_bench -- A N POINTS WINDOW TRIALS`
+use crypto_lib::cryptanalysis::koblitz_fast::{FastCurve, FastPoint};
+use crypto_lib::cryptanalysis::koblitz_index_calculus::{
+    build_subgroup_orbit_factor_base, KoblitzCurve, PairSumTable, PreparedScan, Scan, ScanScratch,
+};
+use num_bigint::BigUint;
+use std::time::Instant;
+
+fn main() {
+    let args: Vec<u64> = std::env::args()
+        .skip(1)
+        .map(|a| a.parse().expect("numeric arguments"))
+        .collect();
+    let get = |i: usize, d: u64| args.get(i).copied().unwrap_or(d);
+    let (a, n) = (get(0, 0) as u8, get(1, 53) as u32);
+    let (points, window, trials) = (get(2, 27_984) as usize, get(3, 874) as usize, get(4, 4_000));
+    let kc = KoblitzCurve::new(a, n).expect("curve");
+    let t0 = Instant::now();
+    let fb = build_subgroup_orbit_factor_base(&kc, 201, points).expect("base");
+    let pair = PairSumTable::build_within(
+        &kc,
+        &fb,
+        PairSumTable::folded_byte_size(fb.signed_orbits.len(), fb.points.len(), kc.n),
+    )
+    .expect("table");
+    assert!(pair.is_folded());
+    eprintln!(
+        "n = {n}, {} points, {} stored, built in {:.2} s",
+        fb.points.len(),
+        pair.len(),
+        t0.elapsed().as_secs_f64()
+    );
+    let fc = FastCurve::new(&kc.curve).unwrap();
+    let g = fc.lift(kc.generator());
+    let stride = fc.mul(g, &BigUint::from(0x9e37_79b9_7f4a_7c15u64 >> 3));
+    let base = fb.points.len();
+    let mut targets: Vec<(FastPoint, usize)> = Vec::with_capacity(trials as usize);
+    let mut p = fc.mul(g, &BigUint::from(123_456_789u64));
+    for t in 0..trials {
+        targets.push((p, (t as usize).wrapping_mul(7919) % base));
+        p = fc.add(p, stride);
+    }
+    let summands = (trials as usize * window) as f64;
+    let scan = |start: usize| Scan::Cyclic { start, len: window };
+
+    let call = || {
+        let mut scratch = ScanScratch::default();
+        let t = Instant::now();
+        let mut hits = 0u64;
+        for &(p, s) in &targets {
+            hits += pair.decompose_fast_scan(p, 3, scan(s), &mut scratch).is_some() as u64;
+        }
+        (t.elapsed().as_nanos() as f64 / summands, 0.0, 0.0, hits)
+    };
+    let split = |prefetch: bool| {
+        let mut stages = [PreparedScan::default(), PreparedScan::default()];
+        let mut pending: Option<usize> = None;
+        let (mut prep_ns, mut fin_ns, mut hits) = (0u128, 0u128, 0u64);
+        let t = Instant::now();
+        for (i, &(p, s)) in targets.iter().enumerate() {
+            let now = i % 2;
+            let [s0, s1] = &mut stages;
+            let (this, other) = if now == 0 { (s0, &*s1) } else { (s1, &*s0) };
+            let a = Instant::now();
+            pair.prepare_scan(p, scan(s), this, if prefetch { pending.map(|_| other) } else { None });
+            let b = Instant::now();
+            prep_ns += (b - a).as_nanos();
+            if let Some(stage) = pending.take() {
+                hits += pair.finish_scan(&mut stages[stage]).is_some() as u64;
+                fin_ns += b.elapsed().as_nanos();
+            }
+            pending = Some(now);
+        }
+        if let Some(stage) = pending {
+            hits += pair.finish_scan(&mut stages[stage]).is_some() as u64;
+        }
+        (
+            t.elapsed().as_nanos() as f64 / summands,
+            prep_ns as f64 / summands,
+            fin_ns as f64 / summands,
+            hits,
+        )
+    };
+    let staged = || {
+        let trials: Vec<(FastPoint, Option<Scan<'_>>)> =
+            targets.iter().map(|&(p, s)| (p, Some(scan(s)))).collect();
+        let mut ring = [
+            PreparedScan::default(),
+            PreparedScan::default(),
+            PreparedScan::default(),
+        ];
+        let mut scratch = ScanScratch::default();
+        let mut hits = 0u64;
+        let t = Instant::now();
+        // In runs of 64, as a collection unit's walked probes come.
+        for run in trials.chunks(64) {
+            pair.scan_pipelined(run, &mut ring, &mut scratch, |_, a| hits += a.is_some() as u64);
+        }
+        (t.elapsed().as_nanos() as f64 / summands, 0.0, 0.0, hits)
+    };
+    for round in 0..3 {
+        for (name, r) in [
+            ("call", call()),
+            ("pipe", split(true)),
+            ("bare", split(false)),
+            ("stages", staged()),
+        ] {
+            println!(
+                "round {round} {name}: {:.2} ns a summand (prepare {:.2}, finish {:.2}), {} hits",
+                r.0, r.1, r.2, r.3
+            );
+        }
+    }
+}
