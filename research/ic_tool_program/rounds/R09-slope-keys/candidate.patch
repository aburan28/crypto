+    /// The second half of [`Self::decompose_fast_scan`] on a scan from
+    /// [`Self::prepare_scan`]: the first witness in scan order, checked
+    /// in the group, or `None`.  The same witness and the same check as
+    /// the one-call scan, which reads the filter a block at a time and
+    /// stops at its first witness; this reads the whole scan's filter
+    /// words first, since they are already in cache.
+    pub fn finish_scan(&self, prep: &mut PreparedScan) -> Option<Vec<usize>> {
+        prep.admitted.clear();
+        for (offset, &key) in prep.keys.iter().enumerate() {
+            if self.admitted(key) {
+                self.prefetch_bucket(key);
+                prep.admitted.push(offset);
