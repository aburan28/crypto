+        let idxs = found?;
+        let _check = measurement::relation_check_scope();
+        let sum = idxs.iter().fold(FastPoint::INFINITY, |s, &i| {
+            self.curve.add(s, self.points[i])
+        });
+        (sum == target).then_some(idxs)
+    }
