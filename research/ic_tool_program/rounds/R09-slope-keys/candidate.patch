+                assert_eq!(&paced[1..], &bulk[..], "degree {degree}, {count} points");
+                assert_eq!(stops.last().copied().unwrap_or(0), count);
+                assert!(stops.windows(2).all(|w| w[0] <= w[1]));
+            }
