+/// One trial's `m = 3` scan on a folded table with its rests and keys
+/// formed and its presence filter not yet read: the first half of
+/// [`PairSumTable::decompose_fast_scan`], held so that a collection run
+/// can form the next trial's keys while this trial's filter words come in
+/// from memory ([`PairSumTable::prepare_scan`],
+/// [`PairSumTable::finish_scan`]).
+#[derive(Clone, Debug)]
+pub struct PreparedScan {
+    /// The trial's point.
+    target: FastPoint,
+    /// The scanned summands, as [`PairSumTable::witnesses_fast_scan`]
+    /// maps an offset back to a base index: a cyclic window's start
+    /// (reduced mod the base) and the length before it wraps, or an
+    /// index scan's indices.
+    start: usize,
+    tail: usize,
+    indices: Vec<u32>,
+    cyclic: bool,
+    /// Summands gathered for an index scan.
+    gather: Vec<FastPoint>,
+    /// `target − P_k` without ordinates, and each one's slope.
+    rests: Vec<FastPoint>,
+    lambdas: Vec<u64>,
+    /// Workspace for the shared-inversion batch addition.
+    batch: BatchScratch,
+    /// Every rest's canonical key.
+    keys: Vec<u64>,
+    /// Offsets whose keys the filter admits.
+    admitted: Vec<usize>,
+    /// Pairs recovered for one key.
+    pairs: Vec<(u32, u32)>,
+}
+
+impl Default for PreparedScan {
+    fn default() -> Self {
+        Self {
+            target: FastPoint::INFINITY,
+            start: 0,
+            tail: 0,
+            indices: Vec::new(),
+            cyclic: true,
+            gather: Vec::new(),
+            rests: Vec::new(),
+            lambdas: Vec::new(),
+            batch: BatchScratch::default(),
+            keys: Vec::new(),
+            admitted: Vec::new(),
+            pairs: Vec::new(),
+        }
+    }
+}
+
+impl PreparedScan {
+    /// The base index scanned at `offset`.
+    #[inline]
+    fn summand(&self, offset: usize) -> usize {
+        if !self.cyclic {
+            self.indices[offset] as usize
+        } else if offset < self.tail {
+            self.start + offset
+        } else {
+            offset - self.tail
+        }
+    }
+}
