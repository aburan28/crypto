+            let kc = KoblitzCurve::new(0, degree).unwrap();
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let canon = FrobeniusCanon::new(&fc.field, degree).unwrap();
+            let g = fc.lift(kc.generator());
+            for count in [0usize, 1, 15, 16, 17, 64, 100, 257] {
+                let mut points: Vec<FastPoint> =
+                    (1..=count as u64).map(|t| fc.mul_u64(g, 3 * t + 1)).collect();
+                if count > 5 {
+                    points[5] = FastPoint::INFINITY;
