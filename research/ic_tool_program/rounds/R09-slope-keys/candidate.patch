+    /// The first half of [`Self::decompose_fast_scan`] at `m = 3`: every
+    /// rest `target − P_k` of the scan and its canonical key, with the
+    /// presence filter not yet read.  [`Self::finish_scan`] is the second
+    /// half, and the two return what [`Self::decompose_fast_scan`] does.
+    ///
+    /// `previous`, a scan prepared and not yet finished, has its filter
+    /// words fetched into the second-level cache while these keys are
+    /// formed, a few after each group of keys.  A collection run that
+    /// prepares trial `t + 1` before it finishes trial `t` then finds
+    /// trial `t`'s filter words in cache.  Read straight after its keys,
+    /// as the one-call scan reads them, each word is a round trip to the
+    /// last-level cache or memory, and the core holds too few misses in
+    /// flight for those to overlap well: the probe loop runs at the
+    /// memory's pace with the arithmetic units idle.
+    ///
+    /// The caller must have checked [`Self::prepares`].
+    pub fn prepare_scan(
+        &self,
+        target: FastPoint,
+        scan: Scan<'_>,
+        prep: &mut PreparedScan,
+        previous: Option<&PreparedScan>,
+    ) {
+        debug_assert!(self.prepares(&scan));
+        let base = self.points.len();
+        let canon = self.canon.as_ref().expect("prepares() checked the key");
+        prep.target = target;
+        prep.rests.clear();
+        prep.lambdas.clear();
+        prep.keys.clear();
+        prep.admitted.clear();
+        prep.indices.clear();
+        match scan {
+            Scan::Cyclic { start, len } => {
+                let start = start % base;
+                let tail = len.min(base - start);
+                prep.cyclic = true;
+                prep.start = start;
+                prep.tail = tail;
+                self.curve.add_many_lazy(
+                    target,
+                    &self.negated[start..start + tail],
+                    &mut prep.rests,
+                    &mut prep.lambdas,
+                    &mut prep.batch,
+                );
+                if tail < len {
+                    self.curve.add_many_lazy(
+                        target,
+                        &self.negated[..len - tail],
+                        &mut prep.rests,
+                        &mut prep.lambdas,
+                        &mut prep.batch,
+                    );
+                }
+            }
+            Scan::Indices(idxs) => {
+                prep.cyclic = false;
+                prep.indices.extend_from_slice(idxs);
+                prep.gather.clear();
+                prep.gather.reserve(idxs.len());
+                for &i in idxs {
+                    prep.gather.push(self.negated[i as usize]);
+                }
+                self.curve.add_many_lazy(
+                    target,
+                    &prep.gather,
+                    &mut prep.rests,
+                    &mut prep.lambdas,
+                    &mut prep.batch,
+                );
+            }
+        }
+        // The previous trial's words, spread over this trial's keys in
+        // proportion: after `done` of `len` keys, the first
+        // `done · |previous| / len` of its words have been asked for.
+        let earlier: &[u64] = previous.map_or(&[], |p| &p.keys);
+        let len = prep.rests.len().max(1);
+        let mut asked = 0usize;
+        canon.point_keys_paced(&prep.rests, &mut prep.keys, |done| {
+            let upto = (done * earlier.len()).div_ceil(len).min(earlier.len());
+            for &key in &earlier[asked..upto] {
+                prefetch_l2(&self.present[self.filter_word(key)]);
+            }
+            asked = asked.max(upto);
+        });
+    }
