+    /// [`Self::point_keys`], the same keys, appended to `out` a few at a
+    /// time, with `between(done)` called after each group, `done` being
+    /// how many of `points` have their key so far.
+    ///
+    /// A collection run uses the pauses to prefetch the previous trial's
+    /// presence-filter words a few at a time, so that the fetches overlap
+    /// these keys' arithmetic.  Issued all at once they would queue on
+    /// the core's few outstanding-miss buffers and stall it.
+    #[inline]
+    pub(crate) fn point_keys_paced(
+        &self,
+        points: &[FastPoint],
+        out: &mut Vec<u64>,
+        mut between: impl FnMut(usize),
+    ) {
+        #[cfg(target_arch = "x86_64")]
+        if canon_simd_enabled() {
+            let mut chunks = points.chunks_exact(16);
+            let mut done = 0;
+            for chunk in &mut chunks {
+                let mut c = [0u64; 16];
+                for (slot, p) in c.iter_mut().zip(chunk) {
+                    *slot = self.coords(p.x);
+                }
+                // SAFETY: `canon_simd_enabled` checked AVX-512F.
+                let mins = unsafe { least_rotation16_avx512(&c, self.n, self.mask) };
+                out.extend(
+                    chunk
+                        .iter()
+                        .zip(mins)
+                        .map(|(p, m)| if p.infinity { 0 } else { m + 1 }),
+                );
+                done += 16;
+                between(done);
+            }
+            for p in chunks.remainder() {
+                out.push(if p.infinity { 0 } else { self.canon(p.x) + 1 });
+            }
+            between(points.len());
+            return;
+        }
+        const GROUP: usize = 64;
+        let mut group = Vec::with_capacity(GROUP);
+        let mut done = 0;
+        for chunk in points.chunks(GROUP) {
+            self.point_keys(chunk, &mut group);
+            out.extend_from_slice(&group);
+            done += chunk.len();
+            between(done);
+        }
+    }
+
     /// The canonical name together with the rotation that produced it:
     /// `(c, t)` with `c = rotl^t(coords(x))`, `0 ≤ t < n`.  Two abscissae
     /// with one name are Frobenius conjugates, and the shift says which
diff --git a/src/cryptanalysis/koblitz_index_calculus.rs b/src/cryptanalysis/koblitz_index_calculus.rs
index a2ee2bc03..b7dec775e 100644
--- a/src/cryptanalysis/koblitz_index_calculus.rs
+++ b/src/cryptanalysis/koblitz_index_calculus.rs
@@ -3031,6 +3031,31 @@ fn prefetch(address: *const u64) {
     let _ = address;
 }
 
+/// [`prefetch`] into the second-level cache only.
+///
+/// A pipelined collection run fetches a whole trial's filter words, more
+/// lines than the first-level cache holds, a full trial before it reads
+/// them; the second level keeps them all until then.
+#[inline(always)]
+fn prefetch_l2(address: *const u64) {
+    #[cfg(target_arch = "x86_64")]
+    // SAFETY: as in `prefetch`.
+    unsafe {
+        std::arch::x86_64::_mm_prefetch::<{ std::arch::x86_64::_MM_HINT_T1 }>(address as *const i8);
+    }
+    #[cfg(target_arch = "aarch64")]
+    // SAFETY: as in `prefetch`.
+    unsafe {
+        std::arch::asm!(
+            "prfm pldl2keep, [{address}]",
+            address = in(reg) address,
+            options(readonly, nostack, preserves_flags)
+        );
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    let _ = address;
+}
