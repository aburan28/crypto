+    /// table with its canonical key, and a scan that is neither empty nor
+    /// the full sweep [`Self::witnesses_fast_scan`] hands elsewhere.
+    pub fn prepares(&self, scan: &Scan<'_>) -> bool {
+        let base = self.points.len();
+        self.fold
+            && self.canon.is_some()
+            && base != 0
+            && !scan.is_empty()
+            && !(matches!(scan, Scan::Cyclic { .. }) && scan.len() >= base)
