+    /// The two suite fields whose `H·t` passes `z^63` build a wide kernel,
+    /// and its products equal the scalar field's on the inputs that carry
+    /// most: all-ones operands, single top bits, and random ones.  Skipped
+    /// on a CPU without AVX-512 and VPCLMULQDQ.
+    #[cfg(target_arch = "x86_64")]
+    #[test]
+    fn avx512_kernel_carries_wide_tails() {
+        if !(is_x86_feature_detected!("avx512f") && is_x86_feature_detected!("vpclmulqdq")) {
+            eprintln!("skipped: no AVX-512 + VPCLMULQDQ on this CPU");
+            return;
+        }
+        let mut rng = StdRng::seed_from_u64(0x66);
+        for (a, n) in [(1u8, 59u32), (0, 61)] {
+            let kc = KoblitzCurve::new(a, n).unwrap();
+            let fc = FastCurve::new(&kc.curve).unwrap();
+            let field = &fc.field;
+            let tail = field.irr ^ (1u64 << n);
+            assert_eq!(
+                n + (63 - tail.leading_zeros()),
+                66,
+                "K_{a}/GF(2^{n}) is the wide case"
+            );
+            let simd = simd512::Simd512::for_field(field).expect("a wide tail builds a kernel");
+            assert!(simd.wide());
+            assert!(fc.simd.is_some(), "the curve uses the kernel on this CPU");
+            let top = 1u64 << (n - 1);
+            let mut cases = vec![
+                ([field.mask; 8], [field.mask; 8]),
+                ([top; 8], [top; 8]),
+                ([field.mask; 8], [top; 8]),
+            ];
+            for _ in 0..2000 {
+                let x: [u64; 8] = std::array::from_fn(|_| rng.gen::<u64>() & field.mask | top);
+                let y: [u64; 8] = std::array::from_fn(|_| rng.gen::<u64>() & field.mask);
+                cases.push((x, y));
+            }
+            for (x, y) in cases {
+                let got = simd.mul8(&x, &y);
+                for l in 0..8 {
+                    assert_eq!(got[l], field.mul(x[l], y[l]), "n = {n}, lane {l}");
+                }
+            }
+        }
+    }
