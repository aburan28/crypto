+/// Asks the kernel to back a large allocation that nothing has written yet
+/// with transparent huge pages, so that the scan's random reads into it
+/// (filter words, bucket starts, stored words) miss the TLB less.  Only
+/// the allocation's 2 MiB-aligned interior can be advised.  Advisory:
+/// where the kernel has no THP or declines, the pages stay small and
+/// nothing else changes.
+fn advise_huge_pages<T>(v: &[T]) {
+    #[cfg(target_os = "linux")]
+    {
+        const HUGE: usize = 2 << 20;
+        let bytes = std::mem::size_of_val(v);
+        let start = v.as_ptr() as usize;
+        let lo = start.next_multiple_of(HUGE);
+        let hi = (start + bytes) & !(HUGE - 1);
+        if hi > lo {
+            // SAFETY: `lo..hi` lies inside `v`'s live allocation, and
+            // `MADV_HUGEPAGE` changes how it is backed, never what it holds.
+            unsafe {
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_HUGEPAGE);
+            }
+        }
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = v;
+}
+
+/// `len` zeroed words, with huge pages advised before anything touches
+/// them ([`advise_huge_pages`]).
+fn zeroed_huge<T: Clone + Default>(len: usize) -> Vec<T> {
+    let v = vec![T::default(); len];
+    advise_huge_pages(&v);
+    v
+}
+
+/// Bucket starts from a counting pass, whose `counts[b + 1]` holds bucket
+/// `b`'s count: their running sums, in a fresh table with huge pages
+/// advised ([`zeroed_huge`]).
+fn bucket_starts(counts: &[AtomicU32]) -> Vec<u32> {
+    let mut starts: Vec<u32> = zeroed_huge(counts.len());
+    let mut sum = 0u32;
+    for (s, c) in starts.iter_mut().zip(counts) {
+        sum += c.load(Ordering::Relaxed);
+        *s = sum;
+    }
+    starts
+}
+
+/// A presence filter's words viewed as atomics, for a parallel fill that
+/// writes the words in place: no atomic copy to collect afterwards.
+fn filter_atomics(words: &mut [u64]) -> &[AtomicU64] {
+    assert!(words.as_ptr().cast::<AtomicU64>().is_aligned());
+    // SAFETY: `AtomicU64` has `u64`'s size and bit validity, and the assert
+    // gives its alignment; the exclusive borrow keeps every other access
+    // out while the atomics are live.
+    unsafe { std::slice::from_raw_parts(words.as_mut_ptr().cast::<AtomicU64>(), words.len()) }
+}
