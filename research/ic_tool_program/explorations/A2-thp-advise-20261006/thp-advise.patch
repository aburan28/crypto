+    #[test]
+    fn bucket_starts_are_running_sums_and_filters_fill_in_place() {
+        let counts: Vec<AtomicU32> = [0u32, 3, 0, 2, 5]
+            .iter()
+            .map(|&c| AtomicU32::new(c))
+            .collect();
+        assert_eq!(bucket_starts(&counts), vec![0, 3, 3, 5, 10]);
+        // Four MiB, so an aligned interior is advised.
+        let len = 1usize << 19;
+        let mut words: Vec<u64> = zeroed_huge(len);
+        assert!(words.iter().all(|&w| w == 0));
+        {
+            let atomics = filter_atomics(&mut words);
+            atomics[7].fetch_or(1 << 5, Ordering::Relaxed);
+            atomics[len - 1].fetch_or(u64::MAX, Ordering::Relaxed);
+        }
+        assert_eq!(words[7], 1 << 5);
+        assert_eq!(words[len - 1], u64::MAX);
+        assert_eq!(words.iter().filter(|&&w| w != 0).count(), 2);
+    }
