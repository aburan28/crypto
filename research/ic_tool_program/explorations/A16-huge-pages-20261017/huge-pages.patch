+/// Asks the kernel to back the whole 2 MiB pages inside `data` with huge
+/// pages now (`MADV_HUGEPAGE`, then `MADV_COLLAPSE`).  A request the kernel
+/// refuses leaves the pages as they were; nothing is read or written.
+fn collapse_to_huge_pages<T>(data: &[T]) {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    {
+        const HUGE: usize = 2 << 20;
+        let start = data.as_ptr() as usize;
+        let end = start + std::mem::size_of_val(data);
+        let lo = (start + HUGE - 1) & !(HUGE - 1);
+        let hi = end & !(HUGE - 1);
+        if hi > lo {
+            // SAFETY: `lo..hi` lies inside `data`'s live allocation, and
+            // both advices change only how its pages are backed.
+            unsafe {
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_HUGEPAGE);
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_COLLAPSE);
+            }
+        }
+    }
+    #[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+    let _ = data;
+}
