+    /// The scan's random reads (the filter, the bucket starts and the
+    /// stored keys) moved onto 2 MiB pages, where the kernel allows it:
+    /// one TLB entry then covers 512 times the bytes.  Only whole 2 MiB
+    /// pages inside each array are collapsed; the values are unchanged.
+    /// `KIC_HUGE_PAGES=0` leaves the table on base pages, and
+    /// `KIC_HUGE_PAGES=filter` collapses the filter alone.
+    fn on_huge_pages(self) -> Self {
+        let mode = std::env::var("KIC_HUGE_PAGES");
+        if mode.as_deref() != Ok("0") {
+            collapse_to_huge_pages(&self.present);
+        }
+        if mode.is_err() || mode.as_deref() == Ok("all") {
+            collapse_to_huge_pages(&self.bucket_start);
+            collapse_to_huge_pages(&self.rests);
+            collapse_to_huge_pages(&self.entries);
+            collapse_to_huge_pages(&self.compact_witnesses);
+        }
+        self
+    }
