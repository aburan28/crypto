 /// The least cyclic rotation of each of sixteen `n`-bit words.
 ///
 /// Rotation by one is `((v << 1) | (v >> (n − 1))) & mask`, one
@@ -914,6 +936,107 @@ unsafe fn least_rotation16_avx512(c: &[u64; 16], n: u32, mask: u64) -> [u64; 16]
     out
