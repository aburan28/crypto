--- /dev/null
+++ b/examples/canon_kernel_bench.rs
@@ -0,0 +1,47 @@
+//! Times the bulk canonical key (`FrobeniusCanon::canon_in_place`) on
+//! fresh abscissae, so the two AVX-512 least-rotation kernels can be
+//! compared on one binary: run it once as is and once with
+//! `KIC_CANON_RUNS=0`.  This is a stage diagnostic of the key alone,
+//! outside the scan, and it reports a checksum of every key so the two
+//! runs can be checked to agree.
+//!
+//! `cargo run --release --example canon_kernel_bench -- 41 53 61`
+use crypto_lib::cryptanalysis::koblitz_fast::{FastCurve, FrobeniusCanon};
+use crypto_lib::cryptanalysis::koblitz_index_calculus::KoblitzCurve;
+use std::hint::black_box;
+use std::time::Instant;
+
+fn main() {
+    let degrees: Vec<u32> = std::env::args()
+        .skip(1)
+        .map(|a| a.parse().expect("a degree"))
+        .collect();
+    for n in if degrees.is_empty() { vec![41, 53, 61] } else { degrees } {
+        let kc = KoblitzCurve::new(0, n).expect("a Koblitz curve");
+        let fc = FastCurve::new(&kc.curve).expect("a single-word field");
+        let canon = FrobeniusCanon::new(&fc.field, n).expect("a normal basis");
+        let mask = (1u64 << n) - 1;
+        let mut s = 0x2545_F491_4F6C_DD1Du64 ^ u64::from(n);
+        let words: Vec<u64> = (0..1 << 20)
+            .map(|_| {
+                s ^= s << 13;
+                s ^= s >> 7;
+                s ^= s << 17;
+                s & mask
+            })
+            .collect();
+        let mut best = f64::INFINITY;
+        let mut sum = 0u64;
+        for _ in 0..7 {
+            let mut xs = words.clone();
+            let t = Instant::now();
+            canon.canon_in_place(black_box(&mut xs));
+            best = best.min(t.elapsed().as_nanos() as f64 / xs.len() as f64);
+            sum = xs.iter().fold(0u64, |a, &k| a.wrapping_mul(31).wrapping_add(k));
+        }
+        println!(
+            "{{\"n\": {n}, \"keys\": {}, \"ns_per_key_min_of_7\": {best:.3}, \"checksum\": \"{sum:016x}\"}}",
+            words.len()
+        );
+    }
+}
