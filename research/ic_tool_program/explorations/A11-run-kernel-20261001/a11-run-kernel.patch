+/// Whether the AVX-512 path finds the least rotation from the longest
+/// zero runs ([`least_rotation16_runs_avx512`]) rather than by trying
+/// every rotation ([`least_rotation16_avx512`]).  It needs AVX-512CD for
+/// its leading-zero count; `KIC_CANON_RUNS=0` keeps the exhaustive
+/// kernel, a same-binary control for what this one is credited with.
+/// Both give the same words.
+#[cfg(target_arch = "x86_64")]
+fn canon_runs_enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        is_x86_feature_detected!("avx512cd")
+            && std::env::var("KIC_CANON_RUNS").as_deref() != Ok("0")
+    })
+}
