+/// [`least_rotation16_avx512`]'s words, found from the longest zero
+/// runs as [`FrobeniusCanon::least_rotation`] finds one word's.
+///
+/// `Z_k = Z_{k−1} ∧ rotl^{k−1}(¬c)` has bit `p` set exactly when bits
+/// `p, p−1, …, p−k+1` of `c` are all zero, and the least rotation starts
+/// at the top of one of the longest zero runs.  So instead of `n − 1`
+/// rotate-and-minimum steps this takes one step per bit of the longest
+/// run among a register's eight words (a lane stops growing when its own
+/// runs end), then compares only the rotations that start at a longest
+/// run's top: usually one or two per word.  For random words the longest
+/// run is about `log₂ n` bits.
+///
+/// The words are the same as the exhaustive kernel's: the tests compare
+/// the two on random words and on every pattern class where they could
+/// differ.
+///
+/// # Safety
+///
+/// The CPU must support AVX-512F and AVX-512CD, and `1 ≤ n ≤ 63` with
+/// `mask = 2^n − 1`.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx512f,avx512cd")]
+unsafe fn least_rotation16_runs_avx512(c: &[u64; 16], n: u32, mask: u64) -> [u64; 16] {
+    use std::arch::x86_64::*;
+    let m = _mm512_set1_epi64(mask as i64);
+    let zero = _mm512_setzero_si512();
+    let ca = _mm512_loadu_si512(c.as_ptr().cast());
+    let cb = _mm512_loadu_si512(c.as_ptr().add(8).cast());
+    let za = _mm512_andnot_si512(ca, m);
+    let zb = _mm512_andnot_si512(cb, m);
+    // A word with no zero bit, or no one bit, is its own every rotation.
+    let trivial_a = _mm512_cmpeq_epi64_mask(za, zero) | _mm512_cmpeq_epi64_mask(ca, zero);
+    let trivial_b = _mm512_cmpeq_epi64_mask(zb, zero) | _mm512_cmpeq_epi64_mask(cb, zero);
+    // Grow the runs: a lane is live while its runs reach the next length.
+    let (mut ra, mut rb) = (za, zb);
+    let (mut live_a, mut live_b) = (!trivial_a, !trivial_b);
+    let mut len = 1u32;
+    while (live_a | live_b) != 0 {
+        // rotl^len within `n` bits, every lane by the same amount.  A
+        // live lane's longest run is shorter than `n`, so `len < n` here.
+        let up = _mm_cvtsi64_si128(i64::from(len));
+        let down = _mm_cvtsi64_si128(i64::from(n - len));
+        let rot_a = _mm512_ternarylogic_epi64::<0xA8>(
+            _mm512_sll_epi64(za, up),
+            _mm512_srl_epi64(za, down),
+            m,
+        );
+        let rot_b = _mm512_ternarylogic_epi64::<0xA8>(
+            _mm512_sll_epi64(zb, up),
+            _mm512_srl_epi64(zb, down),
+            m,
+        );
+        let next_a = _mm512_and_si512(ra, rot_a);
+        let next_b = _mm512_and_si512(rb, rot_b);
+        live_a &= _mm512_test_epi64_mask(next_a, next_a);
+        live_b &= _mm512_test_epi64_mask(next_b, next_b);
+        ra = _mm512_mask_mov_epi64(ra, live_a, next_a);
+        rb = _mm512_mask_mov_epi64(rb, live_b, next_b);
+        len += 1;
+    }
+    // `r` marks the top bit `p` of each longest run; the rotation that
+    // starts there is `rotl^{n−1−p}(c)`.  Compare them a candidate at a
+    // time, lowest `p` first, in the lanes that still have one.
+    let nv = _mm512_set1_epi64(i64::from(n));
+    let off = _mm512_set1_epi64(64 - i64::from(n));
+    let mut best_a = _mm512_set1_epi64(-1);
+    let mut best_b = _mm512_set1_epi64(-1);
+    let mut left_a = !trivial_a & _mm512_test_epi64_mask(ra, ra);
+    let mut left_b = !trivial_b & _mm512_test_epi64_mask(rb, rb);
+    while (left_a | left_b) != 0 {
+        // The lowest candidate `2^p`, whose leading-zero count is
+        // `63 − p`, so `t = n − 1 − p` is that count less `64 − n`.
+        let low_a = _mm512_and_si512(ra, _mm512_sub_epi64(zero, ra));
+        let low_b = _mm512_and_si512(rb, _mm512_sub_epi64(zero, rb));
+        let t_a = _mm512_sub_epi64(_mm512_lzcnt_epi64(low_a), off);
+        let t_b = _mm512_sub_epi64(_mm512_lzcnt_epi64(low_b), off);
+        let v_a = _mm512_ternarylogic_epi64::<0xA8>(
+            _mm512_sllv_epi64(ca, t_a),
+            _mm512_srlv_epi64(ca, _mm512_sub_epi64(nv, t_a)),
+            m,
+        );
+        let v_b = _mm512_ternarylogic_epi64::<0xA8>(
+            _mm512_sllv_epi64(cb, t_b),
+            _mm512_srlv_epi64(cb, _mm512_sub_epi64(nv, t_b)),
+            m,
+        );
+        best_a = _mm512_mask_min_epu64(best_a, left_a, best_a, v_a);
+        best_b = _mm512_mask_min_epu64(best_b, left_b, best_b, v_b);
+        ra = _mm512_xor_si512(ra, low_a);
+        rb = _mm512_xor_si512(rb, low_b);
+        left_a &= _mm512_test_epi64_mask(ra, ra);
+        left_b &= _mm512_test_epi64_mask(rb, rb);
+    }
+    best_a = _mm512_mask_mov_epi64(best_a, trivial_a, ca);
+    best_b = _mm512_mask_mov_epi64(best_b, trivial_b, cb);
+    let mut out = [0u64; 16];
+    _mm512_storeu_si512(out.as_mut_ptr().cast(), best_a);
+    _mm512_storeu_si512(out.as_mut_ptr().add(8).cast(), best_b);
+    out
+}
