+/// **A stream appended one 64-byte line at a time** (software
+/// write-combining), for the folded build's partition streams.
+///
+/// `N` elements of `T` make one cache line.  Pushes fill a pending line
+/// held in the struct (so in L1); a full line is written to the stream's
+/// storage with non-temporal stores, which neither read the line first nor
+/// leave it in the cache.  The stream's elements start on a 64-byte
+/// boundary inside an over-reserved `Vec`, so every flushed line is a whole
+/// aligned line.  If a stream outgrows its room it falls back to ordinary
+/// appends; its order, and so the table, is the same either way.
+pub(crate) struct LineStream<T: Copy + Default, const N: usize> {
+    buf: Vec<T>,
+    /// Elements before the first 64-byte boundary, unused.
+    off: usize,
+    /// Elements written after `off`, flushed lines only (`buf.len()` is
+    /// `off + len` once [`Self::finish`] has run, or while `plain`).
+    len: usize,
+    line: [T; N],
+    pending: usize,
+    /// Set once the reserved room ran out: lines go through `Vec` then.
+    plain: bool,
+}
+
+impl<T: Copy + Default, const N: usize> LineStream<T, N> {
+    const LINE: usize = 64;
+
+    fn with_room(room: usize) -> Self {
+        debug_assert_eq!(N * std::mem::size_of::<T>(), Self::LINE);
+        let mut buf: Vec<T> = Vec::with_capacity(room + 2 * N);
+        let addr = buf.as_mut_ptr() as usize;
+        let off = ((Self::LINE - addr % Self::LINE) % Self::LINE) / std::mem::size_of::<T>();
+        Self {
+            buf,
+            off,
+            len: 0,
+            line: [T::default(); N],
+            pending: 0,
+            plain: false,
+        }
+    }
+
+    #[inline(always)]
+    fn push(&mut self, v: T) {
+        self.line[self.pending] = v;
+        self.pending += 1;
+        if self.pending == N {
+            self.flush_line();
+        }
+    }
+
+    #[inline(always)]
+    fn flush_line(&mut self) {
+        self.pending = 0;
+        if !self.plain && self.off + self.len + N <= self.buf.capacity() {
+            // SAFETY: `off + len .. off + len + N` lies inside the
+            // reserved capacity, starts on a 64-byte boundary (`off` puts
+            // element 0 there and `len` is a whole number of lines), and
+            // nothing else refers to it.
+            unsafe {
+                let dst = self.buf.as_mut_ptr().add(self.off + self.len);
+                Self::stream_line(dst, &self.line);
+            }
+            self.len += N;
+        } else {
+            if !self.plain {
+                // SAFETY: the first `off + len` elements are initialised:
+                // `off` of them are never read (see `as_slice`), and the
+                // rest were written by whole lines.  Zero them first so
+                // `Vec` holds no uninitialised `T`.
+                unsafe {
+                    std::ptr::write_bytes(self.buf.as_mut_ptr(), 0, self.off);
+                    self.buf.set_len(self.off + self.len);
+                }
+                self.plain = true;
+            }
+            self.buf.extend_from_slice(&self.line);
+            self.len += N;
+        }
+    }
+
+    /// The last, partial line, and the `Vec`'s length.
+    fn finish(&mut self) {
+        if !self.plain {
+            // SAFETY: as in `flush_line`'s fallback.
+            unsafe {
+                std::ptr::write_bytes(self.buf.as_mut_ptr(), 0, self.off);
+                self.buf.set_len(self.off + self.len);
+            }
+            self.plain = true;
+        }
+        let pending = self.pending;
+        self.buf.extend_from_slice(&self.line[..pending]);
+        self.len += pending;
+        self.pending = 0;
+    }
+
+    /// The stream, in push order (after [`Self::finish`]).
+    fn as_slice(&self) -> &[T] {
+        &self.buf[self.off..]
+    }
+
+    /// Orders this thread's non-temporal stores before what follows.
+    fn fence() {
+        #[cfg(target_arch = "x86_64")]
+        // SAFETY: `sfence` has no operands and no preconditions.
+        unsafe {
+            std::arch::x86_64::_mm_sfence();
+        }
+    }
+
+    /// # Safety
+    /// `dst` must be 64-byte aligned and valid for writes of `N` `T`s.
+    #[inline(always)]
+    unsafe fn stream_line(dst: *mut T, line: &[T; N]) {
+        #[cfg(target_arch = "x86_64")]
+        {
+            use std::arch::x86_64::{__m128i, _mm_loadu_si128, _mm_stream_si128};
+            let s = line.as_ptr() as *const __m128i;
+            let d = dst as *mut __m128i;
+            for k in 0..4 {
+                _mm_stream_si128(d.add(k), _mm_loadu_si128(s.add(k)));
+            }
+        }
+        #[cfg(not(target_arch = "x86_64"))]
+        std::ptr::copy_nonoverlapping(line.as_ptr(), dst, N);
+    }
+}
