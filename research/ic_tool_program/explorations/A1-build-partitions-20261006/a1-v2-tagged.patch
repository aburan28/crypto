+    #[test]
+    fn the_tagged_stream_build_stores_the_twelve_byte_build_word_for_word() {
+        // Synthetic rows: keys from a fixed stream, rows of every length
+        // from none up, and one row whose keys all hash into partition 0,
+        // so that partition's stream overflows into its spill.
+        let mix = |x: u64| {
+            let mut z = x.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        };
+        for bucket_bits in [3u32, 9, 12, 17] {
+            let part_shift = 64 - bucket_bits.min(8);
+            let crowded: Vec<u64> = (0u64..)
+                .map(mix)
+                .filter(|&k| pair_filter_hash(k) >> part_shift == 0)
+                .take(4000)
+                .collect();
+            let mut rows: Vec<Vec<u64>> = (0..40u64)
+                .map(|r| (0..r * 37).map(|i| mix((r << 32) | i)).collect())
+                .collect();
+            rows.insert(7, crowded);
+            let row_lens: Vec<usize> = rows.iter().map(Vec::len).collect();
+            let row_orbits: Vec<u32> = (0..rows.len() as u32)
+                .map(|r| r.wrapping_mul(2_654_435_761) >> 16)
+                .collect();
+            let each_row = |r: usize, f: &mut dyn FnMut(&[u64], u32)| f(&rows[r], row_orbits[r]);
+            for threads in [1, 3] {
+                let pool = rayon::ThreadPoolBuilder::new()
+                    .num_threads(threads)
+                    .build()
+                    .unwrap();
+                let (want, got) = pool.install(|| {
+                    (
+                        PairSumTable::fold_partitioned(&row_lens, bucket_bits, true, &each_row),
+                        PairSumTable::fold_partitioned_tagged(
+                            &row_lens,
+                            &row_orbits,
+                            bucket_bits,
+                            &each_row,
+                        ),
+                    )
+                });
+                assert_eq!(got, want, "{bucket_bits} bucket bits, {threads} threads");
+            }
+        }
+    }
