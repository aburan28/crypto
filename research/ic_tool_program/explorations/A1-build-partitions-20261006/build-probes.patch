+/// A1 exploration probes (2026-10-06): stage timings of the folded build,
+/// printed to stderr when `KIC_BUILD_PROBES` is set.  Not for main.
+pub mod build_probes {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::Instant;
+    pub static ADD: AtomicU64 = AtomicU64::new(0);
+    pub static KEY: AtomicU64 = AtomicU64::new(0);
+    pub static EMIT: AtomicU64 = AtomicU64::new(0);
+    pub static ALLOC: AtomicU64 = AtomicU64::new(0);
+    pub fn charge(c: &AtomicU64, since: Instant) -> Instant {
+        let now = Instant::now();
+        c.fetch_add((now - since).as_nanos() as u64, Ordering::Relaxed);
+        now
+    }
+    pub fn take(c: &AtomicU64) -> u64 {
+        c.swap(0, Ordering::Relaxed)
+    }
+}
