+    /// Every way of moving a row through a column map writes the same bits
+    /// and reports the same lowest word as the plain bit-by-bit scatter.
+    #[test]
+    fn remap_row_matches_the_bitwise_scatter() {
+        let mut seed = 0x0dd_b1a5_e5c0_ffeeu64;
+        for round in 0..300 {
+            let n_old = 1 + (xorshift(&mut seed) % 400) as usize;
+            // deletion-like (monotone), fold-like (collisions) or shuffled
+            let mut next = 0u32;
+            let map: Vec<u32> = (0..n_old)
+                .map(|_| {
+                    let r = xorshift(&mut seed);
+                    match round % 3 {
+                        0 if r % 5 == 0 => DELETED,
+                        0 => {
+                            next += 1 + (r % 2 == 0 && round % 2 == 0) as u32;
+                            next - 1
+                        }
+                        1 if r % 7 == 0 => DELETED,
+                        1 => (r % (n_old as u64)) as u32 / 2,
+                        _ => (r % (2 * n_old as u64)) as u32,
+                    }
+                })
+                .collect();
+            let n_new = map
+                .iter()
+                .filter(|&&c| c != DELETED)
+                .max()
+                .map_or(1, |&c| c as usize + 1);
+            let words = n_new.div_ceil(64);
+            let cm = ColMap::new(map.clone());
+            let row_words = n_old.div_ceil(64);
+            let lead = (xorshift(&mut seed) as usize) % row_words;
+            let mut live: Vec<u64> = (lead..row_words).map(|_| xorshift(&mut seed)).collect();
+            if let Some(last) = live.last_mut() {
+                if n_old % 64 != 0 {
+                    *last &= (1u64 << (n_old % 64)) - 1;
+                }
+            }
+            // reference
+            let mut want = vec![0u64; words];
+            let mut want_lo = usize::MAX;
+            for (i, &w) in live.iter().enumerate() {
+                for b in 0..64 {
+                    if w >> b & 1 == 1 {
+                        let c = map[(lead + i) * 64 + b];
+                        if c != DELETED {
+                            want[c as usize / 64] ^= 1u64 << (c % 64);
+                            want_lo = want_lo.min(c as usize / 64);
+                        }
+                    }
+                }
+            }
+            let mut got = vec![0u64; words];
+            assert_eq!(remap_row_body::<false>(&mut got, &live, lead, &cm), want_lo);
+            assert_eq!(got, want, "portable, round {round}");
+            let mut got = vec![0u64; words];
+            assert_eq!(remap_row(&mut got, &live, lead, &cm), want_lo);
+            assert_eq!(got, want, "dispatched, round {round}");
+        }
+    }
