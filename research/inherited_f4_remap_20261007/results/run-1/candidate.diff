+/// No single output offset: the chunk's live columns do not land on
+/// consecutive columns.
+const SCATTERED: u32 = u32::MAX;
+
+/// A column map (old column → new column or [`DELETED`]) with what a
+/// rewrite needs to move a row a 64-column word at a time.  For each word
+/// of the source layout: `live`, the columns the map keeps, and `out`, the
+/// first target when the kept columns land on consecutive targets in order
+/// ([`SCATTERED`] otherwise).  A deletion step, and any composition of
+/// deletions, is consecutive on every word, so the word's image is its
+/// kept bits compressed together (`pext`) and shifted into place; a fold or
+/// a layout extension is not, and goes bit by bit, without visiting the
+/// deleted bits.
+#[derive(Debug)]
+struct ColMap {
+    map: Vec<u32>,
+    live: Vec<u64>,
+    out: Vec<u32>,
+}
+
+impl ColMap {
+    /// A map whose per-word masks its builder already knows.
+    fn from_parts(map: Vec<u32>, live: Vec<u64>, out: Vec<u32>) -> Self {
+        debug_assert_eq!(live.len(), map.len().div_ceil(64));
+        debug_assert_eq!(out.len(), live.len());
+        Self { map, live, out }
+    }
+
+    /// A map that deletes nothing and is not known to be consecutive (a
+    /// fold, or a layout extension): every column live, every word
+    /// scattered.
+    fn without_deletions(map: Vec<u32>) -> Self {
+        debug_assert!(map.iter().all(|&c| c != DELETED));
+        let words = map.len().div_ceil(64);
+        let mut live = vec![u64::MAX; words];
+        if map.len() % 64 != 0 {
+            live[words - 1] = (1u64 << (map.len() % 64)) - 1;
+        }
+        Self {
+            map,
+            live,
+            out: vec![SCATTERED; words],
+        }
+    }
+
+    /// The masks of any map, read off it, consecutive words included; the
+    /// tests' reference for the masks the builders above take on the way.
+    #[cfg(test)]
+    fn new(map: Vec<u32>) -> Self {
+        let words = map.len().div_ceil(64);
+        let mut live = Vec::with_capacity(words);
+        let mut out = Vec::with_capacity(words);
+        for chunk in map.chunks(64) {
+            let (mask, first) = chunk_masks(chunk.iter().copied());
+            live.push(mask);
+            out.push(first);
+        }
+        Self { map, live, out }
+    }
+
+    /// `step ∘ prev`, with its live masks taken in the same pass as the
+    /// gather.  `DELETED` is `u32::MAX`, out of range of every map, so
+    /// `get` sends it (and only it) to `DELETED` without a separate test.
+    /// Every word is marked scattered: testing composed words for
+    /// consecutive targets cost more than `pext` saved on them.
+    fn compose(step: &[u32], prev: &[u32]) -> Self {
+        let words = prev.len().div_ceil(64);
+        let mut map = Vec::with_capacity(prev.len());
+        let mut live = Vec::with_capacity(words);
+        let mut out = Vec::with_capacity(words);
+        for chunk in prev.chunks(64) {
+            let start = map.len();
+            map.extend(
+                chunk
+                    .iter()
+                    .map(|&c| step.get(c as usize).copied().unwrap_or(DELETED)),
+            );
+            let mask = map[start..]
+                .iter()
+                .enumerate()
+                .fold(0u64, |m, (b, &c)| m | (u64::from(c != DELETED) << b));
+            live.push(mask);
+            out.push(SCATTERED);
+        }
+        Self { map, live, out }
+    }
+}
+
+/// One word of a map: the live columns as a mask, and the first target if
+/// the live columns land on consecutive targets in order (`SCATTERED`
+/// otherwise).
+#[cfg(test)]
+fn chunk_masks(chunk: impl Iterator<Item = u32>) -> (u64, u32) {
+    let mut mask = 0u64;
+    let mut first = SCATTERED;
+    let mut consecutive = true;
+    let mut next = 0u32;
+    for (b, c) in chunk.enumerate() {
+        if c == DELETED {
+            continue;
+        }
+        mask |= 1u64 << b;
+        if first == SCATTERED {
+            first = c;
+            next = c;
+        }
+        consecutive &= c == next;
+        next = c.wrapping_add(1);
+    }
+    (mask, if consecutive { first } else { SCATTERED })
+}
+
+/// Scatter a row's words `live` (source layout words `lead ..`) through
+/// `map`, XORing each kept bit into `staging` at its target; returns the
+/// lowest word a kept bit was written to (`usize::MAX` if none).  Uses
+/// `pext` on a consecutive word where the CPU has BMI2 and goes bit by
+/// bit otherwise; both write the same bits and return the same word.
+fn remap_row(staging: &mut [u64], live: &[u64], lead: usize, map: &ColMap) -> usize {
+    #[cfg(target_arch = "x86_64")]
+    {
+        static BMI2: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if *BMI2.get_or_init(|| std::arch::is_x86_feature_detected!("bmi2")) {
+            // SAFETY: reached only when the CPU reports BMI2.
+            return unsafe { remap_row_bmi2(staging, live, lead, map) };
+        }
+    }
+    remap_row_body::<false>(staging, live, lead, map)
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "bmi2")]
+unsafe fn remap_row_bmi2(staging: &mut [u64], live: &[u64], lead: usize, map: &ColMap) -> usize {
+    remap_row_body::<true>(staging, live, lead, map)
+}
+
+#[inline(always)]
+fn remap_row_body<const PEXT: bool>(
+    staging: &mut [u64],
+    live: &[u64],
+    lead: usize,
+    map: &ColMap,
+) -> usize {
+    let mut lo = usize::MAX;
+    for (i, &word) in live.iter().enumerate() {
+        let k = lead + i;
+        let keep = map.live[k];
+        let mut bits = word & keep;
+        if bits == 0 {
+            continue;
+        }
+        #[cfg(target_arch = "x86_64")]
+        if PEXT && map.out[k] != SCATTERED {
+            // SAFETY: `PEXT` is set only in `remap_row_bmi2`, which is
+            // compiled for and called on a CPU with BMI2.
+            let packed = unsafe { std::arch::x86_64::_pext_u64(bits, keep) };
+            let out = map.out[k] as usize;
+            let (w, shift) = (out / 64, out % 64);
+            staging[w] ^= packed << shift;
+            if shift != 0 && packed >> (64 - shift) != 0 {
+                staging[w + 1] ^= packed >> (64 - shift);
+            }
+            lo = lo.min((out + packed.trailing_zeros() as usize) / 64);
+            continue;
+        }
+        let base = k * 64;
+        let mut scatter = |c: u32| {
+            let w = c as usize / 64;
+            staging[w] ^= 1u64 << (c % 64);
+            lo = lo.min(w);
+        };
+        // A whole word of the map at once, so the lookups below need no
+        // bounds check; only a layout's last word is short.  Deleted
+        // columns were masked off above.
+        if let Some(chunk) = map.get(base..base + 64) {
+            let chunk: &[u32; 64] = chunk.try_into().expect("64 entries");
+            while bits != 0 {
+                let b = bits.trailing_zeros() as usize & 63;
+                bits &= bits - 1;
+                scatter(chunk[b]);
+            }
+        } else {
+            while bits != 0 {
+                let b = bits.trailing_zeros() as usize;
+                bits &= bits - 1;
+                scatter(map[base + b]);
+            }
+        }
+    }
+    lo
+}
